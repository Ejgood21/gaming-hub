Amp for 5 seconds, stacking up to 4 times.","icon":"data:image/webp;base64,"},{"apiName":"DA_StrikersFlail","name":"Striker's Flail","type":"craftables","unique":false,"trait":"","composition":["DA_Component_GiantsBelt","DA_Component_SparringGloves"],"recommendedChampions":[],"filterType":["ad","ap"],"description":"Critical Strikes grant 5% Damage Amp for 5 seconds, stacking up to 4 times."},{"apiName":"DA_WarmogsArmorRadiant","name":"Radiant Warmog's Armor","type":"radiants","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_18_Sett","DA_18_Malphite","DA_18_Maokai","DA_Sentinel18"],"filterType":["tank"],"description":"Gain 36% max Health.","icon":"data:image/webp;base64,"},{"apiName":"DA_Item_Artifact_TalismanOfAscension","name":"Talisman of Ascension","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_18_ElderDragon","DA_18_Warwick","DA_18_Sett"],"filterType":[],"description":"After 22 seconds gain 100% max Health, 12 Mana Regen, and 120% Damage Amp for the rest of combat.","icon":"data:image/webp;base64,"},{"apiName":"DA_RedBuffRadiant","name":"Radiant Red Buff","type":"radiants","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_18_Ashe","DA_18_Morgana","DA_18_Aphelios","DA_18_Caitlyn"],"filterType":["ad"],"description":"Attacks and Abilities 2% Burn and 33% Wound enemies for 5 seconds.","icon":"data:image/webp;base64,"},{"apiName":"DA_Consumable_GoldenItemRemover","name":"Golden Item Remover","type":"others","unique":false,"trait":"","composition":[],"recommendedChampions":[],"filterType":[],"description":"Use on a champion to unequip all items as many times as you want. Converts all future Magnetic Removers to Reforgers.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_Hullcrusher","name":"Hullcrusher","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_18_Maokai","DA_Amumu18","DA_18_Sett","DA_18_Malphite"],"filterType":[],"description":"Combat Start: If there are no adjacent allies, gain 400 Health, 10% Attack Damage, and 10% Ability Power.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_BlightingJewel","name":"Blighting Jewel","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_18_Morgana","DA_18_Cassiopeia","DA_18_Zyra","DA_18_Alune"],"filterType":[],"description":"Dealing magic damage reduces the target’s Magic Resist by 3. If their Magic Resist is 0, grant the holder 4 Mana instead.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_CappaJuice","name":"Cappa Juice","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":[],"filterType":[],"description":"The holder dons a Hat on each takedown. The holder gains 1% Attack Damage and Ability Power per Hat. On death lose 20% of all Hats.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_VoidGauntlet","name":"Void Gauntlet","type":"ornns","unique":true,"trait":"","composition":[],"recommendedChampions":["DA_18_Sett","DA_18_Maokai","DA_18_Malphite","DA_Sentinel18"],"filterType":[],"description":"Combat Start: Store 30% max Health and 2.5% more every second. On death, unleash the stored Health as magic damage split between enemies within 4 hexes.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_AegisOfDawn","name":"Aegis of Dawn","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_18_Maokai","DA_18_Lillia","DA_18_RekSai","DA_Amumu18"],"filterType":[],"description":"Every 2.5 seconds, steal 3 Armor from enemies within 1-hex and heal 0 of the holder's Armor.\n\nIf Aegis of Dusk is also equipped, trigger this item's effect every 1.25 seconds instead.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_AegisOfDusk","name":"Aegis of Dusk","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_Taric18","DA_18_Sett","DA_18_Malphite","DA_Amumu18"],"filterType":[],"description":"Every 2.5 seconds, steal 3 Magic Resist from enemies within 1-hex and deal 18% of the holder's Magic Resist as magic damage.\n\nIf Aegis of Dawn is also equipped, trigger this item's effect every 1.25 seconds instead.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_EternalPact","name":"Eternal Pact","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_18_Veigar","DA_18_Teemo","DA_18_Ahri","DA_18_Sentry"],"filterType":[],"description":"Combat start: Form a pact with the highest Health allied champion, If they die, gain 10 Mana regen and 40% Ability Power. \n\nWhen the ally uses their ability, gain 15 Mana. Every 6 seconds, shield your ally for 200% of the holder's Ability Power.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_Manazane","name":"Manazane","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_18_Veigar","DA_18_Teemo","DA_Gromp18_AP","DA_18_Ahri"],"filterType":[],"description":"After casting the first time in combat, gain 110 Mana over 5 seconds.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_ForbiddenIdol","name":"Forbidden Idol","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_Taric18","DA_18_Sejuani","DA_Sentinel18","DA_18_Malphite"],"filterType":[],"description":"Shields have 40% of their value converted to max Health instead.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_HellfireHatchet","name":"Hellfire Hatchet","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_18_MasterYi_AD","DA_18_Rengar","DA_18_Warwick","DA_Brambleback18"],"filterType":[],"description":"Attacks deal 3% of the holder's max Health as bonus physical damage. For every 1% missing Health, gain 1.5% Attack Speed.","icon":"data:image/webp;base64,"},{"apiName":"DA_18_EmblemPrimal","name":"Primal Emblem","type":"emblems","unique":true,"trait":"DA_Primal18","composition":["DA_Component_Spatula","DA_Component_SparringGloves"],"recommendedChampions":["DA_18_Rengar","DA_18_Kennen","DA_18_GnarSmall","DA_18_Alune"],"filterType":[],"description":"The holder gains the Primal trait.","icon":"data:image/webp;base64,"},{"apiName":"DA_18_EmblemBlossom","name":"Blossom Emblem","type":"emblems","unique":true,"trait":"DA_18_Blossom","composition":["DA_Component_Spatula","DA_Component_NeedlesslyLargeRod"],"recommendedChampions":["DA_18_Ezreal","DA_18_GnarSmall"],"filterType":[],"description":"The holder gains the Blossom trait.","icon":"data:image/webp;base64,"},{"apiName":"DA_18_EmblemFloraFatalis","name":"Flora Fatalis Emblem","type":"emblems","unique":true,"trait":"DA_FloraFatalis18","composition":[],"recommendedChampions":["DA_KogMaw18_AD","DA_18_Morgana","DA_Lux18_Base","DA_18_Ashe"],"filterType":[],"description":"The holder gains the Flora Fatalis trait.","icon":"data:image/webp;base64,"},{"apiName":"DA_18_EmblemJuggernaut","name":"Juggernaut Emblem","type":"emblems","unique":true,"trait":"DA_Juggernaut18","composition":[],"recommendedChampions":["DA_Taric18","DA_Sentinel18","DA_18_Sett","DA_18_Kennen"],"filterType":[],"description":"The holder gains the Juggernaut trait. \n\nGain 15 mana whenever a Juggernaut dies.","icon":"data:image/webp;base64,"},{"apiName":"DA_18_EmblemFloraFatalisAugment","name":"Flora Fatalis Emblem","type":"emblems","unique":true,"trait":"DA_FloraFatalis18","composition":[],"recommendedChampions":["DA_18_Veigar","DA_18_Teemo","DA_18_Kennen","DA_18_Cassiopeia"],"filterType":[],"description":"The holder gains the Flora Fatalis trait. \n\nThey gain 50% increased benefits from Flora Fatalis.","icon":"data:image/webp;base64,"}]};

</script><script>
/* Public TFT Academy data. Team codes contain champions, never item builds. */
const Academy = {
  cacheKey:'carousel-academy-v7', snapshot:ACADEMY_BUNDLED, itemMap:new Map(),
  normalizeName(s){return String(s).toLowerCase().replace(/[^a-z0-9]/g,'');},
  decodeCode(text){
    const code=String(text).trim();
    const m=/^(01|02)([0-9a-f]+)TFTSet(\d+)(?:_(Act2|Stage2_Revival))?$/i.exec(code);
    if(!m)throw new Error('Paste the full in-game team code, starting with 01 or 02 and ending with TFTSet…');
    const width=m[1]==='01'?2:3;
    if(m[2].length!==10*width)throw new Error('That team code has the wrong length. Copy it again from TFT Academy.');
    const hex=m[2].toUpperCase().match(new RegExp('.{'+width+'}','g')).filter(v=>parseInt(v,16)!==0);
    if(!hex.length)throw new Error('This team code has no champions.');
    return {set:Number(m[3]),width,hex,signature:[...hex].sort().join('-')};
  },
  unpack(payload){
    if(!payload||!Array.isArray(payload.nodes))throw new Error('TFT Academy changed its data format. Your saved snapshot is still available.');
    return payload.nodes.filter(n=>n&&Array.isArray(n.data)).map(node=>{
      const values=node.data,seen=new Map();let reads=0;
      const read=index=>{
        if(!Number.isInteger(index)||index>=values.length||++reads>100000)throw new Error('Unexpected TFT Academy data.');
        if(index<0)return null;
        if(seen.has(index))return seen.get(index);
        const v=values[index];
        if(v===null||typeof v!=='object')return v;
        const out=Array.isArray(v)?[]:{};seen.set(index,out);
        if(Array.isArray(v))v.forEach(ref=>out.push(read(ref)));
        else for(const [key,ref] of Object.entries(v)){if(!['__proto__','constructor','prototype'].includes(key))out[key]=read(ref);}
        return out;
      };return read(0);
    });
  },
  guide(plan){return plan.activeComp?.guide||this.snapshot.guides.find(g=>g.id===plan.activeComp?.id);},
  itemInfo(id){return this.snapshot.items.find(i=>this.itemMap.get(i.apiName)===id);},
  baseItem(id){
    const src=this.itemInfo(id);if(src?.type!=='radiants')return id;
    const name=this.normalizeName(src.name.replace(/^Radiant\s+/i,''));
    const base=this.snapshot.items.find(i=>i.type==='craftables'&&this.normalizeName(i.name)===name);
    return base?this.itemMap.get(base.apiName)||id:id;
  },
  itemMatches(wanted,owned){return wanted===owned||this.baseItem(owned)===wanted;},
  cleanGuide(g){
    if(!g||!Array.isArray(g.finalComp))return null;
    const text=v=>String(v||'').slice(0,4000);
    const unit=c=>({apiName:text(c.apiName),items:(c.items||[]).filter(i=>typeof i==='string').slice(0,6),boardIndex:Number.isInteger(c.boardIndex)&&c.boardIndex>=0&&c.boardIndex<28?c.boardIndex:null,stars:Math.max(1,Math.min(3,Number(c.stars)||1))});
    return {id:text(g.id),title:text(g.title),compSlug:text(g.compSlug),tier:text(g.tier),set:Number(g.set),updated:text(g.updated),mainChampion:{apiName:text(g.mainChampion?.apiName)},mainItem:g.mainItem?.apiName?{apiName:text(g.mainItem.apiName)}:null,mainAugment:g.mainAugment?.apiName&&!g.mainAugment.disabled?{apiName:text(g.mainAugment.apiName)}:null,style:text(g.style),difficulty:text(g.difficulty),altBuilds:(g.altBuilds||[]).slice(0,40).map(unit),carousel:(g.carousel||[]).slice(0,30).map(p=>({apiName:text(p.apiName)})),earlyComp:(g.earlyComp||[]).slice(0,28).map(unit),finalComp:g.finalComp.slice(0,28).map(unit),augments:(g.augments||[]).filter(a=>a&&!a.disabled&&typeof a.apiName==='string').slice(0,60).map(a=>({apiName:text(a.apiName)})),augmentsTip:text(g.augmentsTip),tips:(g.tips||[]).slice(0,12).map(t=>({stage:text(t.stage),tip:text(t.tip)}))};
  },
  normalize(nodes,championData,itemData,augmentData){
    const guides=nodes.find(n=>Array.isArray(n?.guides))?.guides;
    if(!guides?.length||!Array.isArray(championData?.champions)||!Array.isArray(itemData?.items))throw new Error('The live tierlist could not be read. Your saved snapshot is still available.');
    const set=Math.max(...guides.map(g=>Number(g.set)||0));
    const clean={patch:String(nodes.find(n=>n?.patch)?.patch||''),set,updated:String(nodes.find(n=>n?.lastUpdated)?.lastUpdated||''),fetchedAt:new Date().toISOString(),
      augments:this.cleanAugments(augmentData?.augments||[]),
      guides:guides.filter(g=>g.isPublic&&g.set===set&&Array.isArray(g.finalComp)).map(g=>this.cleanGuide(g)),
      champions:championData.champions.map(c=>({apiName:String(c.apiName),name:String(c.name),hexIndex:String(c.hexIndex||''),traits:Array.isArray(c.traits)?c.traits:[],traitKeys:Object.keys(c.traitContributions||{}),role:String(c.role||''),cost:Number(c.cost)||0,icon:'https://assets.tftacademy.com/champions/champion_icons/'+encodeURIComponent(c.apiName)+'.webp'})),
      items:itemData.items.map(i=>({apiName:String(i.apiName),name:String(i.name),type:String(i.type),unique:!!i.unique,trait:String(i.trait||i.targetRules?.grantsTrait||''),composition:Array.isArray(i.composition)?i.composition:[],recommendedChampions:(i.recommendedChampions||[]).map(id=>championData.champions.find(c=>c.id===id||c.apiName===id)?.apiName).filter(Boolean),filterType:(i.filterType||[]).filter(t=>typeof t==='string'),description:String(i.description||'').slice(0,2000)}))};
    if(!clean.guides.length||!clean.champions.length||clean.guides.length>500||clean.items.length>1000)throw new Error('Unexpected or empty tierlist data.');
    return clean;
  },
  cleanAugments(list){
    return (Array.isArray(list)?list:[]).filter(a=>a&&!a.disabled&&typeof a.apiName==='string'&&typeof a.name==='string').slice(0,1000).map(a=>({apiName:a.apiName.slice(0,120),name:a.name.slice(0,120),description:String(a.description||'').slice(0,2000),stages:(a.stages||[]).filter(s=>typeof s==='string'),tier:Number(a.tier)||0}));
  },
  register(snapshot,index){
    const core=DATA.items.filter(i=>!i.academyOnly),components=new Set(DATA.components.map(c=>c.id));
    const embedded=new Map(ACADEMY_BUNDLED.items.map(i=>[i.apiName,i.icon]));
    for(const src of snapshot.items){
      if(src.type==='components'||!/^\w+$/.test(src.apiName))continue;
      const match=core.find(i=>this.normalizeName(i.name)===this.normalizeName(src.name));
      if(match){const recipe=src.composition.map(c=>String(c).replace(/^DA_Component_|^TFT_Item_/,''));if(recipe.length===2&&recipe.every(c=>components.has(c)))match.recipe=recipe;this.itemMap.set(src.apiName,match.id);continue;}
      const recipe=src.composition.map(c=>String(c).replace(/^DA_Component_|^TFT_Item_/,''));
      const craftable=recipe.length===2&&recipe.every(c=>components.has(c));
      const id='Academy_'+src.apiName;
      const item={id,name:src.name,recipe:craftable?recipe:[],special:!craftable,academyOnly:true,icon:embedded.get(src.apiName)||'https://assets.tftacademy.com/items/'+encodeURIComponent(src.apiName)+'.webp'};
      const existing=DATA.items.find(i=>i.id===id);
      if(existing)Object.assign(existing,item);else DATA.items.push(item);
      if(index)index[id]=existing||item;
      this.itemMap.set(src.apiName,id);
    }
  },
  guideHex(guide,width=3){
    const champs=new Map(this.snapshot.champions.map(c=>[c.apiName,c]));
    return guide.finalComp.map(c=>champs.get(c.apiName)).filter(c=>c?.hexIndex&&c.traits.length&&c.apiName!=='TFT16_AnnieTibbers').slice(0,10).map(c=>c.hexIndex.toUpperCase().padStart(width,'0').slice(0,width));
  },
  match(text){
    const code=this.decodeCode(text);
    if(code.set!==this.snapshot.set)throw new Error(`This code is Set ${code.set}; the loaded tierlist is Set ${this.snapshot.set}. Refresh the tierlist for Set ${code.set} to match it.`);
    const known=new Map(this.snapshot.champions.filter(c=>c.hexIndex).map(c=>[c.hexIndex.toUpperCase().padStart(code.width,'0').slice(0,code.width),c.name]));
    const unknown=code.hex.filter(h=>!known.has(h));
    if(unknown.length)throw new Error('This code contains unrecognized champions. Refresh the tierlist, or check that you copied a current team code.');
    const matches=this.snapshot.guides.map(g=>{
      const hex=this.guideHex(g,code.width),pool=[...hex];let shared=0;
      for(const id of code.hex){const at=pool.indexOf(id);if(at>=0){shared++;pool.splice(at,1);}}
      return {guide:g,exact:[...hex].sort().join('-')===code.signature,shared,total:hex.length,score:2*shared/(hex.length+code.hex.length)};
    }).filter(m=>m.shared>=Math.max(2,Math.ceil(code.hex.length*.6))).sort((a,b)=>Number(b.exact)-Number(a.exact)||b.score-a.score);
    const exact=matches.filter(m=>m.exact);
    return {code,names:code.hex.map(h=>known.get(h)),matches:exact.length?exact:matches.slice(0,5),exact:exact.length>0};
  },
  build(guide){
    const names=new Map(this.snapshot.champions.map(c=>[c.apiName,c.name]));
    const units=[...guide.finalComp].sort((a,b)=>Number(b.apiName===guide.mainChampion.apiName)-Number(a.apiName===guide.mainChampion.apiName));
    const entries=[],missing=[];
    for(const unit of units)for(const apiName of unit.items){
      const item=this.itemMap.get(apiName),champion=names.get(unit.apiName)||unit.apiName;
      if(item)entries.push({item,champion,sourceComp:guide.title,sourceURL:'https://tftacademy.com/tierlist/comps/'+encodeURIComponent(guide.compSlug)});
      else missing.push({name:this.snapshot.items.find(i=>i.apiName===apiName)?.name||apiName,champion});
    }
    // The displayed Item Priority list lives in `carousel`, independently of
    // board slot order. Promote one copy per listed item, never every duplicate.
    const priorities=this.priorities(guide),available=[...entries],chosen=new Map();
    priorities.forEach((p,n)=>{
      if(p.component)return;
      const at=available.findIndex(e=>e.item===p.id);
      if(at>=0)chosen.set(n,available.splice(at,1)[0]);
    });
    const ordered=[];
    // A component wishlist does not define a finished-item build order. Use
    // the guide's explicit early-board builds before inferring from recipes.
    if(priorities.every(p=>p.component)){
      for(const unit of guide.earlyComp||[])for(const apiName of unit.items||[]){
        const item=this.itemMap.get(apiName);if(!item)continue;
        const at=available.findIndex(e=>e.item===item);
        if(at>=0){const entry=available.splice(at,1)[0];ordered.push({...entry,earlyChampion:names.get(unit.apiName)||unit.apiName});}
      }
    }
    priorities.forEach((p,n)=>{
      if(chosen.has(n)){ordered.push(chosen.get(n));return;}
      if(!p.component)return;
      // A component preference advances an existing recipe. It does not add
      // another item or reserve a phantom extra component from the bench.
      const at=available.findIndex(e=>DATA.items.find(i=>i.id===e.item)?.recipe.includes(p.id));
      if(at>=0)ordered.push(available.splice(at,1)[0]);
    });
    return {entries:[...ordered,...available],missing,priorities};
  },
  itemizationOrder(guide){
    // Only interpret an explicit, fully recognized priority chain. Ordinary
    // prose, item names, conditions and ambiguous roles are not guessed.
    const text=String(guide?.augmentsTip||'').replace(/&gt;/gi,'>');
    const match=/\bitem(?:ization)?\s+priority\s*:\s*([^.!?\n]+)/i.exec(text);
    if(!match)return [];
    const parts=match[1].split('>').map(s=>s.trim());if(parts.length<2||parts.length>6)return [];
    const units=(guide.finalComp||[]).map(u=>this.snapshot.champions.find(c=>c.apiName===u.apiName)).filter(Boolean);
    const groups=[],seen=new Set();
    for(const part of parts){
      const names=[];
      for(const token of part.split(/\s*(?:\/|,|&|\band\b)\s*/i)){
        const key=this.normalizeName(token);
        const found=/^(?:tank|tanks|frontline)$/.test(key)?units.filter(c=>/tank/i.test(c.role||'')):units.filter(c=>this.normalizeName(c.name)===key);
        if(!found.length)return [];
        for(const c of found){if(seen.has(c.name))return [];seen.add(c.name);names.push(c.name);}
      }
      if(!names.length)return [];groups.push(names);
    }
    return groups;
  },
  equipment(plan){
    const done=plan.queue.filter(q=>q.done),holders=new Map(done.map(q=>[q.uid,q.champion||'']));
    const guide=this.guide(plan);
    if(!guide)return holders;
    const names=new Set(guide.finalComp.map(c=>this.snapshot.champions.find(x=>x.apiName===c.apiName)?.name));
    const entries=[...this.build(guide).entries],pool=[];
    for(const q of done){
      if(q.champion&&names.has(q.champion)){
        // Keep the actual holder, even when this item was an off-guide pivot.
        const at=entries.findIndex(e=>this.itemMatches(e.item,q.item)&&e.champion===q.champion);
        if(at>=0)entries.splice(at,1);
      }else pool.push(q);
    }
    for(const q of pool){const at=entries.findIndex(e=>this.itemMatches(e.item,q.item));if(at>=0){holders.set(q.uid,entries[at].champion);entries.splice(at,1);}}
    return holders;
  },
  priorities(guide){
    return (guide.carousel||[]).flatMap(p=>{
      const component=String(p.apiName||'').replace(/^DA_Component_|^TFT_Item_/,'');
      if(DATA.components.some(c=>c.id===component))return [{id:component,component:true}];
      const id=this.itemMap.get(p.apiName);return id?[{id,component:false}]:[];
    });
  },
  componentPreference(plan,id){
    const ordered=plan.activeComp?.itemPriority||[];
    const at=ordered.findIndex(p=>p.component&&p.id===id);return at<0?999:at;
  },
  async refresh(set){
    const controller=new AbortController(),timeout=setTimeout(()=>controller.abort(),15000);
    const get=async url=>{const r=await fetch(url,{signal:controller.signal,credentials:'omit'});if(!r.ok)throw new Error('TFT Academy returned '+r.status);return r.json();};
    try{
      const path=set&&set!==ACADEMY_BUNDLED.set?`/tierlist/comps/set${set}/__data.json`:'/tierlist/comps/__data.json';
      const nodes=this.unpack(await get('https://tftacademy.com'+path));
      const guideSet=Math.max(...(nodes.find(n=>n?.guides)?.guides||[]).map(g=>Number(g.set)||0));
      if(!guideSet||set&&guideSet!==set)throw new Error('That set’s tierlist is not available.');
      const [champions,items,augments]=await Promise.all([get(`https://tftacademy.com/api/assets/champions?set=${guideSet}`),get(`https://tftacademy.com/api/assets/items?set=${guideSet}`),get(`https://tftacademy.com/api/assets/augments?set=${guideSet}`).catch(()=>null)]);
      const snapshot=this.normalize(nodes,champions,items,augments);
      if(!snapshot.augments.length)snapshot.augments=(this.snapshot.set===guideSet?this.snapshot.augments:[])||[];
      this.register(snapshot,byId);this.snapshot=snapshot;
      let saved=true;try{localStorage.setItem(this.cacheKey,JSON.stringify(snapshot));}catch(e){saved=false;}
      return {saved};
    }finally{clearTimeout(timeout);}
  }
};
Academy.register(ACADEMY_BUNDLED);
try {
  const cached=JSON.parse(localStorage.getItem(Academy.cacheKey)||'null');
  if(cached?.guides?.length&&cached.champions?.length&&cached.items?.length&&Number.isInteger(cached.set)){
    Academy.register(cached);Academy.snapshot=cached;
  }
}catch(e){/* The bundled snapshot remains available offline. */}

</script><script>
const Tracker = {
  allocate(state, items) {
    const remaining = {...state.owned};
    const needs = {};
    const rows = state.queue.filter(q => !q.done).map((q, rank) => {
      const item = items.find(i => i.id === q.item);
      const slots = item.recipe.map(id => {
        const have = (remaining[id] || 0) > 0;
        if (have) remaining[id]--;
        else { needs[id] ||= {count:0, rank, items:[]}; needs[id].count++; if (!needs[id].items.includes(item.name)) needs[id].items.push(item.name); }
        return {id, have};
      });
      return {...q, rank, slots};
    });
    return {rows, needs, remaining};
  },
  complete(state, q, item) {
    q.used = {}; q.usedSources={}; q.received = false;
    for (const id of item.recipe) if ((state.owned[id] || 0) > 0) { (q.usedSources[id]||=[]).push(LootTracker.take(state,id)); state.owned[id]--; q.used[id] = (q.used[id] || 0) + 1; }
    q.done = true;
  },
  restore(state, q) {
    const h=LootTracker.ensure(state);
    for (const [id, n] of Object.entries(q.used || {})) {for(let k=0;k<n;k++)h.loose[id].push(q.usedSources?.[id]?.[k]||'other');state.owned[id] = (state.owned[id] || 0) + n;}
    q.done = false; q.used = {}; q.usedSources={}; q.received = false;
  }
};
if (typeof module !== 'undefined') module.exports = Tracker;

</script><script>
/* Manual tracker helpers. No network access or game connection. */
const OfflineTracker = {
  cleanState(value) {
    if (!value || !Array.isArray(value.queue) || typeof value.owned !== 'object' || !value.owned) throw new Error('Choose a Carousel backup or tracker state.');
    if (value.queue.length > 1000) throw new Error('This backup contains too many items.');
    const valid = new Set(DATA.items.map(i => i.id));
    if (value.queue.some(q => !q || !valid.has(q.item))) throw new Error('This backup includes an item this version does not support.');
    const count = n => Number.isFinite(Number(n)) ? Math.max(0, Math.min(9999, Math.floor(Number(n)))) : 0;
    return {
      currentUnits:[...new Map((Array.isArray(value.currentUnits)?value.currentUnits:[]).filter(u=>u&&typeof u.apiName==='string'&&Academy.snapshot.champions.some(c=>c.apiName===u.apiName)).slice(0,28).map(u=>[u.apiName,{apiName:u.apiName,stars:Math.max(1,Math.min(3,Math.floor(Number(u.stars)||1)))}])).values()],
      chosenAugments:Array.from({length:3},(_,n)=>typeof value.chosenAugments?.[n]==='string'?value.chosenAugments[n].slice(0,120):''),
      augmentOffers:value.augmentOffers&&typeof value.augmentOffers==='object'?{round:Math.max(0,Math.min(2,Math.floor(Number(value.augmentOffers.round)||0))),ids:Array.from({length:3},(_,n)=>typeof value.augmentOffers.ids?.[n]==='string'?value.augmentOffers.ids[n].slice(0,120):''),seen:(Array.isArray(value.augmentOffers.seen)?value.augmentOffers.seen:[]).filter(id=>typeof id==='string').map(id=>id.slice(0,120)).slice(0,60)}:null,
      tempo:value.tempo==='urgent'?'urgent':'balanced',
      pivotIntents:Object.fromEntries(Object.entries(value.pivotIntents||{}).filter(([name,ids])=>name.length<120&&Array.isArray(ids)).map(([name,ids])=>[name,ids.filter(id=>valid.has(id)).slice(0,3)])),
      firstAugment:typeof value.firstAugment==='string'?value.firstAugment.slice(0,120):'',
      lootHistory:LootTracker.clean(value.lootHistory,value.owned),lootTieBreak:value.lootTieBreak!==false,
      activeComp:value.activeComp&&typeof value.activeComp.title==='string'?{guide:Academy.cleanGuide(value.activeComp.guide),title:value.activeComp.title.slice(0,120),id:String(value.activeComp.id||'').slice(0,100),code:String(value.activeComp.code||'').slice(0,100),itemPriority:Array.isArray(value.activeComp.itemPriority)?value.activeComp.itemPriority.filter(p=>p&&typeof p.id==='string'&&(p.component?componentOrder.includes(p.id):valid.has(p.id))).slice(0,30).map(p=>({id:p.id,component:!!p.component})):[]}:null,
      queue:value.queue.map(q=>({uid:crypto.randomUUID(),recommendedOrder:Number.isFinite(q.recommendedOrder)&&q.recommendedOrder>=0?q.recommendedOrder:undefined,item:q.item,academyItem:valid.has(q.academyItem)?q.academyItem:'',planSource:['academy','meta','manual'].includes(q.planSource)?q.planSource:'',done:!!q.done,received:!!q.received,champion:typeof q.champion==='string'?q.champion.slice(0,100):'',earlyChampion:typeof q.earlyChampion==='string'?q.earlyChampion.slice(0,100):'',sourceComp:typeof q.sourceComp==='string'?q.sourceComp.slice(0,120):'',sourceURL:typeof q.sourceURL==='string'&&q.sourceURL.startsWith('https://tftacademy.com/tierlist/comps/')?q.sourceURL:'',usedSources:Object.fromEntries(componentOrder.map(id=>[id,(Array.isArray(q.usedSources?.[id])?q.usedSources[id]:[]).slice(0,Math.min(2,count(q.used?.[id]))).map(s=>['loot','carousel','other'].includes(s)?s:'other')])),used:Object.fromEntries(componentOrder.map(id=>[id,Math.min(2,count(q.used?.[id]))]))})),
      owned:Object.fromEntries(componentOrder.map(id=>[id,count(value.owned[id])])),
      pins:[...new Set((Array.isArray(value.pins)?value.pins:[]).filter(id=>componentOrder.includes(id)))]
    };
  },
  recipeCounts(item) { return item.recipe.reduce((n,id)=>(n[id]=(n[id]||0)+1,n),{}); },
  canCraft(owned,item) {return item.recipe.length===2&&Object.entries(this.recipeCounts(item)).every(([id,n])=>(owned[id]||0)>=n);},
  craftOptions(plan) {
    const allocated=Tracker.allocate(plan,DATA.items);
    const options=allocated.rows.filter(q=>this.canCraft(plan.owned,byId[q.item]));
    return options.map(q=>({
      ...q,
      reserved:q.slots.filter(s=>!s.have).map(s=>s.id),
      conflicts:options.filter(other=>{
        if(other.uid===q.uid)return false;
        const both=this.recipeCounts({recipe:[...byId[q.item].recipe,...byId[other.item].recipe]});
        return Object.entries(both).some(([id,n])=>n>(plan.owned[id]||0));
      }).map(other=>({uid:other.uid,item:other.item,rank:other.rank}))
    }));
  },
  shortlist(plan) {
    const a=Tracker.allocate(plan,DATA.items);
    return Object.entries(a.needs).sort(([x,v],[y,w])=>(Number(plan.pins.includes(y))-Number(plan.pins.includes(x)))||v.rank-w.rank||Academy.componentPreference(plan,x)-Academy.componentPreference(plan,y)||w.count-v.count||LootTracker.compare(plan,x,y)||componentOrder.indexOf(x)-componentOrder.indexOf(y)).map(([id,need])=>{
      const after=Tracker.allocate({...plan,owned:{...plan.owned,[id]:(plan.owned[id]||0)+1}},DATA.items);
      const finishes=after.rows.filter((q,n)=>q.slots.every(s=>s.have)&&!a.rows[n].slots.every(s=>s.have));
      return {id,...need,finishes};
    });
  },
  receive(plan,q) {q.done=true;q.received=true;q.used={};q.usedSources={};},
  newGame(plan,keep) {
    return {queue:keep?plan.queue.map(q=>({...q,done:false,received:false,used:{}})):[],owned:{},pins:keep?[...plan.pins]:[]};
  }
};

</script><script>
/* Source history is independent of inventory. This is a conservative historical
   bag heuristic, not a verified current-set probability model. */
const LootTracker = {
  clean(value, owned) {
    const sources=['loot','carousel','other'];
    const count=n=>Number.isFinite(Number(n))?Math.max(0,Math.min(9999,Math.floor(Number(n)))):0;
    return {complete:value?.complete===true,counts:Object.fromEntries(componentOrder.map(id=>[id,count(value?.counts?.[id])])),loose:Object.fromEntries(componentOrder.map(id=>[id,Array.from({length:Math.min(9999,count(owned[id]))},(_,n)=>sources.includes(value?.loose?.[id]?.[n])?value.loose[id][n]:'other')]))};
  },
  ensure(plan) {
    if(!plan.lootHistory)plan.lootHistory={complete:!plan.queue.some(q=>q.done)&&!Object.values(plan.owned).some(n=>n>0),counts:{},loose:{}};
    for(const id of componentOrder){const n=plan.owned[id]||0,arr=plan.lootHistory.loose[id]||=[];while(arr.length<n)arr.push('other');if(arr.length>n)arr.length=n;}
    return plan.lootHistory;
  },
  gain(plan,id,source='loot') {
    if((plan.owned[id]||0)>=99)return;
    const h=this.ensure(plan);if(!componentOrder.slice(0,8).includes(id))source='other';
    h.loose[id].push(source);if(source==='loot')h.counts[id]=(h.counts[id]||0)+1;
    plan.owned[id]=(plan.owned[id]||0)+1;
  },
  remove(plan,id) {
    if(!(plan.owned[id]>0))return;
    const h=this.ensure(plan),source=h.loose[id].pop();
    if(source==='loot')h.counts[id]=Math.max(0,(h.counts[id]||0)-1);
    plan.owned[id]--;
  },
  take(plan,id) {return this.ensure(plan).loose[id].shift()||'other';},
  compare(plan,x,y) {
    const h=plan.lootHistory;if(!h?.complete||plan.lootTieBreak===false||!componentOrder.slice(0,8).includes(x)||!componentOrder.slice(0,8).includes(y))return 0;
    // More prior natural drops => prefer taking this equally urgent component
    // now. No percentages, stage refill assumptions, or promised future drops.
    return (h.counts[y]||0)-(h.counts[x]||0);
  }
};

</script><script>
/* Shared portraits and searchable icon selectors. Native selects remain the
   state/event source; visible controls support mouse and keyboard navigation. */
const IconUI = {
  champion(name,cls=''){
    const c=Academy.snapshot.champions.find(c=>c.apiName===name||Academy.normalizeName(c.name)===Academy.normalizeName(name));
    if(!c)return `<span class="champ-fallback ${cls}" aria-hidden="true">?</span>`;
    const embedded=ACADEMY_BUNDLED.champions.find(u=>u.apiName===c.apiName)?.icon;
    const src=embedded?.startsWith('data:')?embedded:c.icon||'https://assets.tftacademy.com/champions/champion_icons/'+encodeURIComponent(c.apiName)+'.webp';
    return `<img class="champ-icon ${cls}" src="${esc(src)}" alt="" width="28" height="28">`;
  },
  itemLabel(id){return `<span class="inline-entity">${icon(id)}<span>${esc(byId[id].name)}</span></span>`;},
  championLabel(name){return `<span class="inline-entity">${this.champion(name)}<span>${esc(name)}</span></span>`;},
  picker(select,kind,label){
    select.hidden=true;select.setAttribute('aria-hidden','true');select.tabIndex=-1;
    const wrap=document.createElement('div');wrap.className='icon-select';
    const trigger=document.createElement('button');trigger.type='button';trigger.id=select.id+'-trigger';trigger.className='icon-select-trigger';trigger.setAttribute('aria-label',label);trigger.setAttribute('aria-expanded','false');
    const pop=document.createElement('div');pop.className='icon-select-popup';pop.hidden=true;pop.id=select.id+'-choices';trigger.setAttribute('aria-controls',pop.id);
    pop.innerHTML=`<input type="search" class="icon-select-search" placeholder="Search ${kind==='champion'?'champions':kind==='augment'?'augments':'items'}…" aria-label="Search ${label.toLowerCase()}" autocomplete="off"><div class="icon-select-options" role="group" aria-label="${esc(label)} options"></div>`;
    wrap.append(trigger,pop);select.after(wrap);
    const search=pop.querySelector('input'),list=pop.querySelector('.icon-select-options');
    const picture=value=>!value?'<span class="any-icon" aria-hidden="true">✦</span>':kind==='champion'?IconUI.champion(value):kind==='augment'?CompFinder.augmentIcon(value):byId[value]?icon(value):'';
    const close=()=>{pop.hidden=true;trigger.setAttribute('aria-expanded','false');};
    const draw=()=>{const q=search.value.toLowerCase();list.innerHTML=[...select.querySelectorAll('option')].filter(o=>o.textContent.toLowerCase().includes(q)).map(o=>`<button type="button" data-option-value="${esc(o.value)}" class="icon-select-option" aria-pressed="${o.value===select.value}">${picture(o.value)}<span>${esc(o.textContent)}</span>${o.value===select.value?'<b>✓</b>':''}</button>`).join('')||'<span class="picker-no-match">No matches</span>';};
    const open=()=>{search.value='';draw();pop.hidden=false;trigger.setAttribute('aria-expanded','true');search.focus();};
    const refresh=()=>{const o=[...select.querySelectorAll('option')].find(o=>o.value===select.value)||select.querySelector('option');trigger.innerHTML=picture(o?.value||'')+'<span>'+esc(o?.textContent||'Choose')+'</span><span class="picker-chevron">⌄</span>';if(!pop.hidden)draw();};
    trigger.addEventListener('click',()=>pop.hidden?open():close());
    trigger.addEventListener('keydown',e=>{if(e.key==='ArrowDown'){e.preventDefault();open();}});
    search.addEventListener('input',draw);
    pop.addEventListener('keydown',e=>{const options=[...list.querySelectorAll('button')],at=options.indexOf(document.activeElement);if(e.key==='Escape'){e.preventDefault();e.stopPropagation();close();trigger.focus();}else if(['ArrowDown','ArrowUp','Home','End'].includes(e.key)){e.preventDefault();options[e.key==='Home'?0:e.key==='End'?options.length-1:e.key==='ArrowDown'?Math.min(options.length-1,at+1):Math.max(0,at-1)]?.focus();}else if(e.key==='Enter'&&document.activeElement===search){e.preventDefault();options[0]?.click();}});
    list.addEventListener('click',e=>{const b=e.target.closest('[data-option-value]');if(!b)return;select.value=b.dataset.optionValue;close();select.dispatchEvent(new Event('change',{bubbles:true}));refresh();trigger.focus();});
    document.addEventListener('click',e=>{if(!wrap.contains(e.target))close();});
    select.addEventListener('change',refresh);refresh();
    return {refresh,close};
  }
};

</script><script>
/* Recommended positions belong to item copies; drag only changes presentation order. */
const QueueOrder={
  ensure(plan){
    // One-time upgrade: recover Academy's order for older files that did not
    // store recommended positions. Preserve every current target, including pivots.
    if(plan.queue.length&&!plan.queue.some(q=>Number.isFinite(q.recommendedOrder))){
      const guide=Academy.guide(plan),entries=guide?Academy.build(guide).entries.map((e,rank)=>({...e,rank})):[];
      if(entries.length){
        const remaining=[...entries],unmatched=[];
        const same=(a,b)=>Academy.normalizeName(a||'')===Academy.normalizeName(b||'');
        for(const q of [...plan.queue.filter(q=>q.done),...plan.queue.filter(q=>!q.done)]){
          const at=remaining.findIndex(e=>same(e.champion,q.champion)&&Academy.itemMatches(e.item,q.academyItem||q.item));
          if(at>=0)q.recommendedOrder=remaining.splice(at,1)[0].rank;else unmatched.push(q);
        }
        let tail=entries.length;
        for(const q of unmatched){const at=q.champion?remaining.findIndex(e=>same(e.champion,q.champion)):-1;q.recommendedOrder=at>=0?remaining.splice(at,1)[0].rank:tail++;}
      }
    }
    let next=plan.queue.reduce((n,q)=>Number.isFinite(q.recommendedOrder)?Math.max(n,q.recommendedOrder+1):n,0);
    for(const q of plan.queue)if(!Number.isFinite(q.recommendedOrder))q.recommendedOrder=next++;
  },
  pending(plan){return plan.queue.filter(q=>!q.done);},
  recommended(plan){this.ensure(plan);return this.pending(plan).slice().sort((a,b)=>a.recommendedOrder-b.recommendedOrder);},
  apply(plan,ids){
    const pending=this.pending(plan),byUid=new Map(pending.map(q=>[q.uid,q]));
    if(ids.length!==pending.length||new Set(ids).size!==pending.length||ids.some(id=>!byUid.has(id)))return false;
    if(pending.every((q,n)=>q.uid===ids[n]))return false;
    let n=0;plan.queue=plan.queue.map(q=>q.done?q:byUid.get(ids[n++]));return true;
  },
  reset(plan){return this.apply(plan,this.recommended(plan).map(q=>q.uid));},
  inherit(plan,previous,replacements){
    this.ensure(plan);
    const slots=previous.map(q=>q.recommendedOrder).sort((a,b)=>a-b);
    const tail=plan.queue.reduce((n,q)=>Math.max(n,q.recommendedOrder+1),0);
    replacements.forEach((q,n)=>q.recommendedOrder=slots[n]??tail+n);
  }
};

</script><script>
const KEY='carousel-tracker-v1';
const byId=Object.fromEntries([...DATA.components,...DATA.items].map(i=>[i.id,i]));
const componentOrder=['BFSword','RecurveBow','NeedlesslyLargeRod','TearOfTheGoddess','ChainVest','NegatronCloak','GiantsBelt','SparringGloves','Spatula','FryingPan'];
const components=componentOrder.map(id=>byId[id]);
const shortNames={BFSword:'B.F. Sword',RecurveBow:'Bow',NeedlesslyLargeRod:'Rod',TearOfTheGoddess:'Tear',ChainVest:'Vest',NegatronCloak:'Cloak',GiantsBelt:'Belt',SparringGloves:'Gloves',Spatula:'Spatula',FryingPan:'Pan'};
let state={queue:[],owned:{},pins:[]},history=[],query='',filter='',storageOK=true;
try {const saved=JSON.parse(localStorage.getItem(KEY));if(saved)state=OfflineTracker.cleanState(saved);} catch(e){storageOK=false;}
LootTracker.ensure(state);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const icon=(id,cls='')=>`<img class="icon ${cls}" src="${byId[id].icon}" alt="" width="38" height="38">`;
const btn=(action,id,label,text,cls='',disabled=false)=>`<button data-action="${action}" data-id="${id}" data-focus="${action}-${id}" aria-label="${esc(label)}" title="${esc(label)}" class="${cls}" ${disabled?'disabled':''}>${text}</button>`;
document.getElementById('app').innerHTML=`<header class="topbar"><div class="brand"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 2 29 9v14l-13 7L3 23V9Z" stroke="currentColor" stroke-width="1.8"/><path d="m16 8 7 4v8l-7 4-7-4v-8Z" stroke="currentColor" stroke-width="1.8"/></svg><div><h1 id="app-title">Carousel</h1><small>Ctrl + V anywhere to import</small></div></div><div class="topright"><button data-action="help" class="helpbutton">How it works</button></div></header><main class="wrap"><div class="pagehead"><div class="actions"><button data-action="undo" id="undo" class="quiet" disabled>↶ Undo</button><button data-action="reset" class="quiet">New game</button></div></div><div id="storage-warning"></div><div class="workspace"><section class="leftcol panel" aria-labelledby="catalog-title"><div class="panelhead"><h2 id="catalog-title">Choose your items</h2><span class="count">${DATA.items.filter(i=>!i.academyOnly).length}</span></div><div class="catalogtools"><label class="visuallyhidden" for="search">Find an item</label><input class="search" id="search" type="search" placeholder="Find an item…" autocomplete="off"><div class="filters"><label for="filter">Recipe</label><select id="filter"><option value="">All components</option>${components.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join('')}</select></div></div><div id="catalog" class="catalog"></div><div class="catalogfoot">Click to add. Click again for another copy.</div></section><section class="centercol" aria-labelledby="queue-title"><div class="queuehead"><div><h2 id="queue-title">Build Queue</h2></div></div><div id="queue"></div><div id="completed"></div></section><aside class="rightcol panel shopping" aria-labelledby="shopping-title"><div class="panelhead"><h2 id="shopping-title">Carousel priorities</h2></div><p class="shoppingintro">The components your builds still need.</p><div id="shopping" class="shoppinglist"></div><div class="shoppingfoot">★ Pin within planned needs or alternatives.</div></aside></div><section class="bench panel" aria-labelledby="bench-title"><div class="panelhead"><h2 id="bench-title">Your component bench</h2></div><p class="benchnote">Add your loose components here. Making an item uses the tracked ingredients from this bench.</p><div id="bench" class="benchgrid"></div></section><footer class="footer"><span id="saved">Saved in this browser · Export a backup before moving this file</span><span>Core recipes · <a href="https://raw.communitydragon.org/latest/cdragon/tft/" target="_blank" rel="noopener">CommunityDragon data</a> · Sep 23, 2026</span></footer></main><div class="toast" id="toast" role="status" aria-live="polite"></div><dialog id="help"><h2>A little planning. A better carousel.</h2><ol><li>Click an item to add it to your queue. You can track multiple copies.</li><li>Drag a card by its grip to reorder. Reset order restores the recommended sequence without changing targets. Keyboard: focus the grip, press Space, move with arrow keys, then Enter; Escape cancels. Loose components are reserved from the top down; each component counts only once.</li><li>Add components on your bench, or click <b>Got one</b> on your carousel priorities. Green ingredients are already covered. Click a missing ingredient in a build to record one.</li><li>Click <b>Mark made</b> when you finish an item. It removes that recipe from your needs and uses any recorded ingredients.</li><li>Star a component to prioritize it within planned needs or alternatives. Stars do not change your build order.</li></ol><p>This is a manual tracker. No live-game connection or API key is used. Progress stays in this browser; other devices have their own tracker.</p><p>The picker shows core items. Imported comps can also track emblems and special items; items without a recipe do not add component needs. TFT Academy data refreshes automatically when you open the app or start a new game. If offline, the saved snapshot stays available.</p><p>Item assets belong to Riot Games. This companion is not endorsed by Riot Games.</p><div class="dialogactions"><button data-action="close-help" class="primary">Got it</button></div></dialog>`;
function renderCatalog(){
 const found=DATA.items.filter(i=>!i.academyOnly&&i.name.toLowerCase().includes(query.toLowerCase())&&(!filter||i.recipe.includes(filter)));
 document.getElementById('catalog').innerHTML=found.map(i=>{const n=state.queue.filter(q=>q.item===i.id&&!q.done).length;return `<button class="itemtile" data-action="add" data-id="${i.id}" data-focus="add-${i.id}" aria-label="Add ${esc(i.name)}; ${i.recipe.map(id=>esc(byId[id].name)).join(' plus ')}" title="${i.recipe.map(id=>esc(byId[id].name)).join(' + ')}">${icon(i.id)}<strong>${esc(i.name)}</strong>${n?`<span class="tilecount">${n}</span>`:'<span class="tileplus" aria-hidden="true">+</span>'}</button>`;}).join('')||'<p class="emptysearch">No matching items.<br>Try another name or component.</p>';
}
function render(){
 const focus=document.activeElement?.dataset.focus;
 QueueOrder.ensure(state);
 const a=Tracker.allocate(state,DATA.items),done=state.queue.filter(q=>q.done);
 document.getElementById('queue').innerHTML=a.rows.map((q,n)=>{const i=byId[q.item],ready=i.recipe.length===2&&q.slots.every(c=>c.have);return `<article class="qcard" data-queue-uid="${q.uid}"><div class="qtop"><button class="queue-grip" aria-label="Reorder ${esc(i.name)}" aria-describedby="queue-drag-help" aria-pressed="false" data-focus="drag-${q.uid}">⠿</button>${icon(i.id)}<div class="itemtitle"><h3>${esc(i.name)}</h3>${q.champion?`<small class="item-owner">${q.earlyChampion&&q.earlyChampion!==q.champion?`${IconUI.championLabel(q.earlyChampion)} → `:''}${IconUI.championLabel(q.champion)}</small>`:''}</div><div class="recipe">${q.slots.map((c,idx)=>`${idx?'<span class="plus">+</span>':''}${c.have?`<span class="componentpill have" title="${esc(byId[c.id].name)} reserved for this item">${icon(c.id)}<span aria-hidden="true">✓</span></span>`:`<button class="componentpill" data-action="gain" data-id="${c.id}" data-focus="slot-${q.uid}-${idx}" aria-label="Record one ${esc(byId[c.id].name)} received">${icon(c.id)}<span aria-hidden="true">+</span></button>`}`).join('')}</div>${btn('remove',q.uid,`Remove ${i.name}`,'×','remove')}</div><div class="qbottom">${btn('make',q.uid,i.special?`Record ${i.name} received; no components used`:`Mark ${i.name} made; uses tracked ingredients`,i.special?'✓ Received':ready?'✓ Ready · Mark made':'✓ Mark made',`make ${ready?'ready':''}`)}</div></article>`;}).join('')||`<div class="empty"><div class="emptyicon" aria-hidden="true">${done.length?'✓':'+'}</div><h3>${done.length?'Every build, checked off.':'What are you building?'}</h3><p>${done.length?'Add another item whenever your plan changes.':'Choose items from the catalog to start your build queue. Your missing components will appear here.'}</p>${done.length?'':'<div class="steps"><span>01<br>Choose items</span><span>02<br>Track components</span><span>03<br>Check off builds</span></div>'}</div>`;
 document.getElementById('completed').innerHTML=done.map(q=>`<div class="completeitem" role="listitem" title="${esc(byId[q.item].name)}${q.champion?' · '+esc(q.champion):''}" aria-label="${esc(byId[q.item].name)}${q.champion?' for '+esc(q.champion):''}">${icon(q.item)}${btn('restore',q.uid,`Restore ${byId[q.item].name}${q.champion?' for '+q.champion:''} to queue and return its tracked ingredients`,'Restore','quiet')}</div>`).join('');
 const needs=Object.entries(a.needs).sort(([x,v],[y,w])=>(Number(state.pins.includes(y))-Number(state.pins.includes(x)))||v.rank-w.rank||Academy.componentPreference(state,x)-Academy.componentPreference(state,y)||w.count-v.count||LootTracker.compare(state,x,y)||componentOrder.indexOf(x)-componentOrder.indexOf(y));
 document.getElementById('shopping').innerHTML=needs.map(([id,n])=>`<div class="need ${state.pins.includes(id)?'pinned':''}"><div class="needtop">${icon(id)}<div class="needname">${esc(byId[id].name)}<small title="${esc(n.items.join(', '))}">For ${esc(n.items[0])}${n.items.length>1?` +${n.items.length-1}`:''}</small></div><span class="needed" aria-label="${n.count} needed">×${n.count}</span></div><div class="needactions"><button class="pin ${state.pins.includes(id)?'active':''}" data-action="pin" data-id="${id}" data-focus="pin-${id}" aria-label="Prioritize ${esc(byId[id].name)}" aria-pressed="${state.pins.includes(id)}">${state.pins.includes(id)?'★':'☆'}</button>${btn('gain',id,`Record one ${byId[id].name} received`,'+ Got one','got')}</div></div>`).join('')||`<div class="shopempty" style="grid-column:1/-1"><b>${a.rows.some(q=>byId[q.item].special)?'No components left to chase.':a.rows.length?'You have the ingredients.':done.length?'All planned items made.':'Your shopping list starts here.'}</b>${a.rows.length?'Check off your items as you make them.':'Add a build to see which components to collect.'}</div>`;
 document.getElementById('bench').innerHTML=components.map(c=>`<div class="benchitem ${(state.owned[c.id]||0)?'has':''}">${icon(c.id)}<strong>${esc(c.name)}</strong><div class="counter">${btn('lose',c.id,`Remove one ${c.name}`,'−','',!(state.owned[c.id]>0))}<output aria-label="${esc(c.name)} owned">${state.owned[c.id]||0}</output>${btn('gain',c.id,`Add one ${c.name}`,'+','',(state.owned[c.id]||0)>=99)}</div></div>`).join('');
 document.getElementById('undo').disabled=!history.length;renderCatalog();
 document.getElementById('storage-warning').innerHTML=storageOK?'':'<p class="storagewarn">Browser storage is unavailable or could not be read. Keep this tab open and use Export backup to preserve your tracker.</p>';
 document.getElementById('saved').textContent=storageOK?'Saved in this browser · Export a backup before moving this file':'Session only · Changes may not survive closing this tab';
 if(focus) document.querySelector(`[data-focus="${CSS.escape(focus)}"]`)?.focus({preventScroll:true});
}
function save(){QueueOrder.ensure(state);try{localStorage.setItem(KEY,JSON.stringify(state));storageOK=true;}catch(e){storageOK=false;}}
let toastTimer;function toast(s){document.getElementById('toast').textContent=s;clearTimeout(toastTimer);toastTimer=setTimeout(()=>document.getElementById('toast').textContent='',2400);}
function mutate(fn,message){history.push(JSON.stringify(state));if(history.length>40)history.shift();fn();save();render();if(message)toast(message);}
document.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(!b||b.disabled)return;const {action,id}=b.dataset,q=state.queue.find(q=>q.uid===id);
 if(action==='help'){document.getElementById('help').showModal();return;}
 if(action==='close-help'){document.getElementById('help').close();return;}
 if(action==='reset'){mutate(()=>state={queue:[],owned:{},pins:[]},'New game. Queue and bench cleared.');document.dispatchEvent(new Event('carousel-new-game'));return;}
 if(action==='undo'){if(history.length){state=JSON.parse(history.pop());save();render();toast('Last change undone.');}return;}
 if(action==='add')mutate(()=>state.queue.push({uid:crypto.randomUUID(),item:id,done:false,used:{}}),`${byId[id].name} added to your queue.`);
 if(action==='gain'&&(state.owned[id]||0)<99)mutate(()=>LootTracker.gain(state,id,b.closest('#shopping')?'carousel':b.closest('#bench')?'loot':'other'),`${byId[id].name} collected.`);
 if(action==='lose'&&state.owned[id]>0)mutate(()=>LootTracker.remove(state,id),`${byId[id].name} removed from bench.`);
 if(action==='pin')mutate(()=>state.pins=state.pins.includes(id)?state.pins.filter(x=>x!==id):[...state.pins,id],`${byId[id].name} priority changed.`);
 if(action==='remove'&&q)mutate(()=>state.queue=state.queue.filter(x=>x.uid!==id),`${byId[q.item].name} removed. Undo to bring it back.`);
 if(action==='make'&&q&&!q.done)mutate(()=>byId[q.item].special?OfflineTracker.receive(state,q):Tracker.complete(state,q,byId[q.item]),`${byId[q.item].name} ${byId[q.item].special?'received':'marked made'}.`);
 if(action==='restore'&&q&&q.done)mutate(()=>Tracker.restore(state,q),`${byId[q.item].name} returned to queue${q.received?'':'; recorded ingredients returned to bench'}.`);
});
document.getElementById('search').addEventListener('input',e=>{query=e.target.value;renderCatalog();});
document.getElementById('filter').addEventListener('change',e=>{filter=e.target.value;renderCatalog();});
render();

</script><script>
/* Local role/recipe heuristics; not a tier list or a champion-specific item guide. */
const PivotPlanner = (() => {
  const roles={
    AdaptiveHelm:['mana','tank','AP','AD'],ArchangelsStaff:['AP','scaling'],Bloodthirster:['sustain','AD','AP','fighter'],BlueBuff:['mana','AP','AD'],BrambleVest:['tank','armor'],Crownguard:['AP','tank'],Deathblade:['AD'],DragonsClaw:['tank','magic-defense'],GuardianAngel:['AD','survival'],SpectralGauntlet:['sunder','tank'],GargoyleStoneplate:['tank','armor','magic-defense'],MadredsBloodrazor:['AD','AP','anti-tank'],GuinsoosRageblade:['attack-speed','scaling'],UnstableConcoction:['sustain','AD','AP','crit'],HextechGunblade:['sustain','AP','AD','team-heal'],InfinityEdge:['AD','crit'],IonicSpark:['shred','tank','AP'],JeweledGauntlet:['AP','crit'],RunaansHurricane:['AD','attack-speed','scaling'],LastWhisper:['sunder','AD'],Morellonomicon:['anti-heal','AP'],Leviathan:['mana','AP','attack-speed'],FrozenHeart:['tank','mana'],PowerGauntlet:['crit','AD','AP'],Quicksilver:['attack-speed','survival'],RabadonsDeathcap:['AP'],RapidFireCannon:['anti-heal','attack-speed'],SpearOfShojin:['mana','AP','AD'],Redemption:['tank','sustain'],NightHarvester:['tank','survival'],SteraksGage:['fighter','AD','survival'],RedBuff:['anti-heal','tank'],ForceOfNature:['team-size'],TacticiansRing:['team-size'],TacticiansScepter:['team-size'],ThiefsGloves:['flex'],TitansResolve:['fighter','AD','AP','scaling'],StatikkShiv:['shred','AP'],WarmogsArmor:['tank']
  };
  const labels={AD:'AD damage',AP:'AP damage',tank:'Tank',mana:'Mana',sustain:'Healing / sustain',crit:'Critical strikes',fighter:'Fighter','attack-speed':'Attack speed',scaling:'Scaling',armor:'Armor','magic-defense':'Magic defense',survival:'Survivability',sunder:'Armor reduction',shred:'Magic-resist reduction','anti-heal':'Anti-heal','anti-tank':'Anti-tank','team-heal':'Ally healing','team-size':'Team size',flex:'Flexible'};
  const important=new Set(['sunder','shred','anti-heal','mana','sustain','team-size','attack-speed','fighter']);
  const profile=id=>roles[id]||['flex'];
  function counts(recipe){const n={};for(const id of recipe)n[id]=(n[id]||0)+1;return n;}
  function available(plan,uid,items){
    const pool={...plan.owned};
    for(const q of plan.queue){if(q.uid===uid)break;if(q.done)continue;const item=items.find(i=>i.id===q.item);for(const c of item.recipe)pool[c]=Math.max(0,(pool[c]||0)-1);}
    return pool;
  }
  function candidate(plan,uid,item,items,options={}){
    const target=plan.queue.find(q=>q.uid===uid);if(!target||target.done||target.item===item.id)return null;
    const original=items.find(i=>i.id===target.item),pool=available(plan,uid,items),need=counts(item.recipe);
    const missing=[],blocked=[];let covered=0;
    for(const [id,n]of Object.entries(need)){covered+=Math.min(n,pool[id]||0);for(let k=0;k<Math.max(0,n-(pool[id]||0));k++)missing.push(id);if((options.avoid||[]).includes(id)&&n>(pool[id]||0))blocked.push(id);}
    if(blocked.length)return null; // Avoid only additional copies; owned copies remain useful.
    const sourceRoles=profile(original.id),candidateRoles=profile(item.id),shared=sourceRoles.filter(r=>candidateRoles.includes(r));
    const originCounts=counts(original.recipe);let overlap=0;for(const [id,n]of Object.entries(need))overlap+=Math.min(n,originCounts[id]||0);
    let fit=shared.reduce((n,r)=>n+(important.has(r)?5:3),0);
    if(candidateRoles.includes(sourceRoles[0]))fit+=5;
    const missingRole=sourceRoles.filter(r=>important.has(r)&&!candidateRoles.includes(r));
    const alreadyPlanned=plan.queue.filter(q=>q.uid!==uid&&!q.done&&q.item===item.id).length;
    return {item,covered,missing,shared,overlap,fit,missingRole,alreadyPlanned,pool,score:fit*10+covered*18+overlap*4};
  }
  function suggest(plan,uid,items,options={}){
    const results=items.map(i=>candidate(plan,uid,i,items,options)).filter(Boolean);
    const role=options.role||'similar';
    return results.filter(r=>role==='all'||(role==='similar'?r.shared.length>0:profile(r.item.id).includes(role)))
      .sort((a,b)=>b.score-a.score||a.item.name.localeCompare(b.item.name));
  }
  function replace(state,uid,id,items,built=false){
    const q=state.queue.find(q=>q.uid===uid),item=items.find(i=>i.id===id);
    if(!q||q.done||!item||q.item===id)return false;
    q.academyItem||=q.item;q.planSource='manual';q.pivotFrom=q.item;q.item=id;delete q.earlyChampion;q.used={};q.done=false;
    if(built)Tracker.complete(state,q,item);
    return true;
  }
  return {roles,labels,profile,available,candidate,suggest,replace};
})();
if(typeof module!=='undefined')module.exports=PivotPlanner;

</script><script>
/* Compact item picker and per-item pivots. */
(() => {
  const view=()=>state;
  let showNames=false,previewId=null,targetId=null,pivotQuery='';
  const tools=document.querySelector('.catalogtools');
  tools.querySelector('.filters').remove();
  const pickerControls=document.createElement('div');
  pickerControls.innerHTML=`<div class="picker-label"><span>Start with a component</span><button id="toggle-names" aria-pressed="false">Show names</button></div><div id="component-picker" class="component-picker" role="group" aria-label="Filter items by component"></div><div class="picker-caption"><span id="picker-caption">All recipes</span><span id="picker-results"></span></div><div id="item-preview" class="item-preview" aria-live="polite"></div>`;
  tools.append(pickerControls);
  document.querySelector('.catalogfoot').textContent='Click an icon to add. Click again for another copy. / to search.';
  const search=document.getElementById('search');search.placeholder='Name, role or component…';
  function matches(item,text){const words=text.toLowerCase().trim().split(/\s+/).filter(Boolean);const hay=[item.name,...item.recipe.map(id=>byId[id].name),...PivotPlanner.profile(item.id).flatMap(r=>[r,PivotPlanner.labels[r]])].join(' ').toLowerCase();return words.every(w=>hay.includes(w));}
  function drawPreview(id){
    previewId=id;const i=byId[id];
    document.getElementById('item-preview').innerHTML=i?`<strong>${esc(i.name)}</strong><span>${i.recipe.map(c=>`${icon(c)}<span>${shortNames[c]}</span>`).join('<b>+</b>')}</span>`:'<strong>Pick your next build</strong><span>Hover or focus an item to see its recipe.</span>';
  }
  renderCatalog=function(){
    const v=view(),found=DATA.items.filter(i=>!i.academyOnly&&(!filter||i.recipe.includes(filter))&&matches(i,query));
    document.getElementById('component-picker').innerHTML=`<button class="base-filter all" data-base="" aria-pressed="${!filter}" title="All item recipes">All</button>`+components.map(c=>`<button class="base-filter" data-base="${c.id}" aria-pressed="${filter===c.id}" title="${esc(c.name)} recipes" aria-label="Show ${esc(c.name)} recipes">${icon(c.id)}</button>`).join('');
    document.getElementById('picker-caption').textContent=filter?byId[filter].name+' recipes':'All recipes';
    document.getElementById('picker-results').textContent=`${found.length} items`;
    const catalog=document.getElementById('catalog');catalog.className='catalog fast-catalog'+(showNames?' with-names':'');
    catalog.innerHTML=found.map(i=>{
      const n=v.queue.filter(q=>q.item===i.id&&!q.done).length;
      const recipe=i.recipe.map(id=>byId[id].name).join(' + ');
      return `<button class="quick-item" data-action="add" data-id="${i.id}" data-focus="add-${i.id}" aria-label="Add ${esc(i.name)}. ${esc(recipe)}${n?'. '+n+' already planned':''}" title="${esc(i.name)} — ${esc(recipe)}">${icon(i.id)}${showNames?`<span>${esc(i.name)}</span>`:''}${n?`<b class="quick-count">${n}</b>`:''}</button>`;
    }).join('')||'<p class="emptysearch">No matching items. Try another component or clear your search.</p>';
    drawPreview(found.some(i=>i.id===previewId)?previewId:found[0]?.id);
  };
  document.getElementById('component-picker').addEventListener('click',e=>{const b=e.target.closest('[data-base]');if(!b)return;filter=filter===b.dataset.base?'':b.dataset.base;renderCatalog();document.querySelector(`[data-base="${filter}"]`)?.focus();});
  document.getElementById('toggle-names').addEventListener('click',e=>{showNames=!showNames;e.currentTarget.setAttribute('aria-pressed',String(showNames));e.currentTarget.textContent=showNames?'Hide names':'Show names';renderCatalog();});
  const catalog=document.getElementById('catalog');
  for(const event of ['mouseover','focusin'])catalog.addEventListener(event,e=>{const b=e.target.closest('.quick-item');if(b)drawPreview(b.dataset.id);});
  search.addEventListener('keydown',e=>{if(e.key==='Enter'){const first=catalog.querySelector('.quick-item');if(first){e.preventDefault();first.click();search.focus();}}});
  document.addEventListener('keydown',e=>{if(e.key==='/'&&!e.ctrlKey&&!e.metaKey&&!e.altKey&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)&&!document.querySelector('dialog[open]')){e.preventDefault();document.getElementById('item-drawer').setAttribute('open','');search.focus();}});

  const drawer=document.createElement('details');drawer.id='item-drawer';drawer.className='item-drawer panel';
  drawer.innerHTML='<summary><span>+ Add an item</span><span class="drawer-key"><kbd>/</kbd></span></summary>';
  document.querySelector('.workspace').before(drawer);drawer.append(document.querySelector('.leftcol'));
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&drawer.hasAttribute('open')&&!document.querySelector('dialog[open]')){drawer.removeAttribute('open');drawer.querySelector('summary').focus();}});
  document.addEventListener('carousel-new-game',()=>{drawer.removeAttribute('open');query='';filter='';search.value='';renderCatalog();});
  const dialog=document.createElement('dialog');dialog.id='pivot-dialog';dialog.setAttribute('aria-labelledby','pivot-title');
  dialog.innerHTML='<div class="pivot-dialog-head"><div id="pivot-original"></div><button id="close-pivot" aria-label="Close pivot chooser">×</button></div><label class="visuallyhidden" for="pivot-search">Find a replacement</label><input id="pivot-search" class="search" type="search" placeholder="Find an item…"><div id="pivot-results"></div>';
  document.body.append(dialog);
  function drawCandidates(){
    const target=state.queue.find(q=>q.uid===targetId&&!q.done);
    if(!target){if(dialog.open)dialog.close();return;}
    document.getElementById('pivot-original').innerHTML=`${icon(target.item)}<div><small>Pivot${target.champion?' · '+IconUI.championLabel(target.champion):''}</small><h2 id="pivot-title">${esc(byId[target.item].name)}</h2></div>`;
    const pool=PivotPlanner.available(state,targetId,DATA.items);
    // Keep all queued item definitions available during allocation, including
    // emblems/specials; only core items are offered as pivot candidates.
    const results=PivotPlanner.suggest(state,targetId,DATA.items,{role:'all'}).filter(r=>!r.item.academyOnly&&matches(r.item,pivotQuery));
    const meta=typeof MetaBuilds!=='undefined'&&MetaBuilds.dataFor?MetaBuilds.ranked(state,targetId,MetaBuilds.dataFor(target)):[];
    const ranks=new Map(meta.map((r,n)=>[r.item.id,{...r,order:n}]));
    if(target.champion)results.sort((a,b)=>(ranks.get(a.item.id)?.order??999)-(ranks.get(b.item.id)?.order??999));
    document.getElementById('pivot-results').innerHTML=results.map(r=>{
      const i=r.item,costs={...pool};
      const recipe=i.recipe.map(c=>{const have=(costs[c]||0)>0;if(have)costs[c]--;return `<span class="pivot-ingredient ${have?'have':''}" aria-label="${esc(byId[c].name)} ${have?'owned':'needed'}">${icon(c)}<span>${shortNames[c]}${have?' ✓':''}</span></span>`;}).join('<b>+</b>');
      return `<article class="pivot-option"><div class="pivot-itemhead">${icon(i.id)}<h3>${esc(i.name)}</h3>${ranks.has(i.id)?`<small class="pivot-meta-tier">MetaTFT ${ranks.get(i.id).tier}${ranks.get(i.id).rankFilter==='ALL'?' · all ranks':''}</small>`:''}</div><div class="pivot-recipe">${recipe}</div><div class="pivot-actions"><button data-pivot-item="${i.id}" data-pivot-kind="plan">Plan instead</button><button class="primary" data-pivot-item="${i.id}" data-pivot-kind="built">Build instead</button></div></article>`;
    }).join('')||'<p class="emptysearch">No matching items.</p>';
  }
  function openPivot(uid){targetId=uid;pivotQuery='';document.getElementById('pivot-search').value='';drawCandidates();dialog.showModal();document.getElementById('pivot-results').scrollTop=0;}
  document.addEventListener('carousel-meta-updated',()=>{if(dialog.open)drawCandidates();});
  window.PivotDialog={open:uid=>{if(state.queue.some(q=>q.uid===uid&&!q.done))openPivot(uid);}};
  document.getElementById('close-pivot').addEventListener('click',()=>dialog.close());
  document.getElementById('pivot-search').addEventListener('input',e=>{pivotQuery=e.target.value;drawCandidates();});
  dialog.addEventListener('click',e=>{
    const b=e.target.closest('[data-pivot-item]');if(!b)return;
    const target=state.queue.find(q=>q.uid===targetId&&!q.done);if(!target){dialog.close();return;}
    const id=b.dataset.pivotItem,built=b.dataset.pivotKind==='built',original=byId[target.item].name;
    mutate(()=>PivotPlanner.replace(state,targetId,id,DATA.items,built),`${byId[id].name} ${built?'built':'planned'} instead of ${original}.`);
    dialog.close();
  });
  const oldRender=render;
  render=function(){
    oldRender();
    for(const card of document.querySelectorAll('.qcard')){
      const id=card.querySelector('[data-action="remove"]')?.dataset.id,q=state.queue.find(q=>q.uid===id);
      if(!q)continue;
      const b=document.createElement('button');b.className='pivot-trigger';b.textContent='Pivot';b.setAttribute('aria-label',`Pivot ${byId[q.item].name}${q.champion?' for '+q.champion:''}`);b.addEventListener('click',()=>openPivot(id));card.querySelector('.qbottom').prepend(b);
    }
    if(dialog.open)drawCandidates();
  };
  document.querySelector('#help ol').insertAdjacentHTML('beforeend','<li>Use <b>Add an item</b> or press <b>/</b> to open the picker. Escape collapses it. On an item, <b>Pivot</b> ranks alternatives by MetaTFT for assigned champions; unassigned items use similarity. <b>Plan instead</b> replaces its target; <b>Build instead</b> also consumes tracked ingredients. Undo reverses either action.</li>');
  render();
})();

</script><script>
/* Compact manual controls. Keyboard shortcuts and whole-item receipts. */
(() => {
  const PREF_KEY='carousel-offline-preferences-v1';let shortcuts=true,receiveQuery='',pendingImport=null;
  try{shortcuts=JSON.parse(localStorage.getItem(PREF_KEY)||'{}').shortcuts!==false;}catch(e){}
  const preferences=()=>{try{localStorage.setItem(PREF_KEY,JSON.stringify({shortcuts}));}catch(e){toast('Settings could not be saved in this browser.');}};
  mutate=function(fn,message='Tracker updated.') {history.push(JSON.stringify(state));if(history.length>40)history.shift();fn();save();render();toast(message);};
  document.querySelector('.topright').insertAdjacentHTML('beforeend','<button id="settings-open" class="quiet">Data & keys</button>');
  const craft=document.createElement('div');craft.id='craft-strip';craft.className='craft-strip';craft.hidden=true;
  craft.innerHTML='<span class="craft-label">Craft now</span><div id="craft-options"></div>';
  document.querySelector('.queuehead').after(craft);
  document.querySelector('.queuehead').insertAdjacentHTML('beforeend','<button id="receive-open" class="receive-open" title="Record a completed item without using loose components">+ Received item</button>');
  const dialog=(id,html)=>{const d=document.createElement('dialog');d.id=id;d.innerHTML=html;document.body.append(d);return d;};
  const receive=dialog('receive-dialog','<div class="modal-heading"><h2 id="receive-title">Received a completed item</h2><button data-close="receive-dialog" aria-label="Close item chooser">×</button></div><p>Completes the next matching target without spending loose components.</p><label class="receive-holder">For <select id="receive-champion"><option value="">Auto · next matching target</option></select></label><label for="receive-search" class="visuallyhidden">Find an item</label><input id="receive-search" class="search" type="search" placeholder="Find an item…"><div id="receive-items" class="receive-items"></div>');receive.setAttribute('aria-labelledby','receive-title');const receiveHolderPicker=IconUI.picker(document.getElementById('receive-champion'),'champion','Received item holder');
  const settings=dialog('settings-dialog','<div class="modal-heading"><h2 id="settings-title">Data & keys</h2><button data-close="settings-dialog" aria-label="Close settings">×</button></div><label class="shortcut-toggle"><input type="checkbox" id="shortcuts-enabled"> Enable component keyboard shortcuts</label><p><kbd>1</kbd>–<kbd>8</kbd> add · <kbd>Shift</kbd> + number removes.<br><kbd>/</kbd> search · <kbd>Ctrl/Cmd</kbd> + <kbd>Z</kbd> undo.<br>Shortcuts pause while typing or using a dialog.</p><hr><p>Progress saves in this browser. Export a backup before moving this HTML file or switching browsers.</p><div class="backup-buttons"><button id="export-backup">Export backup</button><button id="import-open">Import backup</button></div>');settings.setAttribute('aria-labelledby','settings-title');
  const imp=dialog('import-dialog','<div class="modal-heading"><h2 id="import-title">Import tracker backup</h2><button data-close="import-dialog" aria-label="Close backup import">×</button></div><p>Import saved inventory and targets. Paste TFT Academy codes anywhere on the page.</p><label for="backup-file">Backup file</label><input id="backup-file" type="file" accept=".json,application/json"><label for="backup-text">Or paste backup JSON</label><textarea id="backup-text" rows="4" spellcheck="false"></textarea><button id="review-import">Review backup</button><p id="import-feedback" role="status"></p><div id="import-confirm" hidden><p id="import-summary"></p><button id="apply-import" class="primary">Replace tracker</button></div>');imp.setAttribute('aria-labelledby','import-title');
  function drawCraft(){
    const options=OfflineTracker.craftOptions(state);craft.hidden=!options.length;
    document.getElementById('craft-options').innerHTML=options.map(q=>`<button class="craft-chip" data-craft="${q.uid}" data-focus="craft-${q.uid}" aria-label="Craft ${esc(byId[q.item].name)}${q.champion?' for '+esc(q.champion):''}">${icon(q.item)}<span class="craft-champion">${q.champion?IconUI.championLabel(q.champion):esc(byId[q.item].name)}</span></button>`).join('');
  }
  function drawReceive(){
    const select=document.getElementById('receive-champion'),chosen=select.value;
    const names=[...new Set([...state.queue.map(q=>q.champion),...(Academy.guide(state)?.finalComp||[]).map(u=>Academy.snapshot.champions.find(c=>c.apiName===u.apiName)?.name)].filter(Boolean))];
    select.innerHTML='<option value="">Auto · next matching target</option>'+names.map(name=>`<option value="${esc(name)}">${esc(name)}</option>`).join('');select.value=chosen;receiveHolderPicker.refresh();
    const items=DATA.items.filter(i=>(!i.academyOnly||receiveQuery.trim()||state.queue.some(q=>q.item===i.id))&&i.name.toLowerCase().includes(receiveQuery.trim().toLowerCase()));
    document.getElementById('receive-items').innerHTML=items.map(i=>`<button data-receive-item="${i.id}">${icon(i.id)}<span>${esc(i.name)}<small>${state.queue.some(q=>q.item===i.id&&!q.done)?'Completes next target':'Add as completed'}</small></span></button>`).join('')||'<p>No matching items.</p>';
  }
  const oldRender=render;render=function(){oldRender();drawCraft();document.querySelectorAll('.benchitem').forEach((el,n)=>{if(n<8)el.insertAdjacentHTML('afterbegin',`<kbd class="bench-key" title="${n+1}: add · Shift + ${n+1}: remove">${n+1}</kbd>`);});if(receive.open)drawReceive();};
  document.getElementById('receive-open').addEventListener('click',()=>{receiveQuery='';document.getElementById('receive-search').value='';drawReceive();receive.showModal();document.getElementById('receive-search').focus();});
  document.getElementById('receive-search').addEventListener('input',e=>{receiveQuery=e.target.value;drawReceive();});
  document.addEventListener('click',e=>{
    const close=e.target.closest('[data-close]');if(close)document.getElementById(close.dataset.close).close();
    const rec=e.target.closest('[data-receive-item]');if(rec){const id=rec.dataset.receiveItem,holder=document.getElementById('receive-champion').value;mutate(()=>{let q=state.queue.find(q=>q.item===id&&!q.done&&(!holder||q.champion===holder));if(!q){q={uid:crypto.randomUUID(),item:id,champion:holder};state.queue.push(q);}OfflineTracker.receive(state,q);},`Received ${byId[id].name}; loose components kept.`);receive.close();}
    const c=e.target.closest('[data-craft]');if(c){const q=state.queue.find(q=>q.uid===c.dataset.craft&&!q.done);if(q&&OfflineTracker.canCraft(state.owned,byId[q.item]))mutate(()=>Tracker.complete(state,q,byId[q.item]),`${byId[q.item].name} crafted.`);}
  });
  document.getElementById('settings-open').addEventListener('click',()=>{document.getElementById('shortcuts-enabled').checked=shortcuts;settings.showModal();});
  document.getElementById('shortcuts-enabled').addEventListener('change',e=>{shortcuts=e.target.checked;preferences();});
  document.addEventListener('keydown',e=>{
    if(e.defaultPrevented||e.repeat||e.isComposing||document.querySelector('dialog[open]')||['INPUT','TEXTAREA','SELECT'].includes(document.activeElement?.tagName)||document.activeElement?.isContentEditable)return;
    if((e.ctrlKey||e.metaKey)&&!e.shiftKey&&!e.altKey&&e.key.toLowerCase()==='z'){e.preventDefault();document.getElementById('undo').click();return;}
    if(e.ctrlKey||e.metaKey||e.altKey||!shortcuts)return;
    const m=/^(?:Digit|Numpad)([1-8])$/.exec(e.code||'');if(!m)return;
    e.preventDefault();const id=componentOrder[Number(m[1])-1];
    if(e.shiftKey){if(state.owned[id]>0)mutate(()=>LootTracker.remove(state,id),`${byId[id].name} removed.`);}
    else if((state.owned[id]||0)<99)mutate(()=>LootTracker.gain(state,id,'loot'),`${byId[id].name} collected.`);
  });
  document.getElementById('export-backup').addEventListener('click',()=>{
    const backup={app:'carousel-offline',version:1,exportedAt:new Date().toISOString(),state,shortcuts,academy:Academy.snapshot};
    const url=URL.createObjectURL(new Blob([JSON.stringify(backup)],{type:'application/json'})),a=document.createElement('a');a.href=url;a.download='Carousel-backup-'+new Date().toISOString().slice(0,10)+'.json';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),30000);toast('Backup download started.');
  });
  function resetImport(){pendingImport=null;document.getElementById('import-confirm').hidden=true;document.getElementById('import-feedback').textContent='';}
  function review(text){resetImport();try{
    if(text.length>5000000)throw new Error('Choose a backup smaller than 5 MB.');
    const raw=JSON.parse(text);if(raw.app&&raw.app!=='carousel-offline'||raw.version&&raw.version!==1)throw new Error('This is not a supported Carousel backup.');
    // Register metadata first so backups with newer set items can be validated.
    if(raw.academy?.guides?.length&&raw.academy?.items?.length&&raw.academy?.champions?.length)Academy.register(raw.academy,byId);
    pendingImport={state:OfflineTracker.cleanState(raw.state||raw),shortcuts:raw.shortcuts,academy:raw.academy};
    const s=pendingImport.state;document.getElementById('import-summary').textContent=`Replace your tracker with ${s.queue.length} items and ${Object.values(s.owned).reduce((a,b)=>a+b,0)} loose components? Undo can restore your previous tracker.`;document.getElementById('import-confirm').hidden=false;
  }catch(e){document.getElementById('import-feedback').textContent=e instanceof SyntaxError?'That is not valid backup JSON.':e.message;}}
  document.getElementById('import-open').addEventListener('click',()=>{settings.close();resetImport();document.getElementById('backup-text').value='';document.getElementById('backup-file').value='';imp.showModal();});
  document.getElementById('backup-text').addEventListener('input',resetImport);
  document.getElementById('backup-file').addEventListener('change',async e=>{resetImport();const f=e.target.files?.[0];if(!f)return;try{if(f.size>5000000)throw new Error('Choose a backup smaller than 5 MB.');const text=await f.text();document.getElementById('backup-text').value=text;review(text);}catch(err){document.getElementById('import-feedback').textContent=err.message;}});
  document.getElementById('review-import').addEventListener('click',()=>review(document.getElementById('backup-text').value));
  document.getElementById('apply-import').addEventListener('click',()=>{if(!pendingImport)return;const p=pendingImport;mutate(()=>state=p.state,'Tracker backup imported.');if(typeof p.shortcuts==='boolean')shortcuts=p.shortcuts;if(p.academy?.guides?.length){Academy.snapshot=p.academy;try{localStorage.setItem(Academy.cacheKey,JSON.stringify(p.academy));}catch(e){}}preferences();imp.close();pendingImport=null;});
  document.querySelector('#help ol').insertAdjacentHTML('beforeend','<li><b>Craft now</b> is a compact row of ready-item shortcuts. Click an icon to craft it immediately; the name underneath is its target champion.</li><li><b>Received item</b> records completed carousel/anvil items without spending loose components.</li><li>Use <b>1–8</b> to add components, <b>Shift + number</b> to remove, and <b>Ctrl/Cmd + Z</b> to undo. Keys are shown on the bench. Manage backups in <b>Data & keys</b>.</li>');
  render();
})();

</script><script>
const QuickImport = {
  choose(text) {
    const result=Academy.match(text);
    if(!result.exact)throw new Error('No exact TFT Academy comp matches this code. Your current queue is unchanged.');
    const tier={S:0,A:1,B:2,C:3,D:4};
    const candidates=[...result.matches].sort((a,b)=>(tier[a.guide.tier]??9)-(tier[b.guide.tier]??9)||String(b.guide.updated).localeCompare(String(a.guide.updated))||a.guide.title.localeCompare(b.guide.title));
    const guide=candidates[0].guide,plan=Academy.build(guide);
    if(plan.missing.length)throw new Error('Some items in this guide are not recognized yet. Your current queue is unchanged.');
    if(!plan.entries.length)throw new Error('This guide has no recommended items. Your current queue is unchanged.');
    return {guide,entries:plan.entries,priorities:plan.priorities,variants:candidates.length};
  },
  replace(plan,choice,code) {
    const completed=plan.queue.filter(q=>q.done),available=[...completed];
    const holders=Academy.equipment({...plan,activeComp:{id:choice.guide.id}});
    const pending=[];let covered=0;
    for(const entry of choice.entries){
      const at=available.findIndex(q=>Academy.itemMatches(entry.item,q.item)&&holders.get(q.uid)===entry.champion);
      if(at>=0){available.splice(at,1);covered++;}
      else pending.push({...entry,academyItem:entry.item,planSource:'academy',uid:crypto.randomUUID(),recommendedOrder:pending.length,done:false,used:{}});
    }
    // Preserve physical inventory exactly, including completed items no longer
    // recommended by the new comp. Each owned copy covers only one target.
    plan.queue=[...completed,...pending];plan.pivotIntents={};
    plan.activeComp={guide:Academy.cleanGuide(choice.guide),id:choice.guide.id,title:choice.guide.title,code,itemPriority:choice.priorities||Academy.priorities(choice.guide)};
    return {pending:pending.length,covered};
  }
};

</script><script>
(() => {
  let intent=0,refreshTask=null,refreshSet=null,refreshNote='';
  const bar=document.createElement('div');bar.className='academy-bar';
  bar.innerHTML='<a id="academy-tierlist" href="https://tftacademy.com/tierlist/comps" aria-haspopup="dialog">TFT Academy tierlist ↗</a><span id="academy-status" role="status"></span>';
  document.querySelector('.pagehead').after(bar);
  const feedback=document.createElement('p');feedback.id='comp-feedback';feedback.className='quick-import-feedback';feedback.setAttribute('role','status');bar.after(feedback);
  function status(){
    const s=Academy.snapshot,date=new Date(s.updated||s.fetchedAt),label=Number.isNaN(date.getTime())?'unknown':date.toLocaleString([],{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'});
    const el=document.getElementById('academy-status');
    el.textContent=`Updated ${label} · Patch ${s.patch||'unknown'}${refreshNote?' · '+refreshNote:''}`;
    el.title='TFT Academy’s last tierlist update. Data checks run automatically in the background.';
  }
  const priority=document.createElement('div');priority.id='academy-priority';priority.className='academy-priority';priority.hidden=true;
  document.querySelector('.queuehead').before(priority);
  function drawPriority(){
    const list=state.activeComp?.itemPriority||[];priority.hidden=!list.length;
    priority.innerHTML=list.length?'<span>Academy priority</span>'+list.map((p,n)=>`${n?'<span aria-hidden="true">›</span>':''}<span class="academy-priority-item" title="${esc(byId[p.id]?.name||p.id)}${p.component?' · component preference':''}" aria-label="${n+1}. ${esc(byId[p.id]?.name||p.id)}${p.component?', component preference':''}">${icon(p.id)}${p.component?'<small>component</small>':''}</span>`).join(''):'';
  }
  const oldRender=render;render=function(){oldRender();document.getElementById('app-title').textContent=state.activeComp?.title||'Carousel';status();drawPriority();};
  async function refreshData(set){
    const key=set||'current';
    if(refreshTask){
      if(refreshSet===key)return refreshTask;
      const previous=refreshTask;await previous;
      return refreshData(set);
    }
    refreshSet=key;refreshNote='updating…';status();
    const task=(async()=>{
      try{const r=await Academy.refresh(set);refreshNote=r.saved?'':'updated for this session';render();return true;}
      catch(e){refreshNote='offline / unavailable · saved data';status();return false;}
    })();
    refreshTask=task;
    try{return await task;}finally{if(refreshTask===task){refreshTask=null;refreshSet=null;}}
  }
  async function importCode(text){
    const code=text.trim(),mine=++intent;
    feedback.classList.remove('error');
    let decoded;
    try{decoded=Academy.decodeCode(code);}catch(e){feedback.textContent=e.message;feedback.classList.add('error');return;}
    let choice;
    try{choice=QuickImport.choose(code);}catch(e){
      feedback.textContent='Checking TFT Academy for this comp…';
      await refreshData(decoded.set);
      if(mine!==intent)return;
      try{choice=QuickImport.choose(code);}catch(err){feedback.textContent='Could not match this code exactly. Your queue and inventory are unchanged. Copy the full code from a TFT Academy final board and paste it again when online.';feedback.classList.add('error');return;}
    }
    if(mine!==intent)return;
    let counts;
    mutate(()=>{counts=QuickImport.replace(state,choice,code);},`${choice.guide.title} imported. Bench and completed items kept.`);
    document.dispatchEvent(new Event('carousel-comp-imported'));
    feedback.textContent=`${counts.pending} targets${counts.covered?' · '+counts.covered+' already owned':''}.`+(choice.variants>1?` ${choice.variants} guides share this code; using the highest-tier, most recently updated match.`:'');
    document.getElementById('item-drawer').removeAttribute('open');
    // A recognized code also works when a search field or utility dialog has
    // focus. Return directly to the tracker after importing.
    for(const d of document.querySelectorAll('dialog[open]'))d.close();
  }
  document.addEventListener('paste',e=>{
    const text=e.clipboardData?.getData('text/plain')?.trim()||'';
    // Intercept team codes only. Ordinary text/backup JSON pastes keep their
    // normal behavior, including inside search fields and textareas.
    if(!/^(?:01|02)[0-9a-f]*TFTSet\d+(?:_(?:Act2|Stage2_Revival))?$/i.test(text))return;
    e.preventDefault();void importCode(text);
  },true);
  document.addEventListener('carousel-new-game',()=>{intent++;feedback.textContent='';feedback.classList.remove('error');void refreshData();});
  document.addEventListener('click',e=>{if(e.target.closest('[data-action="undo"],#apply-import')){intent++;feedback.textContent='';feedback.classList.remove('error');}},true);
  document.querySelector('#help ol').insertAdjacentHTML('beforeend','<li>Paste a TFT Academy team code anywhere with <b>Ctrl/Cmd + V</b>. Its final-board items immediately replace unfinished targets, ordered by Academy’s Item Priority list. Each listed item promotes one copy; component-only lists use the guide’s early-board items first, then favor recipes using its preferred components. Early holder → final holder appears on those cards. Loose components and completed items stay; matching completed items count toward the new build. Undo reverses the import.</li><li><b>New game</b> immediately clears targets, completed items, components, and pins. Academy data refreshes in the background on launch and on each new game. If unavailable, saved data keeps working.</li><li>Only exact champion matches are imported. If multiple guides use the same code, the highest-tier, most recently updated guide is used and shown in the heading.</li>');
  render();
  void refreshData();
})();

</script><script>
(() => {
  const bench=document.querySelector('.bench');
  document.getElementById('item-drawer').before(bench);
  document.getElementById('bench-title').textContent='Component bench';
  document.querySelector('.benchnote').innerHTML='<kbd>1</kbd>–<kbd>8</kbd> add · <kbd>Shift</kbd> + number removes';
  bench.querySelector('.panelhead').append(bench.querySelector('.benchnote'));
  const owned=document.createElement('div');owned.id='owned-bench';owned.className='owned-bench';
  owned.setAttribute('aria-label','Loose components in hand');bench.append(owned);
  function drawOwned(){
    const held=components.filter(c=>(state.owned[c.id]||0)>0);
    owned.innerHTML='<span class="owned-bench-label">In hand</span><div class="owned-bench-items" role="list">'+(held.length?held.map(c=>`<span class="owned-component" role="listitem" data-owned-component="${c.id}" aria-label="${esc(c.name)}: ${state.owned[c.id]}" title="${esc(c.name)}">${icon(c.id)}<b>×${state.owned[c.id]}</b></span>`).join(''):'<span class="owned-bench-empty">No loose components</span>')+'</div>';
  }
  const completed=document.createElement('section');completed.id='completed-strip';completed.className='completed-strip';completed.setAttribute('aria-labelledby','completed-heading');
  completed.innerHTML='<h2 id="completed-heading">Completed <span id="completed-total"></span></h2>';
  const list=document.getElementById('completed');document.querySelector('.queuehead').before(completed);completed.append(list);list.setAttribute('role','list');
  const oldRender=render;
  render=function(){oldRender();drawOwned();const count=state.queue.filter(q=>q.done).length;completed.hidden=!count;document.getElementById('completed-total').textContent=count;};
  render();
})();

