"},{"apiName":"DA_QuickStreaks","name":"Quick Streaks","description":"You gain twice as much progress towards win and loss streaks. Gain 2 gold.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_ClutteredMind","name":"Cluttered Mind","description":"Gain 4 1-cost champions now. If your bench is full at the end of player combat, gain 3 XP.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_DuoQueue","name":"Duo Queue","description":"Gain 2 random 5-cost champions and 2 copies of a random component.","stages":["4-2"],"tier":2},{"apiName":"DA_SpreadingRoots","name":"Spreading Roots","description":"Gain a random Emblems. After 3 combats, gain another.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_SpreadingRootsPlus","name":"Spreading Roots+","description":"Gain 2 random Emblems and 2 gold.","stages":["3-2"],"tier":2},{"apiName":"DA_TheTraitTree","name":"The Trait Tree","description":"Gain 3 random Emblems and 2 gold.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_TheTraitTreePlus","name":"The Trait Tree+","description":"Gain 3 random Emblems, a Reforger, and 4 gold.","stages":["3-2"],"tier":3},{"apiName":"DA_BirthdayPresent","name":"Birthday Present","description":"Gain a 2-star champion and 1 gold each time you level up. The champion's cost tier is your level minus 4 (max: 5-cost).","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_GoldenGamble","name":"Golden Gamble","description":"Gain 2 gold and flip a coin. If heads, gain a Radiant Lucky Item Chest. If tails, gain 2 Completed Item anvils.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_GoldenGamblePlus","name":"Golden Gamble+","description":"Gain 3 gold and flip a coin. If heads, gain a Radiant Lucky Item Chest. If tails, gain 2 Completed Item anvils.","stages":["3-2"],"tier":3},{"apiName":"DA_GoldenGamblePlusPlus","name":"Golden Gamble++","description":"Gain 6 gold and flip a coin. If heads, gain a Radiant Lucky Item Chest. If tails, gain 2 Completed Item anvils.","stages":["4-2"],"tier":3},{"apiName":"DA_UrfsGrabBag","name":"Urf's Grab Bag","description":"Gain 1 Spatula, 3 random components, and 5 gold.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_URF","name":"U.R.F","description":"Gain a Spatula. Champions holding Spatula or Frying Pan items gain 20% Attack Speed and 3 Mana Regen.","stages":["2-1","3-2","4-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_PartialAscension","name":"Partial Ascension","description":"After 12 seconds of combat, your units gain 20% Damage Amp.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_NewRecruit","name":"New Recruit","description":"Gain +1 max team size and 1 4-cost champion.","stages":[],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_NewRecruitPlus","name":"New Recruit+","description":"Gain +1 max team size and 2 4-cost champions.","stages":[],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_Expedition","name":"Expedition","description":"At the start of every round, lose the champion in the rightmost bench slot. After losing 33 gold of champions in this way, gain a powerful reward. Gain a 3-cost champion now.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_TonsOfStatsI","name":"Tons of Stats!","description":"Your team gains 44 Health, 4% Attack Damage, 4% Ability Power, 4 Armor, 4 Magic Resist, 4% Attack Speed, and 4 Mana.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_TonsOfStatsII","name":"TONS of Stats!","description":"Your team gains 88 Health, 8% Attack Damage, 8% Ability Power, 8 Armor, 8 Magic Resist, 8% Attack Speed, and 8 Mana.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_BoosterPack","name":"Booster Pack","description":"Gain 12 gold of random champions. (At least one 3-cost guaranteed!)","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_BoosterPackPlus","name":"Booster Pack+","description":"Gain 18 gold of random champions. (At least one 4-cost guaranteed!)","stages":["3-2"],"tier":2},{"apiName":"DA_BoosterPackPlusPlus","name":"Booster Pack++","description":"Gain 26 gold of random champions. (At least one 5-cost guaranteed!)","stages":["4-2"],"tier":2},{"apiName":"DA_BlackthornTraitAugment","name":"Item Extraction","description":"The first 4 times you sacrifice a champion in the Blackthorn hex, gain a copy of a random component they're holding. Gain a Veigar and a Rek'Sai.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_ElderwoodTraitAugment","name":"Nature's Shelter","description":"Champions that start combat adjacent to an Elderwood plant gain 15% Attack Speed and heal 2% of their maximum Health every 2 seconds. Gain an Alistar, an Ornn, and a Xayah.","stages":["2-1","3-2","4-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_RiftbeastTraitAugment","name":"Omega Riftbeast","description":"You can now choose a second Alpha Riftbeast. Gain a Scuttlecrab, a Cinderling, and a Pebbles.","stages":["2-1","3-2","4-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_FaeTraitAugment","name":"Embiggen","description":"Fae pixies are now larger and grant 50% more Attack Damage and Ability Power. Fae champions gain 10% Attack Damage and Ability Power immediately. Gain a Xayah and a Rakan.","stages":["2-1","3-2","4-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_BlossomTraitAugment","name":"Blossom's Call","description":"When you buy a Wisp, gain a random Blossom champion based on the Wisp's cost. Gain a Yunara, a Yorick, and a Karma.","stages":["4-2"],"tier":2},{"apiName":"DA_18_InfernoTraitAugment","name":"Flame On","description":"Your 1 and 2-cost Inferno champions gain 20% Attack Damage and Ability Power. The one who did the most damage last combat gains double. Gain a Varus and an Akali.","stages":[],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_FloraFatalisAugment","name":"Consuming Flora","description":"Gain a Flora Fatalis emblem. The champion holding the emblem gains 50% increased benefits from Flora Fatalis. Gain 3 gold.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_FloraFatalisAugmentPlus","name":"Consuming Flora","description":"Gain a Flora Fatalis emblem. The champion holding the emblem gains double benefits from the Flora Fatalis trait.","stages":["3-2"],"tier":2},{"apiName":"DA_18_FloraFatalisAugmentPlusPlus","name":"Consuming Flora","description":"Gain a Flora Fatalis emblem. The champion holding the emblem gains double benefits from the Flora Fatalis trait.","stages":["4-2"],"tier":2},{"apiName":"DA_18_CovenTraitAugment","name":"Coven Acolyte","description":"When you choose to continue gathering Coven essence, heal 2 Tactician health. Gain a Camille, an Elise, and a Caitlyn.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_SolarTraitAugment","name":"Chosen of the Sun","description":"Gain a Leona, a Kayle, and a Sejuani. Leona gains 70 permanent max Health each round, increased by 10 for each unique 3-star champion fielded.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_CovenTraitAugment_LootToAP","name":"Dark Ritual","description":"Converting Coven Essence to rewards grants Coven champions Ability Power instead of loot. Gain a Camille, an Elise, and a Caitlyn.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_LunarTraitAugment","name":"Sun and Moon","description":"Your Lunar champions gain 100 Health and 8% Damage Amp for each unique Solar champion fielded. Gain a Leona, a Kayle, and a Diana.","stages":["3-2"],"tier":2},{"apiName":"DA_18_LunarTraitAugmentPlus","name":"Sun and Moon+","description":"Your Lunar champions gain 100 Health and 8% Damage Amp for each unique Solar champion fielded. Gain a Leona, a Kayle, and an Aphelios.","stages":["4-2"],"tier":2},{"apiName":"DA_18_RiftbeastTraitAugmentStampede","name":"Jungle Pathing","description":"Gain a Pebbles, a Cinderling, a Scuttle Crab, and a Murkwolf. Each time you level up, gain a new Riftbeast and 1 gold.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_CyberneticUplink_Gold","name":"Cybernetic Uplink","description":"Your champions holding an item gain 100 Health and 2 Mana Regen. Gain a Tear of the Goddess.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_CyberneticImplants_Gold","name":"Cybernetic Implants","description":"Your champions holding an item gain 100 Health and 15% Attack Damage. Gain a B.F. Sword.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_18_PrimalAugment_Nidalee","name":"Beast Within","description":"Primal grants an additional Blessing. Gain a Vi now and a Nidalee after 3 rounds.","stages":["3-2"],"tier":2},{"apiName":"DA_18_PrimalAugment_Sivir","name":"Beast Within","description":"Primal grants an additional Blessing. Gain a Vi now and a Sivir after 3 rounds.","stages":["3-2"],"tier":2},{"apiName":"DA_18_PrimalAugmentPlus_Nidalee","name":"Beast Within+","description":"Primal grants an additional Blessing. Gain a Vi and a Nidalee.","stages":["4-2"],"tier":2},{"apiName":"DA_18_PrimalAugmentPlus_Sivir","name":"Beast Within+","description":"Primal grants an additional Blessing. Gain a Vi and a Sivir.","stages":["4-2"],"tier":2},{"apiName":"DA_PlotArmor","name":"Plot Armor","description":"Your team gains 8 Armor and Magic Resist. After falling below 50% Health, increase this to 40 for the rest of combat.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_NestingDolls","name":"Nesting Dolls","description":"After a champion dies in combat, spawn a copy of them one star level lower with 50% health. Gain 3 free rerolls.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_NestingDollsPlus","name":"Nesting Dolls","description":"After a champion dies in combat, spawn a copy of them one star level lower with 60% health. Gain 3 free rerolls.","stages":["3-2"],"tier":3},{"apiName":"DA_NestingDollsPlusPlus","name":"Nesting Dolls","description":"After a champion dies in combat, spawn a copy of them one star level lower with 60% health. Gain 3 free rerolls.","stages":["4-2"],"tier":3},{"apiName":"DA_PandorasBench","name":"Pandora's Bench","description":"At the start of every round, champions on the 3 rightmost bench slots transform into random champions of the same cost. Gain 4 gold.","stages":["2-1","3-2"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_ItsMeBaby","name":"It's Me, Baby","description":"Gain a spotlight in the bottom right corner. The champion in it gains 15% Damage Amp and 15% Attack Speed, and drops 1 gold every 5 takedowns.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_DeadlierCaps","name":"Deadlier Caps","description":"Gain a Rabadon's Deathcap. Rabadon's Deathcaps grant 1 Mana Regen and permanently gain 1% Ability Power whenever their holders score a takedown.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_LuxAugmentII","name":"Master of All Origins","description":"Open an armory and choose one of 3 traits. Gain a Lux with that trait and a Spear of Shojin.\n\nTraits on your board are more likely to appear in the armory. Lux provides +2 to her chosen trait","stages":["4-2"],"tier":3},{"apiName":"DA_GoldDestiny","name":"Gold Destiny","description":"Gain a random Gold Augment and 3 gold.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_GoldDestinyPlus","name":"Gold Destiny+","description":"Gain a random Gold Augment and 5 gold.","stages":["3-2"],"tier":2},{"apiName":"DA_SilverDestiny","name":"Silver Destiny","description":"Gain a random Silver Augment and 2 gold.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_SilverDestinyPlus","name":"Silver Destiny+","description":"Gain a random Silver Augment and 4 gold.","stages":["3-2"],"tier":1},{"apiName":"DA_SilverDestinyPlusPlus","name":"Silver Destiny++","description":"Gain a random Silver Augment and 7 gold.","stages":["4-2"],"tier":1},{"apiName":"DA_PrismaticDestiny","name":"Prismatic Destiny","description":"Gain a random Prismatic Augment and 4 gold.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_PrismaticDestinyPlus","name":"Prismatic Destiny+","description":"Gain a random Prismatic Augment and 7 gold.","stages":["3-2"],"tier":3},{"apiName":"DA_MissedConnections","name":"Missed Connections","description":"Gain a copy of each 1-cost champion.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_ConstructACompanion","name":"Construct a Companion","description":"The next 1-cost champion you buy is 3-star. Gain 2 gold.","stages":["3-2"],"tier":2},{"apiName":"DA_ForgeAFriend","name":"Forge A Friend","description":"The next 1-cost champion you buy is 3-star. Gain 5 gold.","stages":["4-2"],"tier":1},{"apiName":"DA_18_SprykinAugment","name":"Small Furry Friend","description":"While Sprykin is active, gain a second BFF summon that is 35% as powerful. Gain a Teemo, a Veigar, and a Kobuko.","stages":["2-1","3-2","4-2"],"tier":2,"icon":"data:image/webp;base64,UklGRqIAAABXRUJQVlA4WAoAAAAQAAAAvwAAvwAAQUxQSBIAAAABBxARERASJPx/bzKi/2n/+wNWUDggagAAANAKAJ0BKsAAwAA+KRSJQ6GhIRAkABgChLS3cLtYjaAJ7Xoq4QZBDVUmu20XCDIIaqk122i4QZBDVUmu20XCDIIaqk122i4QZBDVUmu20XCDIIaqk122i4QZBDVUmugAAP7/80uAAAAAAAA="},{"apiName":"DA_BuildABud","name":"Build A Bud","description":"Gain a random 3-star 1-cost champion. Gain 6 gold.","stages":["2-1"],"tier":3}],"guides":[{"id":"u17zsaclo9tdx9c","title":"Ashe Juggernauts","compSlug":"set-18-ashe-juggernauts","tier":"A","set":18,"updated":"2026-09-30 21:31:52.846Z","mainChampion":{"apiName":"DA_18_Ashe"},"mainItem":null,"mainAugment":null,"style":"4-Cost Fast 8","difficulty":"HARD","altBuilds":[],"carousel":[{"apiName":"DA_InfinityEdge"},{"apiName":"DA_WarmogsArmor"},{"apiName":"DA_Component_RecurveBow"},{"apiName":"DA_Component_BFSword"}],"earlyComp":[{"apiName":"DA_Karma18","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Rakan","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Yorick","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Yunara","items":["DA_SpearOfShojin","DA_InfinityEdge"],"boardIndex":null,"stars":1}],"finalComp":[{"apiName":"DA_18_Rakan","items":[],"boardIndex":2,"stars":1},{"apiName":"DA_Vi18","items":[],"boardIndex":3,"stars":1},{"apiName":"DA_Amumu18","items":["DA_WarmogsArmor","DA_BrambleVest","DA_DragonsClaw"],"boardIndex":5,"stars":1},{"apiName":"DA_18_Sivir","items":["DA_InfinityEdge","DA_StrikersFlail","DA_SpearOfShojin"],"boardIndex":25,"stars":1},{"apiName":"DA_18_Ivern","items":[],"boardIndex":21,"stars":1},{"apiName":"DA_18_Maokai","items":[],"boardIndex":4,"stars":1},{"apiName":"DA_Taric18","items":[],"boardIndex":1,"stars":1},{"apiName":"DA_18_Ashe","items":["DA_SpearOfShojin","DA_LastWhisper","DA_RedBuff"],"boardIndex":27,"stars":1}],"augments":[{"apiName":"DA_BlackthornTraitAugment"},{"apiName":"DA_18_BigGrabBag"},{"apiName":"DA_CyberneticUplink_Gold"},{"apiName":"DA_CommerceCore"},{"apiName":"DA_SpreadingRoots"},{"apiName":"DA_TheTraitTree"},{"apiName":"DA_CarveAPath"},{"apiName":"DA_BoxingLessons"}],"augmentsTip":"Consider this as a flex option for a Sivir board if you were playing around Juggernauts in the midgame already. If you get Juggernaut emblem, you can play 6 Juggernauts. Can also play other 5 cost AD carries like Dragon and Draven. Take turtle primal buff.","tips":[{"stage":"Stage 2","tip":"Open with a strong AD opener, preferably around Yunara. Slam generic AD items and Tank items for a win streak."},{"stage":"Stage 3","tip":"Level up for more juggernauts and executioners to pair with our blossom opener."},{"stage":"Stage 4","tip":"Level and roll for 6 juggernauts +Sivir. Once stable, go 9 and look for Ashe and transition your board to 5 costs."}]},{"id":"tovtvp6zh0jp8wg","title":"Aphelios Nidalee","compSlug":"set-18-aphelios-nidalee","tier":"A","set":18,"updated":"2026-09-30 21:31:53.079Z","mainChampion":{"apiName":"DA_18_Aphelios"},"mainItem":null,"mainAugment":null,"style":"4-Cost Fast 8","difficulty":"MEDIUM","altBuilds":[{"apiName":"DA_18_Aphelios","items":["DA_Artifact_GoldCollector"],"boardIndex":null,"stars":1},{"apiName":"DA_18_Aphelios","items":["DA_GuinsoosRageblade","DA_InfinityEdge","DA_KrakensFury"],"boardIndex":null,"stars":1}],"carousel":[{"apiName":"DA_Component_BFSword"},{"apiName":"DA_Component_SparringGloves"},{"apiName":"DA_Component_ChainVest"},{"apiName":"DA_Component_RecurveBow"}],"earlyComp":[{"apiName":"DA_18_Ornn","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Varus","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Xayah","items":["DA_RedBuff","DA_InfinityEdge"],"boardIndex":null,"stars":1},{"apiName":"DA_18_Shen","items":[],"boardIndex":null,"stars":1}],"finalComp":[{"apiName":"DA_18_Varus","items":[],"boardIndex":27,"stars":1},{"apiName":"DA_18_Diana","items":[],"boardIndex":9,"stars":1},{"apiName":"DA_KogMaw18_AD","items":[],"boardIndex":22,"stars":1},{"apiName":"DA_Vi18","items":[],"boardIndex":10,"stars":1},{"apiName":"DA_Amumu18","items":[],"boardIndex":3,"stars":1},{"apiName":"DA_18_Aphelios","items":["DA_RedBuff","DA_Deathblade","DA_GiantSlayer"],"boardIndex":21,"stars":1},{"apiName":"DA_Nidalee18_AP","items":["DA_InfinityEdge","DA_SpearOfShojin","DA_SteraksGage"],"boardIndex":14,"stars":1},{"apiName":"DA_Sentinel18","items":["DA_ProtectorsVow","DA_ProtectorsVow","DA_WarmogsArmor"],"boardIndex":2,"stars":1}],"augments":[{"apiName":"DA_Swordsmith"},{"apiName":"DA_CarveAPath"},{"apiName":"DA_SwordOverflow"},{"apiName":"DA_BlackthornTraitAugment"},{"apiName":"DA_BuriedTreasuresIII"},{"apiName":"DA_18_FOURcing"},{"apiName":"DA_OneBuffTwoBuff"},{"apiName":"DA_EpicRolldown"}],"augmentsTip":"Red Buff is BIS Aphelios but you can also play Rageblade build. Amumu or Sentinel 2 can be your main tank (you're often contested so prioritize whichever gets upgraded). Kogmaw Provides Free Shred + Sunder. ","tips":[{"stage":"Stage 2","tip":"Open with a strong win streak AD tempo around Rapidfires. BIS is somewhat fake in this comp so slam aggressively to win."},{"stage":"Stage 3","tip":"Comp can use many items so take item augment if you don't have one yet. Mama Beak can be a strong carry here if you have Riftbeasts online."},{"stage":"Stage 4","tip":"Level to 8 and roll heavily for Aphelios and the 4 costs. Only push for 9 once you have almost all your 4 costs upgraded. "}]},{"id":"uqypgdyijf2m8jp","title":"6 Juggernaut Flex","compSlug":"set-18-6-juggernaut-ap","tier":"A","set":18,"updated":"2026-09-30 21:31:53.035Z","mainChampion":{"apiName":"DA_Amumu18"},"mainItem":{"apiName":"DA_18_EmblemJuggernaut"},"mainAugment":null,"style":"4-Cost Fast 8","difficulty":"HARD","altBuilds":[],"carousel":[{"apiName":"DA_ArchangelsStaff"},{"apiName":"DA_WarmogsArmor"},{"apiName":"DA_Component_TearOfTheGoddess"},{"apiName":"DA_Component_NeedlesslyLargeRod"}],"earlyComp":[{"apiName":"DA_18_Rakan","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Yorick","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_Karma18","items":["DA_SpearOfShojin","DA_ArchangelsStaff"],"boardIndex":null,"stars":1},{"apiName":"DA_18_Yunara","items":[],"boardIndex":null,"stars":1}],"finalComp":[{"apiName":"DA_18_Yorick","items":[],"boardIndex":0,"stars":1},{"apiName":"DA_Scuttlecrab18","items":[],"boardIndex":2,"stars":1},{"apiName":"DA_Vi18","items":[],"boardIndex":3,"stars":1},{"apiName":"DA_Amumu18","items":["DA_WarmogsArmor","DA_BrambleVest","DA_DragonsClaw"],"boardIndex":5,"stars":1},{"apiName":"DA_18_Sivir","items":["DA_RedBuff","DA_GiantSlayer","DA_InfinityEdge"],"boardIndex":26,"stars":1},{"apiName":"DA_18_Zyra","items":["DA_SpearOfShojin","DA_ArchangelsStaff","DA_HextechGunblade"],"boardIndex":27,"stars":1},{"apiName":"DA_18_Ashe","items":[],"boardIndex":21,"stars":1},{"apiName":"DA_18_Maokai","items":[],"boardIndex":4,"stars":1},{"apiName":"DA_18_Kennen","items":["DA_18_EmblemJuggernaut"],"boardIndex":10,"stars":1}],"augments":[{"apiName":"DA_BlackthornTraitAugment"},{"apiName":"DA_18_BigGrabBag"},{"apiName":"DA_CyberneticUplink_Gold"},{"apiName":"DA_CommerceCore"},{"apiName":"DA_SeraphimsStaff"},{"apiName":"DA_SpreadingRoots"},{"apiName":"DA_TheTraitTree"},{"apiName":"DA_BoxingLessons"}],"augmentsTip":"Turtle Primal buff. Composition is flexible as long as you get to the upgraded Juggernaut frontline. Best with Juggernaut emblem on Kennen. Prio Zyra Items since secondary carries can be flexible. Sivir + Ashe is strong, but AP Nidalee or 5 costs like Ivern/Lux/Draven are good. ","tips":[{"stage":"Stage 2","tip":"Open with a strong AP opener, preferably around Blossom. Slam generic AP items and Tank items for a win streak."},{"stage":"Stage 3","tip":"Ideally start holding more juggernauts to pair with the Yorick blossom opener, consider moving karma items to LB or Cassio 2."},{"stage":"Stage 4","tip":"Level and roll for 6 juggernauts +Zyra and a duo-carry. You can push 9 when you hit zyra 2. Tank Vi 2 over Amumu 1."}]},{"id":"ad2av3oyw5nh8ra","title":"Malphite AP Flex","compSlug":"set-18-soraka-flex","tier":"A","set":18,"updated":"2026-09-30 21:31:53.118Z","mainChampion":{"apiName":"DA_18_Malphite"},"mainItem":{"apiName":"DA_18_EmblemExecutioner"},"mainAugment":null,"style":"4-Cost Fast 8","difficulty":"MEDIUM","altBuilds":[{"apiName":"DA_18_Malphite","items":["DA_Artifact_MogulsMail","DA_Artifact_LightshieldCrest","DA_Artifact_TheIndomitable"],"boardIndex":null,"stars":1},{"apiName":"DA_18_Zyra","items":["DA_18_EmblemExecutioner","DA_SpearOfShojin","DA_VoidStaff"],"boardIndex":null,"stars":1}],"carousel":[{"apiName":"DA_GargoyleStoneplate"},{"apiName":"DA_Component_TearOfTheGoddess"},{"apiName":"DA_Component_NeedlesslyLargeRod"},{"apiName":"DA_Component_RecurveBow"}],"earlyComp":[{"apiName":"DA_18_Rakan","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Yorick","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_Karma18","items":["DA_SpearOfShojin","DA_VoidStaff"],"boardIndex":null,"stars":1},{"apiName":"DA_18_Yunara","items":[],"boardIndex":null,"stars":1}],"finalComp":[{"apiName":"DA_18_Yorick","items":[],"boardIndex":20,"stars":1},{"apiName":"DA_18_Azir","items":[],"boardIndex":27,"stars":1},{"apiName":"DA_Fiddlesticks18","items":[],"boardIndex":17,"stars":1},{"apiName":"DA_Amumu18","items":[],"boardIndex":16,"stars":1},{"apiName":"DA_18_Malphite","items":["DA_GargoyleStoneplate","DA_WarmogsArmor","DA_Crownguard"],"boardIndex":3,"stars":1},{"apiName":"DA_18_Soraka","items":["DA_RabadonsDeathcap","DA_AdaptiveHelm","DA_JeweledGauntlet"],"boardIndex":22,"stars":1},{"apiName":"DA_18_Zyra","items":["DA_SpearOfShojin","DA_VoidStaff","DA_ArchangelsStaff"],"boardIndex":21,"stars":1},{"apiName":"DA_18_Kennen","items":[],"boardIndex":23,"stars":1}],"augments":[{"apiName":"DA_BlackthornTraitAugment"},{"apiName":"DA_FlowingTears"},{"apiName":"DA_SoloPlate"},{"apiName":"DA_SmallGrabBag"},{"apiName":"DA_18_BigGrabBag"},{"apiName":"DA_CyberneticUplink_Gold"},{"apiName":"DA_BuriedTreasuresIII"},{"apiName":"DA_CommerceCore"}],"augmentsTip":"Core is Malphite + Azir + 2 Flora Fatalis for healing. Can play Ahri/Zyra/Ezreal as additional carries and Lillia/Amumu/Kennen/Maokai as supporting frontline.","tips":[{"stage":"Stage 2","tip":"Open with a strong AP opener, preferably around Blossom. Slam generic AP items and Malphite items for a win streak."},{"stage":"Stage 3","tip":"Add in useful 3 costs like Fiddlesticks, Cassio, Azir then flex around their traits. General rule: put items on upgraded units."},{"stage":"Stage 4","tip":"Level and roll for Malphite. You will often have to itemize and work with whoever you hit so don't overly tunnel on your roll down."}]},{"id":"y139z4o9dftfbsy","title":"Ahri Morgana","compSlug":"set-18-ahri-morgana","tier":"A","set":18,"updated":"2026-09-30 21:31:53.144Z","mainChampion":{"apiName":"DA_18_Ahri"},"mainItem":null,"mainAugment":null,"style":"4-Cost Fast 8","difficulty":"MEDIUM","altBuilds":[{"apiName":"DA_18_Ahri","items":["DA_18_EmblemInvoker"],"boardIndex":null,"stars":1}],"carousel":[{"apiName":"DA_SpearOfShojin"},{"apiName":"DA_JeweledGauntlet"},{"apiName":"DA_Component_GiantsBelt"},{"apiName":"DA_Component_TearOfTheGoddess"}],"earlyComp":[{"apiName":"DA_18_Rakan","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Yorick","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_Karma18","items":["DA_JeweledGauntlet","DA_SpearOfShojin"],"boardIndex":null,"stars":1},{"apiName":"DA_18_Yunara","items":[],"boardIndex":null,"stars":1}],"finalComp":[{"apiName":"DA_Karma18","items":[],"boardIndex":21,"stars":1},{"apiName":"DA_18_Sentry","items":[],"boardIndex":25,"stars":1},{"apiName":"DA_Krug18","items":[],"boardIndex":16,"stars":1},{"apiName":"DA_18_Sett","items":[],"boardIndex":9,"stars":1},{"apiName":"DA_18_Morgana","items":["DA_VoidStaff","DA_Morellonomicon"],"boardIndex":17,"stars":1},{"apiName":"DA_18_Ahri","items":["DA_JeweledGauntlet","DA_StrikersFlail","DA_SpearOfShojin"],"boardIndex":23,"stars":1},{"apiName":"DA_Sentinel18","items":["DA_DragonsClaw","DA_BrambleVest","DA_WarmogsArmor"],"boardIndex":3,"stars":1},{"apiName":"DA_Taric18","items":[],"boardIndex":10,"stars":1}],"augments":[{"apiName":"DA_JeweledLotus_I"},{"apiName":"DA_JeweledLotus_II"},{"apiName":"DA_GlassCannon_Silver"},{"apiName":"DA_GlassCannon_Gold"},{"apiName":"DA_18_FOURcing"},{"apiName":"DA_Staffsmith"},{"apiName":"DA_CyberneticUplink_Gold"},{"apiName":"DA_WandOverflow"}],"augmentsTip":"Morgana holds utility items. You can tank either Sentinel or Sett. Best emblem = Invoker on Ahri. Late game cap with Ashe + Alune over Karma.","tips":[{"stage":"Stage 2","tip":"Look for 3 Blossom early and play for win streak. Karma can hold items for Ahri. Itemize Yorick or any other 2* tank."},{"stage":"Stage 3","tip":"Flex in more Blossom or Spellweavers as you get them. You can tank all kinds of frontline: Juggernauts, Defenders, or Vanguards."},{"stage":"Stage 4","tip":"Level and roll for Ahri, Morgana, and the frontline. Once stable, go level 9 for Lux."}]},{"id":"9flrvt5murgn9cl","title":"Lunarwood Kha'zix","compSlug":"set-18-lunarwood-khazix","tier":"A","set":18,"updated":"2026-09-30 21:31:53.402Z","mainChampion":{"apiName":"DA_18_KhaZix"},"mainItem":null,"mainAugment":null,"style":"3-Cost Reroll","difficulty":"MEDIUM","altBuilds":[{"apiName":"DA_18_KhaZix","items":["DA_Artifact_LichBane","DA_Artifact_WitsEnd","DA_Artifact_SeekersArmguard"],"boardIndex":null,"stars":1},{"apiName":"DA_18_KhaZix","items":["DA_Artifact_LudensTempest","DA_Artifact_Dawncore","DA_Artifact_ZhonyasParadox"],"boardIndex":null,"stars":1}],"carousel":[{"apiName":"DA_HandOfJustice"},{"apiName":"DA_Component_GiantsBelt"},{"apiName":"DA_Component_TearOfTheGoddess"},{"apiName":"DA_Component_SparringGloves"}],"earlyComp":[{"apiName":"DA_18_Ornn","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Alistar","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_LeBlanc","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_KhaZix","items":["DA_HandOfJustice","DA_IonicSpark"],"boardIndex":null,"stars":1}],"finalComp":[{"apiName":"DA_Elderwood18_Lifeblossom","items":[],"boardIndex":24,"stars":1},{"apiName":"DA_Elderwood18_StonebarkTree","items":[],"boardIndex":27,"stars":1},{"apiName":"DA_18_Ornn","items":[],"boardIndex":16,"stars":1},{"apiName":"DA_Fiddlesticks18","items":[],"boardIndex":17,"stars":1},{"apiName":"DA_18_Diana","items":["DA_JeweledGauntlet","DA_HandOfJustice","DA_IonicSpark"],"boardIndex":8,"stars":3},{"apiName":"DA_18_Hecarim","items":["DA_WarmogsArmor","DA_GargoyleStoneplate","DA_SpiritVisage"],"boardIndex":2,"stars":3},{"apiName":"DA_18_KhaZix","items":["DA_HandOfJustice","DA_HandOfJustice","DA_RabadonsDeathcap"],"boardIndex":1,"stars":3},{"apiName":"DA_18_Soraka","items":[],"boardIndex":23,"stars":1},{"apiName":"DA_18_Ezreal","items":["DA_RedBuff","DA_SpearOfShojin","DA_Deathblade"],"boardIndex":21,"stars":1},{"apiName":"DA_18_Alune","items":[],"boardIndex":22,"stars":1}],"augments":[{"apiName":"DA_ChampDelivery"},{"apiName":"DA_PandorasBench"},{"apiName":"DA_FlowingTears"},{"apiName":"DA_AdvancedLoanPlus"},{"apiName":"DA_HeroicGrabBagPlusPlus"},{"apiName":"DA_LegionOfThrees"},{"apiName":"DA_LuckyGlovesPlus"},{"apiName":"DA_PrismaticTicket"}],"augmentsTip":"Ideally, Khazix gains Ravager > Executioner > Spellweaver > Rapidfire with takedowns. Can play 3rd Executioner/Lux/Ivern or another executioner before Alune. Double Hoj is bis after the buff but can play jg/deathcap instead of one of them too.","tips":[{"stage":"Stage 2","tip":"Only play this comp with an early Kha'zix with items so you can snowball Rival. Play any upgraded frontline tank to stall for Khazix."},{"stage":"Stage 3","tip":"If you have a few crucial pairs on level 6, you can consider rolling slightly on 6 to get charms / upgrade units. Econ up to 7 otherwise."},{"stage":"Stage 4","tip":"Slow roll on 7 for 3* upgrades on whatever 3 costs you're chasing. In this example, give leftover AP items to Diana."}]},{"id":"m85sy8p7quxbwjc","title":"Azir Rammus","compSlug":"set-18-azir-rammus","tier":"A","set":18,"updated":"2026-09-30 21:31:53.591Z","mainChampion":{"apiName":"DA_18_Azir"},"mainItem":null,"mainAugment":null,"style":"3-Cost Reroll","difficulty":"EASY","altBuilds":[{"apiName":"DA_18_Azir","items":["DA_Artifact_NavoriFlickerblade"],"boardIndex":null,"stars":1},{"apiName":"DA_18_Rammus","items":["DA_Artifact_LightshieldCrest"],"boardIndex":null,"stars":1}],"carousel":[{"apiName":"DA_GargoyleStoneplate"},{"apiName":"DA_Component_NeedlesslyLargeRod"},{"apiName":"DA_Component_RecurveBow"},{"apiName":"DA_Component_BFSword"}],"earlyComp":[{"apiName":"DA_Karma18","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Yorick","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Yunara","items":[],"boardIndex":null,"stars":1},{"apiName":"DA_18_Azir","items":[],"boardIndex":null,"star