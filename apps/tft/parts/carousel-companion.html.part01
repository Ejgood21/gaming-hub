ta:image/webp;base64,"},{"apiName":"DA_Artifact_SeekersArmguard","name":"Seeker's Armguard","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_Nidalee18_AP","DA_18_KhaZix","DA_18_Rengar","DA_18_ElderDragon"],"filterType":[],"description":"Takedowns increase the holder’s Armor, Magic Resist, and Ability Power by 20.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_StatikkShiv","name":"Statikk Shiv","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_Nidalee18_AP","DA_18_Kayle","DA_18_MasterYi_AD","DA_18_Ahri"],"filterType":[],"description":"Every 3rd attack deals 15 + 35% of the holder's Ability Power as additional magic damage to 6 enemies.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_WitsEnd","name":"Wit's End","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_18_MasterYi_AD","DA_18_Kennen","DA_18_Tristana","DA_18_Kayle"],"filterType":[],"description":"Attacks deal 0 bonus magic damage.\nHeals the holder for 25% of all magic damage dealt.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_ZhonyasParadox","name":"Zhonya's Paradox","type":"ornns","unique":true,"trait":"","composition":[],"recommendedChampions":["DA_18_KhaZix","DA_18_Diana","DA_18_Kennen"],"filterType":[],"description":"Once per combat at 40% Health, become invulnerable and untargetable for 3 seconds.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_SilvermereDawn","name":"Silvermere Dawn","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["DA_Nidalee18_AP","DA_18_Yunara","DA_18_ElderDragon"],"filterType":[],"description":"Grants immunity to Stuns and the holder's attacks Stun the target for 80% seconds.\n\nThe holder’s Attack Speed is locked at 50%.","icon":"data:image/webp;base64,"},{"apiName":"DA_Artifact_TitanicHydra","name":"Titanic Hydra","type":"ornns","unique":false,"trait":"","composition":[],"recommendedChampions":["