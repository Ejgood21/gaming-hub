<script>
/* Champion build rankings from MetaTFT's public unit statistics.
   Snapshot filters: current patch, ranked, Platinum+, last 3 days, three equipped items.
   Confidence, frequency and tier normalization follow the unit page's model. */
const MetaBuilds = {
  compact(overall, detail) {
    if(!overall||!detail||overall.unit!==detail.unit||overall.tft_set!==detail.tft_set||!Array.isArray(overall.levels)||!Array.isArray(detail.builds)||!Array.isArray(detail.items))throw Error('Unrecognized MetaTFT data');
    const sum=a=>a.reduce((s,n)=>s+n,0), total=p=>sum(p.map((n,i)=>n*(i+1)));
    const levels=overall.levels.filter(r=>Number(r.lvl_items[0])<=4&&Number(r.lvl_items[1])===3);
    const count=sum(levels.map(r=>sum(r.places))), mean=sum(levels.map(r=>total(r.places)))/count;
    const popular=Math.max(...detail.items.map(r=>sum(r.places)));
    if(!count||!popular||!Number.isFinite(mean))throw Error('Empty MetaTFT data');
    const builds=detail.builds.flatMap(r=>{
      if(!Array.isArray(r.places)||r.places.length!==8||r.places.some(n=>!Number.isFinite(n)||n<0)||typeof r.buildNames!=='string')return [];
      const games=sum(r.places),items=r.buildNames.split('|');
      if(!games||games>=count)return [];
      const avg=total(r.places)/games, variance=sum(r.places.map((n,i)=>n*(i+1-avg)**2))/games;
      const confidenceAvg=avg+1.282*Math.sqrt(variance/games);
      const comparison=(mean*count-avg*games)/(count-games);
      const popularity=Math.min(1,Math.sqrt(games/count/.01))*(items.length/3)**2/(r.buildNames.includes('ThiefsGloves')?30:1);
      const score=(.5-(confidenceAvg-comparison))*.7*popularity*(games/popular)**.1;
      return [{items,games,avg,score}];
    }).sort((a,b)=>b.score-a.score);
    const third=builds[Math.min(2,builds.length-1)]?.score;
    const scale=third>0&&third<.35?.35/third:1;
    for(const b of builds){b.score*=scale;b.tier=b.score>=.35?'S':b.score>=.25?'A':b.score>=.15?'B':b.score>=.05?'C':'D';b.score=+b.score.toFixed(5);b.avg=+b.avg.toFixed(3);}
    return {unit:detail.unit,set:detail.tft_set,patch:String(detail.build_games?.[0]?.patch||''),rankFilter:detail.filter_adjustment?.rank_filter||'ALL',updated:Math.min(Number(overall.updated)||0,Number(detail.updated)||0),builds:builds.filter(b=>b.items.length===3&&b.games>=30)};
  },
  champion(name){return Academy.snapshot.champions.find(c=>Academy.normalizeName(c.name)===Academy.normalizeName(name));},
  equipment(plan){return Academy.equipment(plan);},
  fits(build,items){const remaining=[...build];for(const id of items){const at=remaining.indexOf(id);if(at<0)return false;remaining.splice(at,1);}return true;},
  ranked(plan,uid,snapshot,{craftableOnly=false,strongOnly=false}={}){
    const target=plan.queue.find(q=>q.uid===uid&&!q.done),original=target&&byId[target.item];
    const unit=target&&this.champion(target.champion||'');
    if(!original||original.special||original.academyOnly||!unit||snapshot?.unit!==unit.apiName||snapshot.set!=='TFTSet'+Academy.snapshot.set)return [];
    const same=(a,b)=>Academy.normalizeName(a)===Academy.normalizeName(b),holders=this.equipment(plan);
    // Only equipped/completed items are commitments. Pending targets are plans,
    // never fabricated equipment and never a reason to fall back to role tags.
    const equipped=plan.queue.filter(q=>q.done&&same(holders.get(q.uid),target.champion)).map(q=>q.item);
    const planned=plan.queue.filter(q=>!q.done&&q.uid!==uid&&same(q.champion,target.champion)).map(q=>q.item);
    if(equipped.length>=3)return [];
    const count=(list,id)=>list.filter(x=>x===id).length;
    const candidates=DATA.items.filter(i=>!i.academyOnly&&i.id!==original.id&&i.recipe.length===2&&(!craftableOnly||OfflineTracker.canCraft(plan.owned,i)));
    const best=new Map();
    for(const build of snapshot.builds){
      if(strongOnly&&(!['S','A'].includes(build.tier)||build.games<100))continue;
      const mapped=build.items.map(id=>Academy.itemMap.get(id));
      if(mapped.some(id=>!id)||!this.fits(mapped,equipped))continue;
      // A replacement build must actually replace this copy of the target.
      if(count(mapped,original.id)>count([...equipped,...planned],original.id))continue;
      // Do not recommend a route whose strength depends on an unowned artifact,
      // radiant item or other item that cannot be crafted from components.
      if(mapped.some(id=>byId[id].recipe.length!==2&&count(mapped,id)>count(equipped,id)))continue;
      for(const item of candidates){
        if(!this.fits(mapped,[...equipped,item.id]))continue;
        // Don't duplicate a future target unless the ranked build supports it.
        if(count(mapped,item.id)<count([...equipped,...planned],item.id)+1)continue;
        const remaining=[...mapped];for(const id of [...equipped,item.id])remaining.splice(remaining.indexOf(id),1);
        let plannedMatches=0;for(const id of planned){const at=remaining.indexOf(id);if(at>=0){plannedMatches++;remaining.splice(at,1);}}
        const choice={item,source:'meta',tier:build.tier,score:build.score,games:build.games,build:mapped,equipped,plannedMatches,updated:snapshot.updated,rankFilter:snapshot.rankFilter,unit:unit.apiName};
        const prior=best.get(item.id);if(!prior||this.compare(choice,prior)<0)best.set(item.id,choice);
      }
    }
    return [...best.values()].sort((a,b)=>this.compare(a,b));
  },
  compare(a,b){const tier={S:0,A:1,B:2,C:3,D:4};return tier[a.tier]-tier[b.tier]||b.score-a.score||b.plannedMatches-a.plannedMatches||b.games-a.games||a.item.name.localeCompare(b.item.name);},
  suggest(plan,uid,snapshot){
    const target=plan.queue.find(q=>q.uid===uid&&!q.done),original=target&&byId[target.item];
    if(!original||original.special||original.academyOnly||OfflineTracker.canCraft(plan.owned,original))return null;
    if(target.champion){
      // No generic fallback for a named champion, including offline/no-match.
      return this.ranked(plan,uid,snapshot,{craftableOnly:true,strongOnly:true})[0]||null;
    }
    const roles=PivotPlanner.profile(original.id).filter(r=>r!=='flex');
    const candidates=PivotPlanner.suggest(plan,uid,DATA.items,{role:'all'}).filter(r=>!r.item.academyOnly&&OfflineTracker.canCraft(plan.owned,r.item)&&PivotPlanner.profile(r.item.id).some(role=>roles.includes(role)));
    return candidates.length?{item:candidates[0].item,source:'similar'}:null;
  }
};

</script>
<script>
(() => {
  const key='carousel-metatft-v2',cache=new Map(),attempted=new Map(),waiting=[],pending=new Set(),connections=new Map();let active=0;
  const freshness=15*60000;
  const report=()=>document.dispatchEvent(new Event('carousel-meta-updated'));
  const mark=(id,fields)=>connections.set(id,{...(connections.get(id)||{}),...fields});
  for(const entry of META_BUNDLED.units){cache.set(entry.unit,entry);mark(entry.unit,{source:'bundled'});}
  try{const saved=JSON.parse(localStorage.getItem(key)||'[]');if(Array.isArray(saved))for(const entry of saved){if(typeof entry.unit==='string'&&Array.isArray(entry.builds)&&entry.builds.every(b=>Array.isArray(b.items)&&b.items.length===3&&b.items.every(i=>typeof i==='string')&&Number.isFinite(b.score)&&/^[SABCD]$/.test(b.tier))&&(!cache.has(entry.unit)||entry.updated>cache.get(entry.unit).updated)){cache.set(entry.unit,entry);mark(entry.unit,{source:'browser cache'});}}}catch(e){}
  const status=document.createElement('span');status.id='meta-status';status.className='meta-status';document.querySelector('.academy-bar').append(status);
  function dataFor(q){const unit=MetaBuilds.champion(q.champion||'');return unit&&cache.get(unit.apiName);}
  MetaBuilds.dataFor=dataFor;
  MetaBuilds.connection=name=>connections.get(MetaBuilds.champion(name)?.apiName)||{source:'none'};
  MetaBuilds.connections=()=>[...connections.entries()].filter(([id,s])=>s.checked).map(([id,s])=>({unit:id,...s}));
  MetaBuilds.request= name=>{const unit=MetaBuilds.champion(name);if(unit)request(unit);};
  function draw(){
    const dates=[];
    for(const card of document.querySelectorAll('#queue .qcard')){
      card.querySelector('.inline-pivot')?.remove();
      const uid=card.querySelector('[data-action="remove"]')?.dataset.id,q=state.queue.find(q=>q.uid===uid&&!q.done);if(!q)continue;
      const data=dataFor(q);if(data?.set==='TFTSet'+Academy.snapshot.set)dates.push(data.updated);
      const choice=MetaBuilds.suggest(state,uid,data);if(!choice)continue;
      const el=document.createElement('div');el.className='inline-pivot';
      const context=choice.source==='meta'?'<span class="pivot-build-context" aria-label="Ranked build: '+esc(choice.build.map(id=>byId[id].name).join(', '))+'">'+choice.build.map(id=>icon(id)).join('')+'</span>':'';
      const source=choice.source==='meta'?`<a href="https://www.metatft.com/units/${encodeURIComponent(q.champion)}" target="_blank" rel="noopener noreferrer">MetaTFT <b>${choice.tier}</b> build${choice.rankFilter==='ALL'?' · all ranks':''}</a>`:'<span>Similar item</span>';
      el.innerHTML=`<div class="inline-pivot-label">Build instead <span class="pivot-source">${source}${context}</span></div><button class="inline-pivot-build" data-ready-pivot="${esc(choice.item.id)}" data-queue-uid="${esc(uid)}" aria-label="Build ${esc(choice.item.name)} instead of ${esc(byId[q.item].name)}${q.champion?' for '+esc(q.champion):''}">${icon(choice.item.id)}<strong>${esc(choice.item.name)}</strong><span class="inline-pivot-recipe">${choice.item.recipe.map(id=>icon(id)).join('<span>+</span>')}</span><span class="inline-build-label">Build</span></button>`;
      card.append(el);
    }
    const names=[...new Set(state.queue.map(q=>q.champion).filter(Boolean))];
    const info=names.map(n=>MetaBuilds.connection(n)),errors=info.filter(s=>s.error).length;
    const live=info.filter(s=>s.source==='live').length;
    status.innerHTML='<a href="https://www.metatft.com/units" target="_blank" rel="noopener noreferrer">MetaTFT supplement</a> · '+(active?'checking…':!names.length?'awaiting champion':errors?'cached · refresh unavailable':live===names.length?'live stats':live?'live + cached stats':'cached stats');
    status.title='Requests go to api-hc.metatft.com. Data & keys shows last checks and errors. Academy remains the baseline.';
  }

  function request(unit){
    const id=unit.apiName,now=Date.now(),info=connections.get(id)||{};
    if(pending.has(id)||now-(attempted.get(id)||0)<(info.error?5*60000:freshness))return;
    const cached=cache.get(id);
    if(info.source!=='bundled'&&cached?.set==='TFTSet'+Academy.snapshot.set&&now-Number(cached.fetchedAt||0)<freshness)return;
    attempted.set(id,now);mark(id,{checked:now,error:'',phase:'queued'});
    pending.add(id);waiting.push({id,set:Academy.snapshot.set});pump();
  }

  async function pump(){
    if(active>=3||!waiting.length)return;const {id,set}=waiting.shift();active++;mark(id,{phase:'checking'});draw();report();
    const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),15000);
    try{
      const base='https://api-hc.metatft.com/tft-stat-api/unit_detail_';
      const fetchData=async kind=>{const r=await fetch(base+kind+'?unit='+encodeURIComponent(id)+'&queue=1100&patch=current&days=3&rank=CHALLENGER,DIAMOND,EMERALD,GRANDMASTER,MASTER,PLATINUM&permit_filter_adjustment=true'+(kind==='items'?'&num_items=3':''),{credentials:'omit',signal:controller.signal});if(!r.ok)throw Error('HTTP '+r.status);return r.json();};
      const [overall,items]=await Promise.all([fetchData('overall'),fetchData('items')]);
      const data=MetaBuilds.compact(overall,items);if(data.unit!==id||data.set!=='TFTSet'+set||!data.builds.length)throw Error('Stats unavailable for this set');
      data.fetchedAt=Date.now();cache.set(id,data);mark(id,{source:'live',success:Date.now(),error:''});
      try{localStorage.setItem(key,JSON.stringify([...cache.values()].filter(d=>d.set==='TFTSet'+Academy.snapshot.set)));}catch(e){}
    }catch(e){mark(id,{error:e.name==='AbortError'?'Timed out':e.message||'Network / CORS unavailable'});}
    finally{clearTimeout(timer);active--;pending.delete(id);mark(id,{phase:'idle'});draw();document.dispatchEvent(new Event('carousel-meta-updated'));pump();}
  }
  function checkActive(){for(const q of state.queue.filter(q=>q.champion))MetaBuilds.request(q.champion);}
  if(window.addEventListener){window.addEventListener('online',()=>{attempted.clear();checkActive();});window.addEventListener('focus',checkActive);}
  if(typeof setInterval==='function')setInterval(()=>{if(!document.hidden)checkActive();},60000);
  const oldRender=render;render=function(){oldRender();draw();for(const q of state.queue.filter(q=>q.champion)){const unit=MetaBuilds.champion(q.champion);if(unit)request(unit);}};
  document.addEventListener('carousel-new-game',()=>{attempted.clear();for(const task of waiting.splice(0))pending.delete(task.id);});
  document.getElementById('queue').addEventListener('click',e=>{
    const b=e.target.closest('[data-ready-pivot]');if(!b)return;
    const q=state.queue.find(q=>q.uid===b.dataset.queueUid&&!q.done);if(!q)return;
    const choice=MetaBuilds.suggest(state,q.uid,dataFor(q));
    if(!choice||choice.item.id!==b.dataset.readyPivot||!OfflineTracker.canCraft(state.owned,choice.item)){draw();return;}
    const name=byId[q.item].name;
    mutate(()=>{PivotPlanner.replace(state,q.uid,choice.item.id,DATA.items,true);q.received=false;},`${choice.item.name} built instead of ${name}.`);
  });
  document.querySelector('#help ol').insertAdjacentHTML('beforeend','<li><b>Build instead</b> beneath a queued item offers a one-click, craftable pivot. MetaTFT suggestions rank three-item builds around your champion’s equipped items, then show the best craftable pivot. Only S/A builds with at least 100 games qualify. The three small icons show the full build; other unbuilt targets may differ. With no strong match, no pivot is suggested. Generic similarity is only used for items without an assigned champion. Undo restores the original item and ingredients.</li>');
  render();
})();

</script><script>
/* Compact champion reference and source-aware component entry. */
(() => {
  const note=document.createElement('details');note.className='loot-note';
  note.innerHTML='<summary id="loot-summary">Loot-history tie-break</summary><p>Among equally urgent needs, prefer components already dropped more often from natural PvE loot. This is a historical bag heuristic, not verified current-set odds. Pins, queue order, Academy priorities and the number needed come first. It does not predict when another component will drop.</p><p>Bench + and 1–8 record PvE loot. Choose component anvils in Anvil choices; those record Other. “Got one” always records carousel. Anvils, augments, special components and recipe clicks do not count as natural drops. − corrects the source of the last loose copy; crafting keeps the drop history. Undo corrects any recent action.</p><label><input type="checkbox" id="loot-enabled"> Use loot history to break ties</label><div id="loot-counts"></div><p id="loot-coverage"></p></details>';
  document.querySelector('.shoppingfoot').before(note);
  document.querySelector('.shoppingfoot').textContent='Got one = carousel · ★ Pin to put first';
  document.getElementById('loot-enabled').addEventListener('change',e=>mutate(()=>state.lootTieBreak=e.target.checked,'Carousel ordering updated.'));
  const makeDialog=(id,html)=>{const d=document.createElement('dialog');d.id=id;d.innerHTML=html;document.body.append(d);return d;};
  const reference=makeDialog('meta-reference','<div class="modal-heading"><h2 id="reference-title">MetaTFT · S/A item builds</h2><button data-close="meta-reference" aria-label="Close builds">×</button></div><div class="reference-controls"><label>Champion <select id="reference-champion"></select></label><label>Containing item <select id="reference-item"><option value="">Any item</option></select></label></div><div class="reference-options"><label><input type="checkbox" id="reference-equipped" checked> Match completed items</label><button id="reference-pivot">Pivot to an item…</button><button id="reference-site">Open MetaTFT here ↗</button></div><div id="reference-owned" class="reference-owned"></div><div class="reference-hint"><span>Green ✓ = completed on this champion</span><button id="reference-clear">Clear item filter</button></div><details class="reference-data"><summary id="reference-data-summary">Data details</summary><p id="reference-date" class="reference-date"></p></details><div class="reference-table-heading"><span>Build</span><span>Tier</span><span>Avg place</span><span>Games</span></div><div id="reference-results"></div>');
  reference.setAttribute('aria-labelledby','reference-title');
  const site=makeDialog('meta-site','<div class="modal-heading"><h2 id="site-title">MetaTFT</h2><a id="site-external" target="_blank" rel="noopener noreferrer">Open in new tab ↗</a><button data-close="meta-site" aria-label="Close MetaTFT page">×</button></div><p class="frame-note">If the page stays blank or embedding is blocked, use the new-tab link.</p><iframe id="meta-frame" title="MetaTFT champion page" sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox" referrerpolicy="strict-origin-when-cross-origin"></iframe>');
  site.setAttribute('aria-labelledby','site-title');
  const champSelect=document.getElementById('reference-champion'),itemSelect=document.getElementById('reference-item');
  let selected='',itemFilter='',matchEquipped=true,opener=null;
  const champPicker=IconUI.picker(champSelect,'champion','Champion'),itemPicker=IconUI.picker(itemSelect,'item','Containing item');
  function champions(){
    const all=[...new Map(Academy.snapshot.champions.filter(c=>c.name).map(c=>[c.name,c])).values()].sort((a,b)=>a.name.localeCompare(b.name));
    champSelect.innerHTML=all.map(c=>`<option value="${esc(c.name)}">${esc(c.name)}</option>`).join('');
    if(!all.some(c=>c.name===selected))selected=state.queue.find(q=>q.champion)?.champion||all[0]?.name||'';
    champSelect.value=selected;champPicker.refresh();
  }
  function mappedBuilds(data){
    if(data?.set!=='TFTSet'+Academy.snapshot.set)return [];
    const seen=new Set();return data.builds.filter(b=>['S','A'].includes(b.tier)).sort((a,b)=>('SA'.indexOf(a.tier)-'SA'.indexOf(b.tier))||b.score-a.score||b.games-a.games).flatMap(b=>{
      const ids=b.items.map(id=>Academy.itemMap.get(id));if(ids.some(id=>!byId[id]))return [];
      const key=[...ids].sort().join('|');if(seen.has(key))return [];seen.add(key);return [{...b,ids}];
    });
  }
  function drawReference(){
    const data=MetaBuilds.dataFor({champion:selected}),builds=mappedBuilds(data);
    const ids=[...new Set(builds.flatMap(b=>b.ids))].sort((a,b)=>byId[a].name.localeCompare(byId[b].name));
    itemSelect.innerHTML='<option value="">Any item</option>'+ids.map(id=>`<option value="${esc(id)}">${esc(byId[id].name)}</option>`).join('');
    if(itemFilter&&!ids.includes(itemFilter))ids.push(itemFilter);itemSelect.value=itemFilter;itemPicker.refresh();
    const holders=MetaBuilds.equipment(state),equipped=state.queue.filter(q=>q.done&&Academy.normalizeName(holders.get(q.uid)||'')===Academy.normalizeName(selected)).map(q=>q.item);
    const intents=typeof DecisionPlanner!=='undefined'?DecisionPlanner.commitments(state,selected):[];
    const filtered=builds.filter(b=>MetaBuilds.fits(typeof DecisionPlanner!=='undefined'?(DecisionPlanner.subtract(b.ids,equipped)||[]):[],intents)&&(!itemFilter||b.ids.includes(itemFilter))&&(!matchEquipped||(typeof DecisionPlanner!=='undefined'?DecisionPlanner.subtract(b.ids,equipped)!==null:MetaBuilds.fits(b.ids,equipped))));
    document.getElementById('reference-date').textContent=data?.set==='TFTSet'+Academy.snapshot.set?`${filtered.length} builds · ${data.rankFilter==='ALL'?'All ranks':'Platinum+'} · patch ${data.patch||'?'} · snapshot ${new Date(data.updated).toLocaleDateString()} · ranked by MetaTFT score`:'No cached rankings for this champion in the current set. Online refresh requested.';
    const connection=MetaBuilds.connection(selected);document.getElementById('reference-date').textContent+=' · '+connection.source+(connection.error?' · refresh failed: '+connection.error:'');
    document.getElementById('reference-title').innerHTML=IconUI.champion(selected)+'<span>'+esc(selected)+' <small>MetaTFT · S/A builds</small></span>';
    document.getElementById('reference-data-summary').textContent=`${filtered.length} builds · ${connection.source}${connection.error?' · refresh unavailable':''}`;
    document.getElementById('reference-owned').innerHTML=equipped.length?'<span>Equipped</span>'+equipped.map(id=>`<span class="equipped-chip" title="${esc(byId[id].name)}">${icon(id)}<b>✓</b></span>`).join(''):'<span>No completed items assigned to this champion</span>';
    document.getElementById('reference-clear').disabled=!itemFilter;
    document.getElementById('reference-results').innerHTML=filtered.map(b=>{
      const copies=[...equipped];
      const cells=b.ids.map(id=>{const at=copies.findIndex(x=>Academy.itemMatches(id,x)),owned=at>=0;if(owned)copies.splice(at,1);
        return `<button class="build-item ${owned?'equipped':''} ${itemFilter===id?'filter-selected':''}" data-reference-filter="${esc(id)}" title="${esc(byId[id].name)}${owned?' · completed on '+esc(selected):' · not completed on '+esc(selected)} · click to filter" aria-label="${esc(byId[id].name)}${owned?', completed on '+esc(selected):', not completed on '+esc(selected)}. Filter builds containing this item">${icon(id)}${owned?'<b class="equipped-check">✓</b>':''}<span class="build-item-name">${esc(byId[id].name)}</span></button>`;
      }).join('');
      return `<article class="reference-build"><div class="reference-items">${cells}</div><b class="build-tier tier-${b.tier}">${b.tier}</b><span class="build-average">${Number(b.avg).toFixed(2)}</span><span class="build-games">${Number(b.games).toLocaleString()}</span></article>`;
    }).join('')||'<div class="reference-empty">No matching S/A builds.<br>Clear the item filter or turn off “Match completed items”. The live page may have newer data.</div>';
    document.getElementById('reference-site').innerHTML=IconUI.champion(selected)+'<span>MetaTFT page ↗</span>';
  }

  function openReference(name,button){
    opener=button;selected=name||selected;itemFilter='';champPicker.close();itemPicker.close();champions();drawReference();reference.showModal();if(button)button.setAttribute('aria-expanded','true');MetaBuilds.request(selected);
  }
  window.MetaReference={open:openReference,selected:()=>selected,filter(id){itemFilter=id;matchEquipped=true;document.getElementById('reference-equipped').checked=true;drawReference();},refresh:drawReference,openPage(url,title,portrait=''){document.getElementById('site-title').innerHTML=portrait+'<span>'+esc(title)+'</span>';document.getElementById('site-external').href=url;document.getElementById('meta-frame').title=title;document.getElementById('meta-frame').src=url;site.showModal();}};
  document.getElementById('reference-pivot').addEventListener('click',()=>DecisionUI.openPivot(selected));
  document.getElementById('reference-clear').addEventListener('click',()=>{itemFilter='';drawReference();});
  document.addEventListener('click',e=>{const b=e.target.closest('[data-champion-builds]');if(b)openReference(b.dataset.championBuilds,b);});
  champSelect.addEventListener('change',()=>{selected=champSelect.value;itemFilter='';drawReference();MetaBuilds.request(selected);});
  itemSelect.addEventListener('change',()=>{itemFilter=itemSelect.value;drawReference();});
  document.getElementById('reference-equipped').addEventListener('change',e=>{matchEquipped=e.target.checked;drawReference();});
  document.getElementById('reference-results').addEventListener('click',e=>{const b=e.target.closest('[data-reference-filter]');if(b){itemFilter=b.dataset.referenceFilter;drawReference();}});
  document.getElementById('reference-site').addEventListener('click',()=>{
    MetaReference.openPage('https://www.metatft.com/units/'+encodeURIComponent(selected),selected+' · MetaTFT',IconUI.champion(selected));
  });
  site.addEventListener('close',()=>document.getElementById('meta-frame').removeAttribute('src'));
  reference.addEventListener('close',()=>{champPicker.close();itemPicker.close();if(opener){opener.setAttribute('aria-expanded','false');if(opener.isConnected)opener.focus();}});
  document.addEventListener('carousel-meta-updated',()=>{if(reference.open)drawReference();});
  document.addEventListener('carousel-new-game',()=>{reference.close();site.close();document.getElementById('meta-frame').removeAttribute('src');});
  const oldRender=render;render=function(){
    LootTracker.ensure(state);oldRender();
    for(const card of document.querySelectorAll('#queue .qcard')){
      const q=state.queue.find(q=>q.uid===card.dataset.queueUid),owner=card.querySelector('.item-owner');if(!q?.champion||!owner)continue;
      const b=document.createElement('button');b.className='queue-champion';b.dataset.championBuilds=q.champion;b.innerHTML=owner.innerHTML;b.setAttribute('aria-label',q.champion+' S/A builds');b.setAttribute('aria-haspopup','dialog');b.setAttribute('aria-expanded','false');owner.replaceChildren(b);
    }
    const h=state.lootHistory;
    document.getElementById('loot-enabled').checked=state.lootTieBreak!==false;document.getElementById('loot-enabled').disabled=!h.complete;
    document.getElementById('loot-summary').textContent='Loot-history tie-break · '+(!h.complete?'unavailable':state.lootTieBreak===false?'off':'estimate');
    document.getElementById('loot-coverage').textContent=h.complete?'Tracks natural PvE components from the start of this game.':'This game predates source tracking. Start a new game for a complete history; current inventory is preserved.';
    document.getElementById('loot-counts').innerHTML='<span>Natural drops</span>'+componentOrder.slice(0,8).map(id=>`<span title="${esc(byId[id].name)}" aria-label="${esc(byId[id].name)}: ${h.counts[id]||0} natural drops">${icon(id)} ×${h.counts[id]||0}</span>`).join('');
    for(const el of document.querySelectorAll('#shopping .need')){const id=el.querySelector('[data-action="gain"]')?.dataset.id;if(!id)continue;el.querySelector('[data-action="gain"]').setAttribute('aria-label','Got one '+byId[id].name+' from carousel');if(h.complete&&state.lootTieBreak!==false&&(h.counts[id]||0)>0)el.querySelector('.needname').insertAdjacentHTML('beforeend',`<small class="loot-history-label">${h.counts[id]} prior PvE drop${h.counts[id]===1?'':'s'} · tie-break only</small>`);}
    if(reference.open)drawReference();
  };
  render();
})();

</script><script>
/* Academy defines the plan. MetaTFT can propose an explicit, reversible
   adjustment around items the player has actually equipped. */
const PlanAdvisor = {
  same(a,b){return Academy.normalizeName(a)===Academy.normalizeName(b);},
  equipped(plan,name){const holders=Academy.equipment(plan);return plan.queue.filter(q=>q.done&&this.same(holders.get(q.uid)||'',name));},
  remaining(build,equipped){const out=[...build];for(const id of equipped){const at=out.indexOf(id);if(at<0)return null;out.splice(at,1);}return out;},
  suggest(plan,name,data){
    const unit=MetaBuilds.champion(name),guide=Academy.guide(plan);
    if(!unit||!guide)return null;
    const equipped=this.equipped(plan,name).map(q=>q.item);
    const targets=plan.queue.filter(q=>!q.done&&this.same(q.champion||'',name));
    if(!equipped.length||!targets.length)return null;
    if(equipped.length>=3)return {champion:name,equipped,remaining:[],kind:'full'};
    if(data?.unit!==unit.apiName||data.set!=='TFTSet'+Academy.snapshot.set)return null;
    const baseline=Academy.build(guide).entries.filter(q=>this.same(q.champion,name)).map(q=>q.item);
    // Leave Academy's plan alone while the actual equipment still follows it.
    if(MetaBuilds.fits(baseline,equipped))return null;
    const options=[];
    for(const b of data.builds){
      if(!['S','A'].includes(b.tier)||b.games<100)continue;
      const ids=b.items.map(id=>Academy.itemMap.get(id));if(ids.some(id=>!byId[id]))continue;
      const rest=this.remaining(ids,equipped);if(!rest||rest.some(id=>byId[id].recipe.length!==2))continue;
      const pool={...plan.owned};let missing=0;
      for(const id of rest)for(const c of byId[id].recipe){if(pool[c]>0)pool[c]--;else missing++;}
      const retained=rest.filter(id=>targets.some(q=>q.item===id)).length;
      options.push({champion:name,items:ids,remaining:rest,equipped,tier:b.tier,score:b.score,games:b.games,missing,retained,updated:data.updated});
    }
    options.sort((a,b)=>'SA'.indexOf(a.tier)-'SA'.indexOf(b.tier)||b.score-a.score||a.missing-b.missing||b.retained-a.retained||b.games-a.games);
    const best=options[0];
    if(!best||MetaBuilds.fits(best.remaining,targets.map(q=>q.item))&&best.remaining.length===targets.length)return null;
    return best;
  },
  apply(plan,choice){
    const pending=plan.queue.filter(q=>!q.done&&this.same(q.champion||'',choice.champion));
    if(!pending.length)return false;
    const pool=[...pending];
    const replacements=choice.remaining.map(id=>{
      const at=pool.findIndex(q=>q.item===id),q=at>=0?pool.splice(at,1)[0]:null;
      return q?{...q,planSource:'meta'}:{uid:crypto.randomUUID(),item:id,champion:choice.champion,done:false,used:{},planSource:'meta',sourceComp:plan.activeComp?.title||''};
    });
    QueueOrder.inherit(plan,pending,replacements);
    const old=new Set(pending.map(q=>q.uid)),last=pending[pending.length-1].uid;
    plan.queue=plan.queue.flatMap(q=>{if(!old.has(q.uid))return [q];if(q.uid===last)return replacements.splice(0);return replacements.length?[replacements.shift()]:[];});
    return true;
  },
  restoreAcademy(plan){
    const guide=Academy.guide(plan);if(!guide)return;
    QuickImport.replace(plan,{guide,entries:Academy.build(guide).entries,priorities:Academy.priorities(guide)},plan.activeComp.code);
  }
};

</script><script>
(() => {
  const center=document.querySelector('.centercol'),queueColumn=document.createElement('div');queueColumn.className='plan-queue';
  while(center.firstChild)queueColumn.append(center.firstChild);center.append(queueColumn);
  const overview=document.createElement('aside');overview.className='plan-overview';overview.setAttribute('aria-label','Academy build progress and advice');center.append(overview);
  overview.innerHTML='<section class="board-panel panel"><div class="board-heading"><button id="board-source" class="quiet">Academy original ↗</button></div><div id="position-board"></div><div class="board-legend"><span>○ Planned</span><span>◐ Components ready</span><span>✓ Completed</span><span>↔ Adjusted plan</span></div><div id="board-extras"></div></section><section class="tips-panel panel"><div class="tips-heading"><h2>Academy tips</h2></div><div id="academy-tips"></div></section>';
  const origin=document.createElement('div');origin.className='academy-order';origin.innerHTML='<button id="restore-academy" class="quiet">Reset targets to Academy</button>';overview.prepend(origin);origin.prepend(document.getElementById('academy-priority'));
  document.getElementById('restore-academy').addEventListener('click',()=>mutate(()=>PlanAdvisor.restoreAcademy(state),'Academy targets restored. Inventory kept.'));
  const diagnostics=document.createElement('details');diagnostics.className='data-diagnostics';diagnostics.innerHTML='<summary>MetaTFT connection details</summary><p>Embedded JSON → browser cache → live API. Refresh checks run for assigned champions on launch, focus, and while this tab is visible. Successful data stays fresh for 15 minutes; failed requests wait 5 minutes before retrying.</p><p>Host: <code>api-hc.metatft.com</code><br>Endpoints: <code>unit_detail_overall</code> and <code>unit_detail_items</code>. Filters: ranked, Platinum+, current patch, last 3 days, three-item builds. No API key.</p><div id="meta-diagnostics"></div>';
  document.getElementById('settings-dialog').append(diagnostics);
  if(state.activeComp&&!state.activeComp.guide){const g=Academy.guide(state);if(g){state.activeComp.guide=Academy.cleanGuide(g);save();}}
  let assignmentUid='';
  const assign=document.createElement('dialog');assign.id='assign-holder';assign.innerHTML='<div class="modal-heading"><h2 id="holder-title">Item holder</h2><button data-close="assign-holder" aria-label="Close holder chooser">×</button></div><p>Assign this completed item so the board and suggestions use it.</p><label>Champion <select id="holder-select"></select></label><button id="holder-save">Assign item</button>';document.body.append(assign);
  assign.setAttribute('aria-labelledby','holder-title');
  const holderPicker=IconUI.picker(document.getElementById('holder-select'),'champion','Item holder');
  function champNames(){return [...new Set([...(Academy.guide(state)?.finalComp||[]).map(c=>Academy.snapshot.champions.find(u=>u.apiName===c.apiName)?.name),...state.queue.map(q=>q.champion)].filter(Boolean))];}
  function openHolder(uid){const q=state.queue.find(q=>q.uid===uid&&q.done);if(!q)return;assignmentUid=uid;document.getElementById('holder-title').innerHTML=IconUI.itemLabel(q.item)+'<span> · holder</span>';const s=document.getElementById('holder-select');s.innerHTML='<option value="">Unassigned</option>'+champNames().map(n=>`<option value="${esc(n)}">${esc(n)}</option>`).join('');s.value=Academy.equipment(state).get(uid)||'';holderPicker.refresh();holderPicker.close();assign.showModal();}
  document.getElementById('holder-save').addEventListener('click',()=>{const q=state.queue.find(q=>q.uid===assignmentUid&&q.done);if(q)mutate(()=>{q.champion=document.getElementById('holder-select').value;},'Item holder updated.');assign.close();});
  document.addEventListener('click',e=>{const b=e.target.closest('[data-assign-holder]');if(b)openHolder(b.dataset.assignHolder);});
  const champIcon=(unit)=>{const c=Academy.snapshot.champions.find(c=>c.apiName===unit.apiName),embedded=ACADEMY_BUNDLED.champions.find(c=>c.apiName===unit.apiName)?.icon;return {cost:c?.cost||1,name:c?.name||unit.apiName.replace(/^DA_/,''),src:embedded?.startsWith('data:')?embedded:c?.icon||'https://assets.tftacademy.com/champions/champion_icons/'+encodeURIComponent(unit.apiName)+'.webp'};};
  function renderBoard(){
    const guide=Academy.guide(state);overview.hidden=!guide;origin.hidden=!guide;if(!guide)return;
    document.getElementById('board-source').setAttribute('aria-label','View original '+guide.title+' guide inside the app');
    const holders=Academy.equipment(state),allocated=Tracker.allocate(state,DATA.items),rows=new Map(allocated.rows.map(q=>[q.uid,q]));
    const names=new Set(guide.finalComp.map(c=>champIcon(c).name));
    const plan=state.queue.filter(q=>names.has(q.done?holders.get(q.uid):q.champion));
    const cell=(u)=>{
      if(!u)return '<div class="board-cell empty-cell" aria-hidden="true"><span></span></div>';
      const c=champIcon(u),items=plan.filter(q=>(q.done?holders.get(q.uid):q.champion)===c.name);
      const baseline=u.items.map(id=>Academy.itemMap.get(id));const actual=items.map(q=>q.item);
      const adjusted=baseline.length!==actual.length||!MetaBuilds.fits(baseline,actual);
      const color=['','#a5a5a5','#19bc69','#158ee8','#a046d0','#eacb4e'][Math.min(5,c.cost)]||'#a5a5a5';
      return `<div class="board-cell unit-cell" style="--unit-color:${color}" aria-label="${esc(c.name)}, Academy target ${u.stars||1} star${u.stars===1?'':'s'}"><button class="board-champion" data-champion-builds="${esc(c.name)}" aria-label="Open ${esc(c.name)} S/A item builds" aria-haspopup="dialog" aria-expanded="false" title="${esc(c.name)} · S/A item builds"><span class="champion-hex"><img class="champion-portrait" src="${esc(c.src)}" alt="" width="64" height="64"></span><span class="board-stars">${u.stars>1?'★'.repeat(u.stars):''}</span><span class="board-name">${esc(c.name)}</span></button><div class="board-items">${items.map(q=>{
        const r=rows.get(q.uid),ready=!q.done&&r?.slots.length===2&&r.slots.every(s=>s.have),label=q.done?'Completed':ready?'Components ready':'Planned';
        return `<button class="board-item ${q.done?'is-done':ready?'is-ready':'is-planned'}" ${q.done?`data-assign-holder="${q.uid}"`:`data-board-target="${q.uid}"`} title="${esc(byId[q.item].name)} · ${label}${q.done?' · click to change holder':' · click to pivot'}" aria-label="${esc(c.name)}: ${esc(byId[q.item].name)}, ${label}">${icon(q.item)}<b>${q.done?'✓':ready?'◐':''}</b></button>`;
      }).join('')}</div>${adjusted?'<span class="board-adjusted" title="Your item plan differs from Academy">↔</span>':''}</div>`;
    };
    const occupied=new Map(),unplaced=[];for(const u of guide.finalComp){if(Number.isInteger(u.boardIndex)&&u.boardIndex>=0&&u.boardIndex<28&&!occupied.has(u.boardIndex))occupied.set(u.boardIndex,u);else unplaced.push(u);}
    document.getElementById('position-board').innerHTML=Array.from({length:4},(_,r)=>`<div class="hex-row">${Array.from({length:7},(_,c)=>cell(occupied.get(r*7+c))).join('')}</div>`).join('')+(unplaced.length?'<div class="unplaced-units"><small>Position not supplied by Academy</small>'+unplaced.map(cell).join('')+'</div>':'');
    const extras=state.queue.filter(q=>q.done&&!names.has(holders.get(q.uid)));
    document.getElementById('board-extras').innerHTML=extras.length?'<span>Assign completed items</span>'+extras.map(q=>`<button data-assign-holder="${q.uid}" title="Assign ${esc(byId[q.item].name)} to a champion">${icon(q.item)}<span>${q.champion?IconUI.championLabel(q.champion):'Choose holder'}</span></button>`).join(''):'';
    const tips=[{stage:'Build',tip:guide.augmentsTip||''},...[2,3,4].map(n=>({stage:'Stage '+n,tip:(guide.tips||[]).find(t=>String(t.stage).match(/\d+/)?.[0]===String(n))?.tip||''}))];
    document.getElementById('academy-tips').innerHTML=tips.map(t=>`<section class="academy-tip"><h3>${esc(t.stage)}</h3><p>${esc(t.tip||'No tip provided.')}</p></section>`).join('');
  }

  function drawConnections(){
    document.getElementById('meta-diagnostics').innerHTML=MetaBuilds.connections().map(s=>`<p><b>${IconUI.championLabel(Academy.snapshot.champions.find(c=>c.apiName===s.unit)?.name||s.unit)}</b> · ${esc(s.source||'no data')} · checked ${new Date(s.checked).toLocaleTimeString()}${s.error?`<br><span class="connection-error">${esc(s.error)} — using saved stats when available</span>`:''}</p>`).join('')||'<p>No requests yet. Import a comp or choose a champion in S/A item builds.</p>';
  }
  overview.addEventListener('click',e=>{
    if(e.target.closest('#board-source')){const guide=Academy.guide(state);if(guide)MetaReference.openPage('https://tftacademy.com/tierlist/comps/'+encodeURIComponent(guide.compSlug),guide.title+' · TFT Academy');}
    const target=e.target.closest('[data-board-target]');if(target)PivotDialog.open(target.dataset.boardTarget);
  });
  const oldRender=render;render=function(){oldRender();renderBoard();drawConnections();
    for(const tile of document.querySelectorAll('#completed .completeitem')){const uid=tile.querySelector('[data-action="restore"]')?.dataset.id,img=tile.querySelector('img');if(!uid||!img)continue;const button=document.createElement('button');button.className='completed-holder';button.dataset.assignHolder=uid;const q=state.queue.find(q=>q.uid===uid);button.setAttribute('aria-label',`Assign ${byId[q.item].name}; holder: ${Academy.equipment(state).get(uid)||'unassigned'}`);img.before(button);button.append(img);}
  };
  document.addEventListener('carousel-meta-updated',()=>{renderBoard();drawConnections();});
  document.querySelector('#help ol').insertAdjacentHTML('beforeend','<li><b>Academy is the baseline.</b> The board uses its positioning and target stars; item slots reflect your tracked plan. Dim items are planned, amber items have reserved components, and checked items are completed. Click a planned board item to choose a pivot.</li><li><b>Assign completed items</b> with the holder selector when receiving an item, or by clicking its completed icon. MetaTFT can then propose a compatible S/A combination for the remaining slots. Use the champion’s S/A builds dialog to pivot remaining targets; inventory stays intact. Undo reverses the change. Reset targets to Academy restores the baseline around existing inventory.</li>');
  render();
})();

</script><script>
/* Personal fit is a transparent heuristic, not a performance tier or win rate.
   Academy owns the comp tier, item order and recommended augment lists. */
const CompFinder = {
  heldAugments(plan){return [...new Set([plan.firstAugment||plan.chosenAugments?.[0],...(plan.chosenAugments||[]).slice(1,3)].filter(Boolean))];},
  augments(){return (Academy.snapshot.augments||[]).filter(a=>!a.stages?.length||a.stages.includes('2-1')).sort((a,b)=>a.name.localeCompare(b.name));},
  augment(id){return (Academy.snapshot.augments||[]).find(a=>a.apiName===id);},
  augmentIcon(id){
    const src=ACADEMY_BUNDLED.augments?.find(a=>a.apiName===id)?.icon||'https://assets.tftacademy.com/augments/'+encodeURIComponent(id)+'.webp';
    return `<img class="augment-icon" src="${esc(src)}" alt="" width="28" height="28" loading="lazy">`;
  },
  units(plan){
    const byUnit=new Map();for(const u of plan.currentUnits||[]){const c=Academy.snapshot.champions.find(c=>c.apiName===u.apiName);if(!c)continue;const stars=Math.max(1,Math.min(3,Number(u.stars)||1));if(stars>(byUnit.get(u.apiName)?.stars||0))byUnit.set(u.apiName,{...c,stars});}return [...byUnit.values()];
  },
  champions(){return Academy.snapshot.champions.filter(c=>c.cost>0&&c.traits.length).sort((a,b)=>a.cost-b.cost||a.name.localeCompare(b.name));},
  addUnit(plan,apiName){if(!this.champions().some(c=>c.apiName===apiName))return;plan.currentUnits||=[];if(!plan.currentUnits.some(u=>u.apiName===apiName)&&plan.currentUnits.length<28)plan.currentUnits.push({apiName,stars:1});},
  boardFit(plan,guide){
    const units=this.units(plan),keepers=[],early=[],bridges=[];let unitScore=0,earlyScore=0,traitScore=0;
    const finalTraits=new Set(guide.finalComp.flatMap(u=>Academy.snapshot.champions.find(c=>c.apiName===u.apiName)?.traits||[]));
    for(const unit of units){
      const target=guide.finalComp.find(u=>u.apiName===unit.apiName);
      if(target){
        const core=target.apiName===guide.mainChampion?.apiName||target.items.length>=2;
        const points=[0,2,7,15][unit.stars]*(core?1.5:1)+(core&&target.stars===3&&unit.stars===3?8:0);
        unitScore+=points;keepers.push({...unit,targetStars:target.stars||1,core});
      }else if((guide.earlyComp||[]).some(u=>u.apiName===unit.apiName)){
        earlyScore+=[0,.5,2,4][unit.stars];early.push(unit);
      }else if(unit.traits.filter(t=>finalTraits.has(t)).length>=2){
        traitScore+=unit.stars===1?.5:1;bridges.push(unit);
      }
    }
    return {keepers,early,bridges,unitScore:Math.min(44,unitScore)+Math.min(8,earlyScore)+Math.min(3,traitScore)};
  },
  ownedCatalog(){return DATA.items.map(i=>({...Academy.itemInfo(i.id),id:i.id,name:i.name,type:Academy.itemInfo(i.id)?.type||'others'})).sort((a,b)=>a.name.localeCompare(b.name));},
  slotCost(id){return Academy.baseItem(id)==='ThiefsGloves'?3:1;},
  specialCarrier(plan,guide,item,slots,placements=[]){
    const info=Academy.itemInfo(item);if(!info)return null;
    const unitStars=new Map(this.units(plan).map(u=>[u.apiName,u.stars]));
    const choices=guide.finalComp.flatMap(unit=>{
      const champ=Academy.snapshot.champions.find(c=>c.apiName===unit.apiName);
      if(!champ||(slots.get(champ.name)||0)+this.slotCost(item)>3)return [];
      if(info.unique&&placements.some(p=>p.champion===champ.name&&p.item===item))return [];
      if(info.type==='emblems'&&info.trait&&(champ.traitKeys||[]).includes(info.trait))return [];
      const alternate=(guide.altBuilds||[]).some(a=>a.apiName===unit.apiName&&a.items.some(id=>Academy.itemMatches(Academy.itemMap.get(id),item)));
      let source=alternate?'Academy alternate':(info.recommendedChampions||[]).includes(unit.apiName)?'Academy item guide':'';
      if(!source){
        const data=MetaBuilds.dataFor({champion:champ.name}),owned=plan.queue.filter(q=>q.done).map(q=>q.item);
        if(data?.unit===unit.apiName&&data.set==='TFTSet'+Academy.snapshot.set&&data.builds.some(b=>{
          if(!['S','A'].includes(b.tier)||b.games<100||!b.items.includes(info.apiName))return false;
          const ids=b.items.map(id=>Academy.itemMap.get(id));if(ids.some(id=>!byId[id]))return false;
          const placed=placements.filter(p=>p.champion===champ.name).map(p=>p.item);
          return MetaBuilds.fits(ids,[...placed,item])&&MetaBuilds.fits(owned,ids.filter(id=>byId[id].recipe.length!==2));
        }))source='MetaTFT S/A item build';
      }
      if(!source)return [];
      const core=unit.apiName===guide.mainChampion?.apiName||unit.items.length>=2;
      const special=['radiants','ornns','emblems'].includes(info.type);
      const points=alternate?(info.type==='emblems'?32:special?28:18):special?(core?22:12):(core?8:5);
      return [{champion:champ.name,apiName:unit.apiName,source,points:points+(unitStars.get(unit.apiName)||0),alternate}];
    }).sort((a,b)=>b.points-a.points||a.champion.localeCompare(b.champion));
    return choices[0]||null;
  },
  requirements(plan,guide){
    const bank=plan.queue.filter(q=>q.done).map(q=>q.item),pool={...plan.owned},missing=[],craftable=[];
    const groups=guide.finalComp.flatMap(u=>u.items.flatMap(api=>{
      const item=Academy.itemMap.get(api);if(Academy.itemInfo(item)?.type!=='emblems')return [];
      const alternatives=[item,...(guide.altBuilds||[]).filter(a=>a.apiName===u.apiName).flatMap(a=>a.items.map(api=>Academy.itemMap.get(api))).filter(id=>Academy.itemInfo(id)?.type==='emblems')];
      return [{item,alternatives:[...new Set(alternatives)]}];
    }));
    for(const group of groups){
      const at=bank.findIndex(id=>group.alternatives.includes(id));if(at>=0){bank.splice(at,1);continue;}
      const can=group.alternatives.find(id=>byId[id]?.recipe.length===2&&OfflineTracker.canCraft(pool,byId[id]));
      if(can){for(const c of byId[can].recipe)pool[c]--;craftable.push(can);}else missing.push(group.item);
    }
    const augment=guide.tier==='X'&&guide.mainAugment?.apiName&&!this.heldAugments(plan).includes(guide.mainAugment.apiName)?guide.mainAugment.apiName:'';
    // Do not turn a featured item into a hard requirement: Academy also uses
    // featured items for optional upgrades. Explicit "only play" notes matter.
    const needsEmblem=/only play[^.!?]*emblem/i.test(guide.augmentsTip||'');
    return {missingEmblems:missing,craftableEmblems:craftable,missingAugment:augment,blocked:!!augment||(needsEmblem&&missing.length>0),requirementPenalty:Math.min(60,missing.length*24)+(augment?40:0)};
  },
  execution(plan,guide){
    const owned=new Map(this.units(plan).map(u=>[u.apiName,u.stars]));
    const core=guide.finalComp.filter(u=>u.apiName===guide.mainChampion?.apiName||u.items.length>=2).sort((a,b)=>Number(b.apiName===guide.mainChampion?.apiName)-Number(a.apiName===guide.mainChampion?.apiName)).slice(0,3);
    const missingCore=[];let executionPenalty=0;
    for(const target of core){
      const c=Academy.snapshot.champions.find(c=>c.apiName===target.apiName);if(!c)continue;
      const stars=owned.get(c.apiName)||0,targetStars=target.stars||1;
      if(stars>=targetStars)continue;
      missingCore.push({...c,stars,targetStars});
      executionPenalty+=stars===0?(c.cost>=5?8:c.cost===4?5:targetStars===3?4:1):targetStars===3?(stars===2?1.5:3):1;
    }
    // Sparse item entry does not establish that the whole future board is missing.
    const boardCoverage=Math.min(1,owned.size/4);
    return {missingCore,executionPenalty:Math.min(18,executionPenalty)*boardCoverage};
  },
  evaluate(plan,guide){
    const build=Academy.build(guide),remaining=build.entries.map((e,n)=>({...e,priority:n}));
    const matched=[],unmatched=[],specialMatches=[],unknownSpecial=[],placements=[],slots=new Map(),earlyMatches=[];let itemScore=0;
    const completed=plan.queue.filter(q=>q.done),unplaced=[];
    for(const q of completed){
      const info=Academy.itemInfo(q.item),at=remaining.findIndex(e=>Academy.itemMatches(e.item,q.item)&&(slots.get(e.champion)||0)+this.slotCost(q.item)<=3&&(!info?.unique||!placements.some(p=>p.champion===e.champion&&p.item===q.item)));
      if(at<0){unplaced.push(q);continue;}
      const e=remaining.splice(at,1)[0];matched.push(q.item);
      const points=info?.type==='emblems'?40:e.priority<3?24:18;itemScore+=points;
      placements.push({uid:q.uid,champion:e.champion,item:q.item});slots.set(e.champion,(slots.get(e.champion)||0)+this.slotCost(q.item));
      if(q.item!==e.item){itemScore+=6;specialMatches.push({item:q.item,champion:e.champion,source:'Radiant upgrade',base:e.item});}
    }
    const earlyPool=(guide.earlyComp||[]).flatMap(u=>u.items.map(api=>({item:Academy.itemMap.get(api),apiName:u.apiName})));
    for(const q of unplaced){
      const info=Academy.itemInfo(q.item),carrier=this.specialCarrier(plan,guide,q.item,slots,placements);
      if(carrier){
        itemScore+=carrier.points;slots.set(carrier.champion,(slots.get(carrier.champion)||0)+this.slotCost(q.item));placements.push({uid:q.uid,champion:carrier.champion,item:q.item});specialMatches.push({item:q.item,...carrier});
        // Keep the fit estimate within three item slots. An alternate occupies
        // a lower-priority slot; it is not a fourth item on top of the baseline.
        for(let n=0;n<this.slotCost(q.item);n++){const at=remaining.map(e=>e.champion).lastIndexOf(carrier.champion);if(at>=0)remaining.splice(at,1);}
        continue;
      }
      const at=earlyPool.findIndex(e=>Academy.itemMatches(e.item,q.item)&&!guide.finalComp.some(u=>u.apiName===e.apiName));
      if(at>=0){const e=earlyPool.splice(at,1)[0],champion=Academy.snapshot.champions.find(c=>c.apiName===e.apiName)?.name;earlyMatches.push({item:q.item,champion});itemScore+=10;continue;}
      if(!info||info.type==='craftables')unmatched.push(q.item);else unknownSpecial.push(q.item);
    }
    const featured=Academy.itemMap.get(guide.mainItem?.apiName),featuredOwned=featured&&completed.some(q=>Academy.itemMatches(featured,q.item));
    // This is a comp-specific Academy endorsement, not a generic trait guess.
    if(featuredOwned)itemScore+=12;
    // Carry an evidenced full combination into both scoring and selection.
    if(typeof DecisionPlanner!=='undefined')for(const name of new Set(placements.map(p=>p.champion))){
      const equipped=placements.filter(p=>p.champion===name).map(p=>p.item),targets=remaining.filter(e=>e.champion===name);
      const base=build.entries.filter(e=>e.champion===name).map(e=>e.item);
      if(DecisionPlanner.subtract(base,equipped)!==null)continue;
      const virtual={...plan,activeComp:{id:guide.id,guide},queue:[...placements.filter(p=>p.champion===name).map(p=>({...p,done:true})),...targets.map(e=>({...e,done:false}))]};
      const choice=DecisionPlanner.builds(virtual,name)[0];if(!choice)continue;
      const at=remaining.findIndex(e=>e.champion===name),rest=remaining.filter(e=>e.champion!==name);
      rest.splice(at<0?rest.length:at,0,...choice.remaining.map(item=>({item,champion:name,planSource:'meta',sourceComp:guide.title})));
      remaining.splice(0,remaining.length,...rest);
    }
    const componentFit=this.componentFit(plan,remaining),{used,ready}=componentFit,componentScore=componentFit.score;
    const matchedAugments=this.heldAugments(plan).filter(id=>(guide.augments||[]).some(a=>a.apiName===id)||guide.mainAugment?.apiName===id),augmentMatch=matchedAugments.length>0;
    const tierScore=({S:12,A:10,B:8,C:6,D:4,X:8})[guide.tier]??0,board=this.boardFit(plan,guide),requirements=this.requirements(plan,guide),execution=this.execution(plan,guide);
    const fitScore=Math.min(96,itemScore)+Math.min(36,componentScore)+Math.min(36,matchedAugments.length*24)+board.unitScore-Math.min(18,unmatched.length*6)-requirements.requirementPenalty-execution.executionPenalty;
    return {guide,build,remaining,placements,matched,unmatched,used,ready,augmentMatch,matchedAugments,specialMatches,unknownSpecial,earlyMatches,featuredOwned:featuredOwned?featured:null,...board,...requirements,...execution,
      score:tierScore+fitScore,fitScore,tierScore,componentScore,itemScore,selectable:!!build.entries.length&&!build.missing.length};
  },
  tierRank(tier){return ({S:0,A:1,B:2,C:3,D:4,X:2})[tier]??5;},
  strongFit(row){
    const finalItems=row.placements.length,upgradedCore=row.keepers.filter(u=>u.core&&u.stars>=2),upgraded=row.keepers.filter(u=>u.stars>=2);
    // One generic component, emblem, augment or 1-star unit cannot trigger a
    // cross-tier promotion. Require substantial, positively matched resources.
    const substantial=finalItems>=2||(finalItems>=1&&upgradedCore.length>=1)||upgradedCore.some(u=>u.stars===3)||upgraded.length>=3;
    return substantial&&row.fitScore>=60&&!row.blocked&&!row.missingEmblems.length&&!row.missingAugment;
  },
  ranked(plan){
    const rows=Academy.snapshot.guides.map(g=>this.evaluate(plan,g)).filter(r=>r.selectable);
    for(const r of rows){r.baseTierRank=this.tierRank(r.guide.tier);r.recommendationTierRank=r.baseTierRank;r.strongFit=this.strongFit(r);}
    for(const r of rows){
      if(!r.strongFit)continue;
      // Stable bands avoid a pairwise comparator that can contradict itself.
      // Beat the strongest original-tier candidate by 30 fit points per tier
      // skipped, in addition to meeting the absolute strong-fit requirement.
      for(let target=r.baseTierRank-1;target>=0;target--){
        const better=rows.filter(other=>!other.blocked&&other.baseTierRank===target);
        if(better.length&&r.fitScore<Math.max(...better.map(other=>other.fitScore))+30*(r.baseTierRank-target))break;
        r.recommendationTierRank=target;
      }
    }
    return rows.sort((a,b)=>Number(a.blocked)-Number(b.blocked)||a.recommendationTierRank-b.recommendationTierRank||b.fitScore-a.fitScore||a.baseTierRank-b.baseTierRank||a.guide.title.localeCompare(b.guide.title));
  },
  componentFit(plan,entries){
    let beam=[{pool:{...plan.owned},score:0,used:[],ready:[]}];
    for(const [n,e] of entries.entries()){
      const recipe=byId[e.item]?.recipe||[];if(recipe.length!==2)continue;
      const next=[];for(const s of beam)for(let mask=0;mask<4;mask++){
        const pool={...s.pool},used=[],weight=Math.max(1,4-n*.5);let valid=true;
        for(let k=0;k<2;k++)if(mask&(1<<k)){const c=recipe[k];if(!(pool[c]>0)){valid=false;break;}pool[c]--;used.push(c);}
        if(valid)next.push({pool,score:s.score+weight*used.length+(used.length===2?2:0),used:[...s.used,...used],ready:used.length===2?[...s.ready,e.item]:s.ready});
      }
      const seen=new Set();beam=next.sort((a,b)=>b.score-a.score||b.used.length-a.used.length||b.ready.length-a.ready.length).filter(s=>{const key=componentOrder.map(c=>s.pool[c]||0).join(',');if(seen.has(key))return false;seen.add(key);return true;}).slice(0,40);
    }return beam[0];
  },
  choose(plan,id){
    const guide=Academy.snapshot.guides.find(g=>g.id===id);if(!guide)throw new Error('This comp is no longer available.');
    const fit=this.evaluate(plan,guide);if(!fit.selectable)throw new Error('This guide’s items are not available yet.');
    // Preserve every physical item, and import the remaining variant scored in
    // discovery. Empty holder fields adopt the suggested destination.
    for(const p of fit.placements){const q=plan.queue.find(q=>q.uid===p.uid);if(q&&!q.champion)q.champion=p.champion;}
    const completed=plan.queue.filter(q=>q.done);
    plan.queue=[...completed,...fit.remaining.map((e,n)=>({...e,uid:crypto.randomUUID(),recommendedOrder:n,done:false,used:{},usedSources:{},academyItem:e.item,planSource:e.planSource||'academy'}))];
    plan.pivotIntents={};plan.activeComp={guide:Academy.cleanGuide(guide),id:guide.id,title:guide.title,code:'',itemPriority:Academy.priorities(guide)};
    return {pending:fit.remaining.length,covered:fit.placements.length};
  }
};

/* Native dialog backdrops belong to the dialog element. Only a press AND
   release outside its rectangle dismisses it; clicks in padding stay open. */
const DialogDismiss = {
  outside(dialog,event){const r=dialog.getBoundingClientRect();return Number.isFinite(event.clientX)&&Number.isFinite(event.clientY)&&(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom);}
};
(() => {
  let pressed=null;
  document.addEventListener('pointerdown',e=>{const d=e.target.closest?.('dialog[open]');pressed=d&&DialogDismiss.outside(d,e)?d:null;},true);
  document.addEventListener('pointercancel',()=>{pressed=null;},true);
  document.addEventListener('click',e=>{const d=e.target.closest?.('dialog[open]');if(d&&pressed===d&&DialogDismiss.outside(d,e))d.close();pressed=null;},true);
})();

</script><script>
/* Bounded whole-bench search. Scores are local fit utilities, never win odds.
   Academy remains the baseline; only evidenced, compatible Meta S/A alternatives
   can change a named champion's remaining build. All writes are explicit. */
const DecisionPlanner = {
  same:(a,b)=>Academy.normalizeName(a||'')===Academy.normalizeName(b||''),
  copies:(ids,id)=>ids.filter(x=>x===id).length,
  pending(plan,name){return plan.queue.filter(q=>!q.done&&this.same(q.champion,name));},
  equipped(plan,name){return PlanAdvisor.equipped(plan,name).map(q=>q.item);},
  subtract(ids,owned){const out=[...ids];for(const id of owned){let at=out.indexOf(id);if(at<0)at=out.findIndex(x=>Academy.itemMatches(x,id));if(at<0)return null;out.splice(at,1);}return out;},
  commitments(plan,name){const pending=this.pending(plan,name).map(q=>q.item);return (plan.pivotIntents?.[Academy.normalizeName(name)]||[]).filter(id=>pending.includes(id));},
  missing(ids,pool){let n=0;pool={...pool};for(const id of ids)for(const c of byId[id].recipe){if(pool[c]>0)pool[c]--;else n++;}return n;},
  builds(plan,name,{item='',allowSpecial=false,keepIntents=true}={}){
    const data=MetaBuilds.dataFor({champion:name}),unit=MetaBuilds.champion(name);
    if(!unit||data?.unit!==unit.apiName||data.set!=='TFTSet'+Academy.snapshot.set)return [];
    const equipped=this.equipped(plan,name),pending=this.pending(plan,name).map(q=>q.item),intents=keepIntents?this.commitments(plan,name):[];
    const seen=new Set(),result=[];
    for(const b of data.builds){
      if(!['S','A'].includes(b.tier)||b.games<100)continue;
      const ids=b.items.map(id=>Academy.itemMap.get(id));if(ids.some(id=>!byId[id]))continue;
      if(ids.reduce((n,id)=>n+CompFinder.slotCost(id),0)>3)continue;
      const rest=this.subtract(ids,equipped);if(!rest||!rest.length||!MetaBuilds.fits(rest,intents)||item&&!rest.includes(item))continue;
      if(rest.some(id=>byId[id].recipe.length!==2&&!(allowSpecial&&id===item)))continue;
      const key=[...ids].sort().join('|');if(seen.has(key))continue;seen.add(key);
      const pool=[...pending];let retained=0;for(const id of rest){const at=pool.indexOf(id);if(at>=0){pool.splice(at,1);retained++;}}
      result.push({...b,items:ids,remaining:rest,equipped,champion:name,source:'meta',updated:data.updated,retained,missing:this.missing(rest,plan.owned)});
    }
    // Keep evidence important without making every tiny statistical difference
    // more important than several missing components or an existing plan.
    const urgent=plan.tempo==='urgent';
    const utility=b=>({S:12,A:9}[b.tier])+Math.max(-1,Math.min(1,b.score))*4+b.retained*1.8-b.missing*(urgent?2.2:.65);
    return result.sort((a,b)=>utility(b)-utility(a)||b.games-a.games||a.items.join().localeCompare(b.items.join()));
  },
  pivot(plan,name,id){
    if(!byId[id])return null;
    // The newly selected item is an additional commitment beside equipment.
    // Existing unfinished intentions may be replaced by this explicit pivot.
    return this.builds(plan,name,{item:id,allowSpecial:true,keepIntents:false})[0]||null;
  },
  applyBuild(plan,choice){
    const pending=this.pending(plan,choice.champion),pool=[...pending],replacements=choice.remaining.map(id=>{
      const at=pool.findIndex(q=>q.item===id),old=at>=0?pool.splice(at,1)[0]:null;
      return old?{...old,planSource:choice.source==='academy'?'academy':'meta'}:{uid:crypto.randomUUID(),item:id,champion:choice.champion,done:false,used:{},usedSources:{},planSource:choice.source==='academy'?'academy':'meta',sourceComp:plan.activeComp?.title||''};
    });
    QueueOrder.inherit(plan,pending,replacements);
    const oldIds=new Set(pending.map(q=>q.uid)),at=plan.queue.findIndex(q=>oldIds.has(q.uid));
    plan.queue=plan.queue.filter(q=>!oldIds.has(q.uid));plan.queue.splice(at<0?plan.queue.length:at,0,...replacements);
  },
  applyPivot(plan,name,id,mode='plan'){
    const choice=this.pivot(plan,name,id);if(!choice)return false;
    if(mode==='craft'&&!OfflineTracker.canCraft(plan.owned,byId[id]))return false;
    const owned=mode==='owned'?plan.queue.find(q=>q.done&&q.item===id&&!q.champion):null;
    if(mode==='owned'&&!owned)return false;
    this.applyBuild(plan,choice);
    const q=this.pending(plan,name).find(q=>q.item===id);if(!q)return false;
    if(mode==='craft')Tracker.complete(plan,q,byId[id]);
    if(mode==='owned'){owned.champion=name;plan.queue=plan.queue.filter(x=>x.uid!==q.uid);}
    plan.pivotIntents||={};plan.pivotIntents[Academy.normalizeName(name)]=mode==='plan'?[id]:[];
    return true;
  },
  groups(plan){
    const pending=plan.queue.filter(q=>!q.done),names=[...new Set(pending.map(q=>q.champion).filter(Boolean))],groups=[];
    for(const name of names){
      const targets=this.pending(plan,name),equipped=this.equipped(plan,name),intents=this.commitments(plan,name);
      const remaining=targets.map(q=>q.item),baseline={champion:name,source:'academy',remaining,equipped,items:[...equipped,...remaining],score:0};
      const baseOptions=baseline.items.reduce((n,id)=>n+CompFinder.slotCost(id),0)<=3?[baseline]:[];
      const options=[...baseOptions,...this.builds(plan,name).slice(0,6)].filter(b=>MetaBuilds.fits(b.remaining,intents));
      const seen=new Set();groups.push({name,rank:pending.indexOf(targets[0]),targets,options:options.filter(b=>{const key=[...b.remaining].sort().join('|');if(seen.has(key))return false;seen.add(key);return true;})});
    }
    for(const q of pending.filter(q=>!q.champion))groups.push({name:'',rank:pending.indexOf(q),targets:[q],options:[{champion:'',uid:q.uid,source:'academy',remaining:[q.item],equipped:[],items:[q.item]}]});
    return groups.sort((a,b)=>a.rank-b.rank);
  },
  solve(plan,groups=this.groups(plan)){
    const urgent=plan.tempo==='urgent';let beam=[{pool:{...plan.owned},score:0,actions:[],count:0}];
    for(const group of groups){
      const variants=[];
      for(const b of group.options){
        // Only the first six targets are searched for malformed/oversized manual
        // champion plans. Normal champion builds contain at most three items.
        const ready=b.remaining.map((id,index)=>({id,index})).filter(x=>OfflineTracker.canCraft(plan.owned,byId[x.id])).slice(0,6);
        for(let mask=1;mask<(1<<ready.length);mask++){
          const crafts=ready.filter((x,n)=>mask&(1<<n)).map(x=>x.id),need={};for(const id of crafts)for(const c of byId[id].recipe)need[c]=(need[c]||0)+1;
          if(Object.entries(need).some(([c,n])=>n>(plan.owned[c]||0)))continue;
          const targetPool=group.targets.map(q=>q.item);let matching=0;
          for(const id of crafts){const at=targetPool.indexOf(id);if(at>=0){matching++;targetPool.splice(at,1);}}
          const score=crafts.length*(urgent?42:28)+crafts.length*Math.max(1,12-group.rank)+matching*4-(b.source==='meta'?(urgent?2:8):0)+Math.max(0,Math.min(2,(b.score||0)*2));
          variants.push({choice:b,crafts,need,score});
        }
      }
      const next=[...beam];for(const s of beam)for(const v of variants){
        if(Object.entries(v.need).some(([c,n])=>n>(s.pool[c]||0)))continue;
        const pool={...s.pool};for(const [c,n]of Object.entries(v.need))pool[c]-=n;
        next.push({pool,score:s.score+v.score,actions:[...s.actions,{choice:v.choice,crafts:v.crafts}],count:s.count+v.crafts.length});
      }
      const seen=new Set();beam=next.sort((a,b)=>b.score-a.score||b.count-a.count).filter(s=>{const key=componentOrder.map(c=>s.pool[c]||0).join(',');if(seen.has(key))return false;seen.add(key);return true;}).slice(0,64);
    }
    return beam[0];
  },
  execute(plan,result){
    // Validate the complete transaction against current inventory before writes.
    const copy=JSON.parse(JSON.stringify(plan));
    for(const action of result.actions){
      const b=action.choice;if(b.champion&&b.source==='meta')this.applyBuild(copy,b);
      for(const id of action.crafts){
        const q=copy.queue.find(q=>!q.done&&q.item===id&&(b.uid?q.uid===b.uid:this.same(q.champion,b.champion)));
        if(!q||!OfflineTracker.canCraft(copy.owned,byId[id]))return false;
        Tracker.complete(copy,q,byId[id]);
      }
    }
    Object.assign(plan,copy);return true;
  },
  carouselTargets(plan){
    const allocation=Tracker.allocate(plan,DATA.items),planned={},pivots={};
    const add=(map,id,target)=>{(map[id]||=[]).push(target);};
    for(const q of allocation.rows){
      for(const id of new Set(q.slots.filter(s=>!s.have).map(s=>s.id)))
        add(planned,id,{item:q.item,champion:q.champion||'',uid:q.uid,source:'planned',rank:q.rank});
    }
    const names=[...new Set(allocation.rows.map(q=>q.champion).filter(Boolean))];
    for(const name of names){
      const pending=this.pending(plan,name).map(q=>q.item),candidates={};
      // Carousel discovery uses every eligible build, not the crafting beam's
      // six-option budget. Completed copies are subtracted by builds().
      for(const b of this.builds(plan,name)){
        const existing=[...pending],kept=[],changed=[];
        for(const item of b.remaining){const at=existing.indexOf(item);if(at>=0){existing.splice(at,1);kept.push(item);}else changed.push(item);}
        if(!changed.length)continue;
        const pool={...plan.owned};
        // Reserve components for retained targets before allocating alternatives.
        for(const item of kept)for(const id of byId[item].recipe)if(pool[id]>0)pool[id]--;
        const perBuild={};
        for(const item of changed){
          const missing=[];for(const id of byId[item].recipe){if(pool[id]>0)pool[id]--;else missing.push(id);}
          for(const id of new Set(missing)){
            const key=id+'|'+item;
            if(perBuild[key])perBuild[key].copies++;
            else perBuild[key]={id,item,champion:name,source:'pivot',tier:b.tier,score:b.score,games:b.games,missing:b.missing,build:b.items,copies:1};
          }
        }
        for(const target of Object.values(perBuild))add(candidates,target.id,target);
      }
      for(const [id,options] of Object.entries(candidates)){
        options.sort((a,b)=>'SA'.indexOf(a.tier)-'SA'.indexOf(b.tier)||b.score-a.score||a.missing-b.missing||b.games-a.games);
        const tier=options[0].tier,seen=new Set();
        // If this component can advance a compatible S build, do not present an
        // A build as the preferred route for the same champion.
        for(const target of options){if(target.tier!==tier||seen.has(target.item))continue;seen.add(target.item);add(pivots,id,target);}
      }
    }
    for(const options of Object.values(pivots))options.sort((a,b)=>'SA'.indexOf(a.tier)-'SA'.indexOf(b.tier)||b.score-a.score||a.missing-b.missing||b.games-a.games);
    return {allocation,planned,pivots};
  },
  carousel(plan,groups=this.groups(plan)){
    const {allocation,planned,pivots}=this.carouselTargets(plan),needs=allocation.needs;
    if(!allocation.rows.length)return this.discovery(plan);
    // Planned priorities must be scored exclusively against the current queue.
    // A craftable alternative must not boost a planned component's rank.
    const baselineGroups=groups.map(g=>({...g,options:[{champion:g.name,uid:g.name?undefined:g.targets[0]?.uid,source:'academy',remaining:g.targets.map(q=>q.item),items:g.targets.map(q=>q.item)}]}));
    const order=Academy.itemizationOrder(Academy.guide(plan)),holderRanks=new Map(order.flatMap((names,n)=>names.map(name=>[Academy.normalizeName(name),n])));
    const rawRank=name=>order.length?(holderRanks.get(Academy.normalizeName(name||''))??order.length):0;
    // An explicit user reorder can promote another recipient group. Otherwise
    // the guide's stated carry/tank/support sequence outranks a ready craft.
    const pending=QueueOrder.pending(plan),recommended=QueueOrder.recommended(plan);
    const custom=pending.some((q,n)=>q.uid!==recommended[n]?.uid),groupRanks=new Map();
    if(order.length&&custom)for(const q of pending){const rank=rawRank(q.champion);if(!groupRanks.has(rank))groupRanks.set(rank,groupRanks.size);}
    const holderRank=name=>groupRanks.size?(groupRanks.get(rawRank(name))??groupRanks.size):rawRank(name);
    const evaluations=new Map();
    const baselineFor=rank=>{
      if(!evaluations.has(rank)){const eligible=order.length?baselineGroups.filter(g=>holderRank(g.name)<=rank):baselineGroups;evaluations.set(rank,{groups:eligible,base:this.solve(plan,eligible)});}
      return evaluations.get(rank);
    };
    return componentOrder.filter((id,n)=>n<8||needs[id]||pivots[id]?.length).map(id=>{
      const targets=(planned[id]||[]).slice().sort((a,b)=>holderRank(a.champion)-holderRank(b.champion)||a.rank-b.rank),alternatives=pivots[id]||[],baseline=needs[id],priority=Academy.componentPreference(plan,id);
      const carrierRank=targets.length?holderRank(targets[0].champion):Infinity;
      let gain=0,score=0,best={actions:[]};
      if(baseline){
        const after={...plan,owned:{...plan.owned,[id]:(plan.owned[id]||0)+1}};
        const context=baselineFor(carrierRank);
        best=this.solve(after,context.groups);gain=best.score-context.base.score;
        const reach=targets.reduce((sum,t)=>sum+3*Math.max(1,6-t.rank),0);
        score=gain+Math.min(20,reach)+3-(Number.isFinite(priority)?Math.min(priority,20)*.15:0);
      }else if(alternatives.length){
        const b=alternatives[0];score=(b.tier==='S'?20:10)+Math.max(0,Math.min(2,b.score))-Math.min(6,b.missing)*.1;
      }
      return {id,score,gain,best,carrierRank,pivot:!!alternatives.length,pivotTier:alternatives[0]?.tier||'',targets,pivotTargets:alternatives,count:baseline?.count||0,rank:baseline?.rank??99,items:baseline?.items||[],finishes:targets};
    }).sort((a,b)=>Number(b.count>0)-Number(a.count>0)||Number(plan.pins.includes(b.id))-Number(plan.pins.includes(a.id))||(a.count&&b.count?a.carrierRank-b.carrierRank:0)||b.score-a.score||LootTracker.compare(plan,a.id,b.id)||componentOrder.indexOf(a.id)-componentOrder.indexOf(b.id));
  },
  discovery(plan){
    const candidates=CompFinder.ranked(plan).filter(r=>!r.blocked).slice(0,8);
    return componentOrder.slice(0,8).map(id=>{
      let score=0;const items=new Set(),routes=[];
      for(const r of candidates){
        const pending=r.remaining||r.build.entries,pool={...plan.owned};let best=0;
        for(const e of pending.slice(0,6)){
          const recipe=byId[e.item]?.recipe||[];if(!recipe.includes(id))continue;
          const need=OfflineTracker.recipeCounts(byId[e.item]);if((need[id]||0)<=(pool[id]||0))continue;
          const after={...pool,[id]:(pool[id]||0)+1},ready=OfflineTracker.canCraft(after,byId[e.item]);
          const value=ready?6:1;best=Math.max(best,value);items.add(e.item);
        }
        if(best){score+=best*(1+Math.max(0,r.fitScore)/100);routes.push(r.guide.title);}
      }
      return {id,score,gain:0,count:0,rank:99,items:[],routes,discovery:true,targets:[...items].map(item=>({item,source:'discovery'})),pivotTargets:[],finishes:[...items].map(item=>({item})),best:{actions:[]}};
    }).sort((a,b)=>Number(plan.pins.includes(b.id))-Number(plan.pins.includes(a.id))||b.score-a.score||LootTracker.compare(plan,a.id,b.id)||componentOrder.indexOf(a.id)-componentOrder.indexOf(b.id));
  },
  anvil(plan,type='ornns'){
    if(type==='components')return this.carousel(plan).filter(r=>componentOrder.slice(0,8).includes(r.id)).map(r=>({...r,item:byId[r.id],component:true,champion:'',reason:r.count?r.count+' still needed for your queue':r.discovery?'Flexible component':r.pivot?'Pivot item':'Not needed'}));
    const guide=Academy.guide(plan),ranked=guide?[]:CompFinder.ranked(plan).filter(r=>!r.blocked).slice(0,8);
    const guides=guide?[guide]:ranked.map(r=>r.guide),names=[...new Set(guides.flatMap(g=>g.finalComp.map(u=>Academy.snapshot.champions.find(c=>c.apiName===u.apiName)?.name)).filter(Boolean))];
    const bases=new Map(guides.map(g=>[g.id,Academy.build(g).entries]));
    return CompFinder.ownedCatalog().filter(i=>i.type===type).map(item=>{
      let best={score:0,champion:'',reason:'No supported match',guide:null};
      for(const g of guides){
        for(const u of g.finalComp){
          const name=Academy.snapshot.champions.find(c=>c.apiName===u.apiName)?.name;if(!name)continue;
          const eq=guide?this.equipped(plan,name):[];
          if(eq.reduce((n,id)=>n+CompFinder.slotCost(id),0)+CompFinder.slotCost(item.id)>3||item.unique&&eq.includes(item.id)||item.type==='emblems'&&item.trait&&(MetaBuilds.champion(name)?.traitKeys||[]).includes(item.trait))continue;
          const targets=bases.get(g.id).filter(e=>this.same(e.champion,name));
          const exact=targets.some(e=>Academy.itemMatches(e.item,item.id));
          const alt=(g.altBuilds||[]).some(a=>a.apiName===u.apiName&&a.items.some(api=>Academy.itemMatches(Academy.itemMap.get(api),item.id)));
          const endorsed=item.recommendedChampions?.includes(u.apiName);
          let score=exact?55:alt?47:endorsed?32:0,reason=exact?'Academy target':alt?'Academy alternate':endorsed?'Academy item guide':'No supported match';
          if(!score)continue;
          if(!guide){const fit=ranked.find(r=>r.guide.id===g.id);score+=Math.max(-15,Math.min(20,(fit?.fitScore||0)/4));}
          if(u.apiName===g.mainChampion?.apiName)score+=3;
          if(score>best.score)best={score,champion:name,reason,guide:g};
        }
      }
      if(guide)for(const name of names){const b=this.pivot(plan,name,item.id);if(b){const score=(b.tier==='S'?62:53)+Math.min(3,b.score)+b.retained; if(score>best.score)best={score,champion:name,reason:'MetaTFT '+b.tier+' combination',guide,build:b};}}
      return {item,...best};
    }).sort((a,b)=>b.score-a.score||a.item.name.localeCompare(b.item.name));
  },
  receiveAnvil(plan,row){
    if(row.component&&componentOrder.slice(0,8).includes(row.item.id)){LootTracker.gain(plan,row.item.id,'other');return;}
    const id=row.item.id,name=row.champion||'';
    // Endorsements are suggestions for holders, not fabricated equipment.
    // Reuse an exact target when possible; otherwise leave the receipt unassigned.
    const target=plan.queue.find(q=>!q.done&&q.item===id&&(!name||this.same(q.champion,name)));
    if(target)OfflineTracker.receive(plan,target);
    else plan.queue.push({uid:crypto.randomUUID(),item:id,done:true,received:true,used:{},usedSources:{},champion:''});
  }
};

// The board's existing adjustment panel uses the same compatibility engine.
PlanAdvisor.suggest=function(plan,name){
  const guide=Academy.guide(plan),equipped=DecisionPlanner.equipped(plan,name),targets=DecisionPlanner.pending(plan,name);
  if(!guide||!equipped.length||!targets.length)return null;
  if(equipped.reduce((n,id)=>n+CompFinder.slotCost(id),0)>=3)return {champion:name,equipped,remaining:[],kind:'full'};
  const baseline=Academy.build(guide).entries.filter(q=>DecisionPlanner.same(q.champion,name)).map(q=>q.item);
  if(DecisionPlanner.subtract(baseline,equipped)!==null)return null;
  const options=DecisionPlanner.builds(plan,name),best=options[0];if(!best)return null;
  const ids=targets.map(q=>q.item),current=options.find(b=>b.remaining.length===ids.length&&MetaBuilds.fits(b.remaining,ids));
  if(current&&(current===best||best.missing>=current.missing-2))return null;
  return best;
};
PlanAdvisor.apply=function(plan,choice){DecisionPlanner.applyBuild(plan,choice);return true;};

</script><script>
(() => {
  let expanded=false,catalogSignature='',exploring=false,lastComp=state.activeComp?.id||'',unitCost=0,specialType='all';
  const panel=document.createElement('section');panel.id='comp-finder';panel.className='panel comp-finder';panel.setAttribute('aria-labelledby','finder-title');
  panel.innerHTML=`<div class="finder-heading"><div><h2 id="finder-title">Explore builds</h2><p>Your board, your drops → an Academy plan to aim for.</p></div></div>
  <div class="explore-inputs"><section class="explore-board"><div class="explore-label"><h3>Current champions</h3><span>Board + bench · highest star per champion</span></div><div class="unit-search-row"><label class="visuallyhidden" for="explore-unit-search">Add a champion</label><input id="explore-unit-search" class="search" placeholder="Add champion… type a name, Enter" autocomplete="off" type="search" aria-controls="explore-unit-results"><button id="explore-browse" class="quiet">Browse</button></div><div id="explore-unit-results" class="unit-search-results" hidden></div><div id="explore-current-units" class="current-units"></div></section>
  <section class="explore-inventory"><div class="finder-controls"><label for="first-augment-trigger">First augment</label><select id="first-augment"></select></div><p id="augment-note" class="finder-note"></p><div class="explore-label"><h3>Completed items</h3><button id="explore-items-open" class="quiet">Browse all</button></div><div class="owned-search-wrap"><label class="visuallyhidden" for="owned-item-search">Add an owned completed item</label><input id="owned-item-search" class="search" type="search" placeholder="Add owned item… Rageblade, emblem, radiant…" autocomplete="off" aria-controls="owned-item-results"><div id="owned-item-results" hidden></div></div><div id="explore-owned-items"></div><small class="explore-inventory-note">Loose components use the bench above.</small></section></div>
  <div class="finder-list-heading"><strong>Closest routes from what you have</strong><span>All tiers · badges = Academy rank</span></div><div id="comp-suggestions"></div><button id="finder-more" class="quiet"></button>
  <details class="finder-method"><summary>How this is ranked</summary><p>Academy tier leads the ranking. Your items, units and augments rank comps within each tier. A lower-tier comp can move ahead only with substantial matching resources and a clear fit advantage. Matches use its final board, alternate items, early holders, featured item and recommended carriers. All remaining item recipes are checked; each loose component counts once. Emblems count as whole items, radiants cover their normal versions, and special items never turn back into components. Missing emblems, required situational augments, core units and star upgrades reduce readiness. Supported saved MetaTFT S/A item builds supplement Academy; these item-build tiers do not filter out B/C comps. A suggested carrier is a destination, not an equipped-item claim. Aim here keeps the Academy baseline; review alternate carriers in the plan. This is a fit estimate, not a win probability: economy, stage and lobby contesting are not tracked.</p></details>`;
  document.querySelector('.plan-queue').prepend(panel);
  const mode=document.createElement('button');mode.id='explore-mode';mode.className='quiet';mode.textContent='Explore builds';document.querySelector('.actions').prepend(mode);
  mode.addEventListener('click',()=>{exploring=!exploring;draw();});
  const select=panel.querySelector('select');select.innerHTML='<option value="">Not chosen yet</option>';
  const picker=IconUI.picker(select,'augment','First augment');
  select.addEventListener('change',()=>mutate(()=>{state.firstAugment=select.value;state.chosenAugments||=['','',''];state.chosenAugments[0]=select.value;},'First augment updated.'));
  panel.querySelector('#finder-more').addEventListener('click',()=>{expanded=!expanded;draw();});
  panel.addEventListener('click',e=>{
    const b=e.target.closest('[data-choose-comp]');if(!b)return;
    try{exploring=false;mutate(()=>CompFinder.choose(state,b.dataset.chooseComp),'Academy plan loaded. Board and inventory kept.');document.getElementById('item-drawer').removeAttribute('open');}
    catch(err){toast(err.message);}
  });
  const unitsDialog=document.createElement('dialog');unitsDialog.id='explore-unit-dialog';unitsDialog.setAttribute('aria-labelledby','unit-dialog-title');
  unitsDialog.innerHTML='<div class="modal-heading"><h2 id="unit-dialog-title">Your champions</h2><button data-close="explore-unit-dialog" aria-label="Close champion picker">×</button></div><input class="search" id="unit-dialog-search" type="search" placeholder="Find a champion…" aria-label="Find a champion"><div id="unit-costs" class="explore-tabs" role="group" aria-label="Champion cost"></div><div id="unit-dialog-list" class="unit-catalog"></div><p class="finder-note">Click to add or remove. Set stars on your board.</p>';
  document.body.append(unitsDialog);
  const itemsDialog=document.createElement('dialog');itemsDialog.id='explore-item-dialog';itemsDialog.setAttribute('aria-labelledby','explore-item-title');
  itemsDialog.innerHTML='<div class="modal-heading"><h2 id="explore-item-title">Items you own</h2><button data-close="explore-item-dialog" aria-label="Close owned item picker">×</button></div><input class="search" id="explore-item-search" type="search" placeholder="Find an item…" aria-label="Find an owned item"><div id="explore-item-tabs" class="explore-tabs" role="group" aria-label="Item type"></div><div id="explore-item-list" class="special-catalog"></div><p class="finder-note">Record items you already own. One click per copy; components stay unchanged.</p>';
  document.body.append(itemsDialog);
  const search=panel.querySelector('#explore-unit-search'),results=panel.querySelector('#explore-unit-results');
  function unitButton(c,attr='data-add-unit'){
    const selected=(state.currentUnits||[]).some(u=>u.apiName===c.apiName);
    return `<button ${attr}="${esc(c.apiName)}" class="unit-pick cost-${c.cost}" ${attr==='data-toggle-unit'?`aria-pressed="${selected}"`:''} aria-label="${attr==='data-toggle-unit'&&selected?'Remove':'Add'} ${esc(c.name)}"><span>${IconUI.champion(c.apiName)}${selected?'<b>✓</b>':''}</span><span>${esc(c.name)}</span><small>${c.cost}g</small></button>`;
  }
  function drawSearch(){const q=Academy.normalizeName(search.value);results.hidden=!q;results.innerHTML=q?CompFinder.champions().filter(c=>Academy.normalizeName(c.name).includes(q)).slice(0,12).map(c=>unitButton(c)).join('')||'<p class="finder-note">No champions found.</p>':'';}
  function drawUnitDialog(){
    const q=Academy.normalizeName(document.getElementById('unit-dialog-search').value);
    document.getElementById('unit-costs').innerHTML=[0,1,2,3,4,5].map(n=>`<button data-unit-cost="${n}" aria-pressed="${n===unitCost}">${n?n+'g':'All'}</button>`).join('');
    document.getElementById('unit-dialog-list').innerHTML=CompFinder.champions().filter(c=>(!unitCost||c.cost===unitCost)&&Academy.normalizeName(c.name).includes(q)).map(c=>unitButton(c,'data-toggle-unit')).join('')||'<p class="finder-note">No champions found.</p>';
  }
  function drawItemsDialog(){
    const q=Academy.normalizeName(document.getElementById('explore-item-search').value);
    document.getElementById('explore-item-tabs').innerHTML=[['all','All'],['craftables','Standard'],['emblems','Emblems'],['radiants','Radiant'],['ornns','Artifacts'],['others','Other']].map(([id,name])=>`<button data-special-type="${id}" aria-pressed="${specialType===id}">${name}</button>`).join('');
    const found=CompFinder.ownedCatalog().filter(i=>(specialType==='all'||i.type===specialType)&&Academy.normalizeName(i.name).includes(q));
    document.getElementById('explore-item-list').innerHTML=found.flatMap(i=>{const id=i.id;if(!byId[id])return [];const count=state.queue.filter(q=>q.done&&q.item===id).length;
      return [`<button class="special-pick" data-owned-add="${esc(id)}" aria-label="Add owned ${esc(i.name)}${count?', '+count+' already recorded':''}" title="${esc(i.name)}">${icon(id)}<span>${esc(i.name.replace(/^Radiant /,''))}</span>${count?`<b>×${count}</b>`:''}</button>`];}).join('')||'<p class="finder-note">No matching items in this category.</p>';
  }
  const ownedSearch=document.getElementById('owned-item-search'),ownedResults=document.getElementById('owned-item-results');
  function drawOwnedSearch(){
    const q=Academy.normalizeName(ownedSearch.value);ownedResults.hidden=!q;
    const labels={craftables:'Standard',radiants:'Radiant',ornns:'Artifact',emblems:'Emblem',others:'Other'};
    const found=CompFinder.ownedCatalog().filter(i=>Academy.normalizeName(i.name).includes(q)).sort((a,b)=>Number(!Academy.normalizeName(a.name).startsWith(q))-Number(!Academy.normalizeName(b.name).startsWith(q))||a.name.localeCompare(b.name)).slice(0,10);
    ownedResults.innerHTML=q?found.map(i=>`<button data-owned-quick="${esc(i.id)}" aria-label="Record owned ${esc(i.name)}">${icon(i.id)}<span>${esc(i.name)}</span><small>${labels[i.type]||'Other'}</small></button>`).join('')||'<p class="finder-note">No matching items. Try the item name or Browse all.</p>':'';
  }
  function receiveOwned(id){if(!byId[id])return;mutate(()=>{const q=state.queue.find(q=>!q.done&&q.item===id);if(q)OfflineTracker.receive(state,q);else state.queue.push({uid:crypto.randomUUID(),item:id,done:true,received:true,used:{},usedSources:{},champion:''});},byId[id].name+' recorded.');}
  ownedSearch.addEventListener('input',drawOwnedSearch);
  ownedSearch.addEventListener('keydown',e=>{if(e.key==='Enter'){const b=ownedResults.querySelector('button');if(b){e.preventDefault();b.click();}}else if(e.key==='Escape'){ownedSearch.value='';drawOwnedSearch();}else if(e.key==='ArrowDown'){e.preventDefault();ownedResults.querySelector('button')?.focus();}});
  search.addEventListener('input',drawSearch);
  search.addEventListener('keydown',e=>{if(e.key==='Enter'){const b=results.querySelector('button');if(b){e.preventDefault();b.click();}}else if(e.key==='Escape'){search.value='';drawSearch();}else if(e.key==='ArrowDown'){e.preventDefault();results.querySelector('button')?.focus();}});
  panel.querySelector('#explore-browse').addEventListener('click',()=>{unitCost=0;document.getElementById('unit-dialog-search').value='';drawUnitDialog();unitsDialog.showModal();document.getElementById('unit-dialog-search').focus();});
  panel.querySelector('#explore-items-open').addEventListener('click',()=>{specialType='all';document.getElementById('explore-item-search').value='';drawItemsDialog();itemsDialog.showModal();document.getElementById('explore-item-search').focus();});
  document.getElementById('unit-dialog-search').addEventListener('input',drawUnitDialog);document.getElementById('explore-item-search').addEventListener('input',()=>{specialType='all';drawItemsDialog();});
  document.addEventListener('click',e=>{
    let b=e.target.closest('[data-add-unit]');if(b){mutate(()=>CompFinder.addUnit(state,b.dataset.addUnit),'Champion added.');search.value='';drawSearch();search.focus();}
    b=e.target.closest('[data-toggle-unit]');if(b){const id=b.dataset.toggleUnit;mutate(()=>{if((state.currentUnits||[]).some(u=>u.apiName===id))state.currentUnits=state.currentUnits.filter(u=>u.apiName!==id);else CompFinder.addUnit(state,id);},'Board updated.');}
    b=e.target.closest('[data-unit-stars]');if(b)mutate(()=>{const u=state.currentUnits?.find(u=>u.apiName===b.dataset.unit);if(u)u.stars=Number(b.dataset.unitStars);},'Star level updated.');
    b=e.target.closest('[data-unit-remove]');if(b)mutate(()=>{state.currentUnits=(state.currentUnits||[]).filter(u=>u.apiName!==b.dataset.unitRemove);},'Champion removed.');
    b=e.target.closest('[data-unit-cost]');if(b){unitCost=Number(b.dataset.unitCost);drawUnitDialog();}
    b=e.target.closest('[data-special-type]');if(b){specialType=b.dataset.specialType;drawItemsDialog();}
    b=e.target.closest('[data-owned-add]');if(b)receiveOwned(b.dataset.ownedAdd);
    b=e.target.closest('[data-owned-quick]');if(b){receiveOwned(b.dataset.ownedQuick);ownedSearch.value='';drawOwnedSearch();ownedSearch.focus();}
    if(!e.target.closest('.owned-search-wrap'))ownedResults.hidden=true;
    b=e.target.closest('[data-owned-remove]');if(b)mutate(()=>{state.queue=state.queue.filter(q=>q.uid!==b.dataset.ownedRemove);},'Owned item removed. Undo to restore.');
    if(!e.target.closest('.explore-board'))results.hidden=true;
  });
  document.addEventListener('error',e=>{if(!e.target.classList?.contains('augment-icon'))return;const fallback=document.createElement('span');fallback.className='augment-icon augment-fallback';fallback.textContent='✦';fallback.setAttribute('aria-hidden','true');e.target.replaceWith(fallback);},true);
  const chips=ids=>ids.map(id=>`<span class="finder-item" title="${esc(byId[id]?.name||id)}" aria-label="${esc(byId[id]?.name||id)}">${icon(id)}</span>`).join('');
  const unitChips=units=>units.map(u=>`<span class="fit-unit" title="${esc(u.name)} ${u.stars}★${u.targetStars&&u.targetStars>u.stars?' → target '+u.targetStars+'★':''}" aria-label="${esc(u.name)}, ${u.stars} stars">${IconUI.champion(u.apiName)}<b>${u.stars}★</b></span>`).join('');
  function drawInputs(){
    const units=CompFinder.units(state);
    document.getElementById('explore-current-units').innerHTML=units.map(u=>`<div class="current-unit"><div>${IconUI.champion(u.apiName)}<strong>${esc(u.name)}</strong><button class="unit-remove" data-unit-remove="${esc(u.apiName)}" aria-label="Remove ${esc(u.name)}">×</button></div><div class="unit-stars" role="group" aria-label="${esc(u.name)} star level">${[1,2,3].map(n=>`<button data-unit-stars="${n}" data-unit="${esc(u.apiName)}" data-focus="unit-${esc(u.apiName)}-${n}" aria-pressed="${u.stars===n}" aria-label="${esc(u.name)} ${n} star${n>1?'s':''}">${n}★</button>`).join('')}</div></div>`).join('')||'<p class="finder-note">Add a few units to see which boards you’re closest to.</p>';
    document.getElementById('explore-owned-items').innerHTML=state.queue.filter(q=>q.done).map(q=>`<span class="explore-owned" title="${esc(byId[q.item].name)}">${icon(q.item)}<button data-owned-remove="${esc(q.uid)}" aria-label="Remove owned ${esc(byId[q.item].name)}">×</button></span>`).join('')||'<span class="finder-note">No completed items recorded</span>';
    if(unitsDialog.open)drawUnitDialog();if(itemsDialog.open)drawItemsDialog();drawSearch();
  }
  function draw(){
    const comp=state.activeComp?.id||'';if(comp!==lastComp){exploring=false;lastComp=comp;}
    panel.hidden=!!state.activeComp&&!exploring;mode.hidden=!state.activeComp;mode.textContent=exploring?'Back to plan':'Explore builds';mode.setAttribute('aria-pressed',String(exploring));
    document.querySelector('.centercol').classList.toggle('exploring-plan',!!state.activeComp&&exploring);
    if(panel.hidden){picker.close();return;}
    drawInputs();
    const catalog=CompFinder.augments(),signature=catalog.map(a=>a.apiName+a.name).join('|')+'|'+(state.firstAugment||'');
    if(signature!==catalogSignature){catalogSignature=signature;select.innerHTML='<option value="">Not chosen yet</option>'+catalog.map(a=>`<option value="${esc(a.apiName)}">${esc(a.name)}</option>`).join('');if(state.firstAugment&&!catalog.some(a=>a.apiName===state.firstAugment))select.insertAdjacentHTML('beforeend',`<option value="${esc(state.firstAugment)}">${esc(CompFinder.augment(state.firstAugment)?.name||'Saved augment (unavailable)')}</option>`);select.value=state.firstAugment||'';picker.refresh();}
    const rows=CompFinder.ranked(state),selected=CompFinder.augment(state.firstAugment),hasMatch=rows.some(r=>r.augmentMatch);
    const note=panel.querySelector('#augment-note');note.textContent=CompFinder.heldAugments(state).length?(hasMatch?'★ = Academy recommends one of your chosen augments.':'No listed augment match · using your board and items.'):'Optional · select your 2-1 augment.';note.title=selected?.description||'';
    panel.querySelector('#comp-suggestions').innerHTML=(expanded?rows:rows.slice(0,5)).map((r,n)=>{
      const g=r.guide,tier=g.tier==='X'?'Situational':g.tier,carry=g.mainChampion?.apiName;
      const fit=[r.keepers.length?`<span>Keep ${unitChips(r.keepers)}</span>`:'',r.early.length?`<span>Early ${unitChips(r.early)}</span>`:'',r.bridges.length?`<span>Trait bridge ${unitChips(r.bridges)}</span>`:'',r.matched.length?`<span>Owned ${chips(r.matched)}</span>`:'',r.used.length?`<span>Fits ${chips(r.used)}</span>`:'',r.ready.length?`<span>Can build ${chips(r.ready)}</span>`:'',r.earlyMatches.length?`<span>Early items ${chips(r.earlyMatches.map(m=>m.item))}</span>`:'',r.featuredOwned?`<span>Academy key item ${chips([r.featuredOwned])}</span>`:'',r.unmatched.length?`<span class="finder-unmatched">Off-plan ${chips(r.unmatched)}</span>`:'',r.unknownSpecial.some(id=>id!==r.featuredOwned)?`<span class="finder-unmatched">No supported match ${chips(r.unknownSpecial.filter(id=>id!==r.featuredOwned))}</span>`:''].filter(Boolean).join('');
      const special=r.specialMatches.map(s=>`<span class="special-destination" title="${esc(s.source)}">${chips([s.item])}<span>→</span>${IconUI.championLabel(s.champion)}<small>${esc(s.source)}</small></span>`).join('');
      const needs=[r.missingEmblems.length?`<span>Plan needs ${chips(r.missingEmblems)}</span>`:'',r.craftableEmblems.length?`<span>Emblem ready ${chips(r.craftableEmblems)}</span>`:'',r.missingAugment?`<span>Needs ${CompFinder.augmentIcon(r.missingAugment)} ${esc(CompFinder.augment(r.missingAugment)?.name||'required augment')}</span>`:'',r.missingCore.length?`<span>Aim for ${unitChips(r.missingCore.map(u=>({...u,stars:u.targetStars})))}</span>`:''].filter(Boolean).join('');
      const noFit=Object.values(state.owned).some(n=>n>0)||CompFinder.units(state).length?'No strong match yet':'Add items or units to personalize';
      return `<article class="comp-suggestion"><span class="finder-rank">${n+1}</span><div class="finder-comp"><div class="finder-titleline">${IconUI.champion(carry)}<h3>${esc(g.title)}</h3><span class="academy-tier tier-${esc(g.tier)}">${esc(tier)}</span>${r.augmentMatch?`<span class="finder-augment-match" title="Academy recommended augment" aria-label="Academy recommends your augment">${CompFinder.augmentIcon(r.matchedAugments[0])}<b aria-hidden="true">★</b></span>`:''}</div><div class="finder-fit">${fit||'<span class="muted">'+(r.augmentMatch?'Recommended augment match':noFit)+'</span>'}</div>${special?'<div class="special-destinations">'+special+'</div>':''}${needs?'<div class="finder-needs">'+needs+'</div>':''}</div><button data-choose-comp="${esc(g.id)}" aria-label="Choose ${esc(g.title)}">Aim here</button></article>`;
    }).join('')||'<p class="finder-note">No complete guides in this snapshot. Paste a code or add items manually.</p>';
    const more=panel.querySelector('#finder-more');more.hidden=rows.length<=5;more.textContent=expanded?'Show fewer':`All ${rows.length} comps`;
    const empty=document.querySelector('#queue .empty');if(empty)empty.hidden=true;
  }
  document.addEventListener('carousel-new-game',()=>{expanded=false;exploring=false;search.value='';ownedSearch.value='';drawOwnedSearch();picker.close();unitsDialog.close();itemsDialog.close();draw();});
  document.addEventListener('carousel-comp-imported',()=>{exploring=false;draw();});
  document.addEventListener('carousel-meta-updated',()=>{if(!panel.hidden)draw();});
  document.addEventListener('click',e=>{const b=e.target.closest('[data-pivot-item]');if(b)PivotDialog.open(b.dataset.pivotItem);});
  const previous=render;render=function(){const focus=document.activeElement?.dataset.focus;previous();draw();if(focus?.startsWith('unit-'))document.querySelector('[data-focus="'+CSS.escape(focus)+'"]')?.focus();for(const card of document.querySelectorAll('#queue .qcard')){const uid=card.querySelector('[data-action="remove"]')?.dataset.id,img=card.querySelector('.qtop > .icon');if(!uid||!img)continue;const b=document.createElement('button');b.className='queue-item-pivot';b.dataset.pivotItem=uid;b.setAttribute('aria-label','Pivot '+byId[state.queue.find(q=>q.uid===uid).item].name);b.setAttribute('aria-haspopup','dialog');img.before(b);b.append(img);}};
  document.querySelector('#help ol').insertAdjacentHTML('beforeend','<li><b>Explore builds:</b> type a champion name and Enter, then set its stars. Record your first augment and any completed items using the owned-item search or Browse all. Standard items, emblems, radiants, artifacts and other items are supported; click once per owned copy. Academy tier leads; lower tiers move ahead only for a strong match with a clear fit advantage. Unbuilt wishlist items do not count. Suggestions update from your board and inventory. Aim here loads an Academy guide and preserves everything recorded. Radiants cover the corresponding normal-item targets. Other special-item carrier suggestions do not assign equipment automatically. Explore builds can be reopened from your plan. New game clears board, augment and inventory; Undo restores them.</li><li>Click an unfinished item icon on the board or queue to pivot. Click outside any dialog to close it.</li>');
  render();
})();

</script><script>
/* Compact controls; no round, HP, gold, carousel position or offer transcription. */
const DecisionUI = (()=>{
  let cacheKey='',current=null,pivotChampion='',pivotQuery='';
  const dialog=(id,title)=>{const el=document.createElement('dialog');el.id=id;el.setAttribute('aria-labelledby',id+'-title');el.innerHTML=`<div class="modal-heading"><h2 id="${id}-title">${title}</h2><button data-close="${id}" aria-label="Close">×</button></div>`;document.body.append(el);return el;};
  const pivot=dialog('champion-pivot','Pivot champion');
  pivot.innerHTML+='<p class="decision-note">Choose the new item. Completed items stay; remaining targets adjust together.</p><input id="champion-pivot-search" class="search" type="search" placeholder="Find your pivot item…" aria-label="Find a pivot item"><div id="champion-pivot-results" class="decision-list"></div>';
  const controls=document.createElement('div');controls.className='decision-controls';controls.innerHTML='<div class="tempo-control" role="group" aria-label="Item planning preference"><button data-tempo="balanced">Balanced</button><button data-tempo="urgent">Need strength now</button></div><button id="anvil-open">Anvil choices</button>';
  document.querySelector('.bench .panelhead').after(controls);
  const suggestion=document.createElement('div');suggestion.id='bench-plan';suggestion.className='bench-plan';document.getElementById('craft-strip').before(suggestion);
  const intent=document.createElement('div');intent.id='reference-intents';intent.className='reference-owned';document.getElementById('reference-owned').after(intent);
  document.querySelector('.shoppingintro').textContent='×N = still missing from your queue, after your bench. Planned needs first.';
  document.querySelector('.shoppingfoot').textContent='★ Pin within planned needs or alternatives. Got one records a carousel pick.';
  document.querySelector('.loot-note p').textContent='A historical bag heuristic, not verified current-set odds. Used only after equally useful component choices and pins. It does not predict when another component will drop.';
  function signature(){
    const names=[...new Set([...state.queue.map(q=>q.champion),...Academy.snapshot.guides.map(g=>Academy.snapshot.champions.find(c=>c.apiName===g.mainChampion?.apiName)?.name)].filter(Boolean))];
    return JSON.stringify(state)+'|'+Academy.snapshot.updated+'|'+names.map(n=>{const d=MetaBuilds.dataFor({champion:n});return (d?.updated||0)+':'+(d?.fetchedAt||0);}).join(',');
  }
  function get(){const key=signature();if(key!==cacheKey){cacheKey=key;const groups=DecisionPlanner.groups(state);current={groups,craft:DecisionPlanner.solve(state,groups),carousel:DecisionPlanner.carousel(state,groups)};}return current;}
  const compactItem=(id)=>`<span class="decision-item" title="${esc(byId[id].name)}" aria-label="${esc(byId[id].name)}">${icon(id)}</span>`;
  function drawPlan(){
    const result=get().craft,crafts=result.actions.flatMap(a=>a.crafts.map(id=>({id,champion:a.choice.champion,source:a.choice.source})));
    suggestion.hidden=!crafts.length;
    suggestion.innerHTML=crafts.length?'<span class="decision-label">'+(state.tempo==='urgent'?'Strength now':'Good together')+'</span><div class="bench-plan-items">'+crafts.map(c=>`<span class="bench-plan-item">${compactItem(c.id)}<small>${c.champion?IconUI.championLabel(c.champion):esc(byId[c.id].name)}</small></span>`).join('')+'</div><button id="craft-plan" class="quiet">Mark made'+(crafts.length>1?' · '+crafts.length:'')+'</button>':'';
    // Inline suggestions are derived from the same compatible batch, rather
    // than independently proposing mutually exclusive replacement items.
    document.querySelectorAll('.inline-pivot').forEach(el=>el.remove());
    for(const action of result.actions.filter(a=>a.choice.source==='meta')){
      const first=DecisionPlanner.pending(state,action.choice.champion)[0];if(!first)continue;
      const card=[...document.querySelectorAll('#queue .qcard')].find(el=>el.querySelector('[data-action="remove"]')?.dataset.id===first.uid);if(!card)continue;
      const box=document.createElement('div');box.className='inline-pivot decision-pivot';
      box.innerHTML=`<span>Compatible ${esc(action.choice.tier)} pivot</span><div>${action.crafts.map(compactItem).join('')}</div><button data-batch-champion="${esc(action.choice.champion)}">Build & adjust</button>`;card.append(box);
    }
  }
  function carouselIcon(target){
    if(!target)return '';
    const label=byId[target.item].name+(target.champion?' · '+target.champion:'')+(target.tier?' · MetaTFT '+target.tier+' build':'');
    return `<span class="carousel-target" data-carousel-item="${esc(target.item)}" data-source="${esc(target.source)}" title="${esc(label)}" aria-label="${esc(label)}">${icon(target.item)}</span>`;
  }
  function drawCarousel(){
    const rows=get().carousel;
    const row=(r,n)=>{
      const target=r.targets?.[0]||r.pivotTargets?.[0];
      const label=r.count||r.discovery?'':r.pivot?'Pivot item':'Not needed';
      return `<div class="need decision-need ${state.pins.includes(r.id)?'pinned':''}"><span class="pick-rank">${n+1}</span>${icon(r.id)}<div class="needname">${esc(shortNames[r.id])} ${r.count?`<b class="component-shortage" aria-label="${r.count} still needed">×${r.count}</b>`:''}${label?`<span class="component-option">${label}</span>`:''}</div>${carouselIcon(target)}<button data-action="pin" data-id="${r.id}" class="pin" aria-pressed="${state.pins.includes(r.id)}" aria-label="Pin ${esc(byId[r.id].name)}">${state.pins.includes(r.id)?'★':'☆'}</button><button data-action="gain" data-id="${r.id}" class="got" aria-label="Got one ${esc(byId[r.id].name)} from carousel">+ Got one</button></div>`;
    };
    document.getElementById('shopping').innerHTML=rows.map(row).join('');
  }
  function drawIntents(){
    const name=MetaReference.selected(),ids=DecisionPlanner.commitments(state,name);
    intent.hidden=!ids.length;intent.innerHTML=ids.length?'<span>Pivot target</span>'+ids.map(compactItem).join('')+'<button id="clear-pivot-intent" class="quiet" aria-label="Release pivot target">×</button>':'';
  }
  function drawPivot(){
    document.getElementById('champion-pivot-title').innerHTML=IconUI.champion(pivotChampion)+'<span>Pivot '+esc(pivotChampion)+'</span>';
    const query=Academy.normalizeName(pivotQuery),rows=[];
    for(const i of DATA.items){if(!Academy.normalizeName(i.name).includes(query))continue;const choice=DecisionPlanner.pivot(state,pivotChampion,i.id);if(choice)rows.push({item:i,choice,ready:OfflineTracker.canCraft(state.owned,i)});}
    rows.sort((a,b)=>Number(b.ready)-Number(a.ready)||'SA'.indexOf(a.choice.tier)-'SA'.indexOf(b.choice.tier)||b.choice.score-a.choice.score||a.item.name.localeCompare(b.item.name));
    document.getElementById('champion-pivot-results').innerHTML=rows.map(({item:i,choice:b,ready})=>{
      const owned=state.queue.some(q=>q.done&&q.item===i.id&&!q.champion);
      return `<article class="decision-row"><div class="decision-primary">${icon(i.id)}<div><strong>${esc(i.name)}</strong><small>MetaTFT ${b.tier} · ${b.games.toLocaleString()} games</small></div></div><div class="pivot-combination">${b.items.map(id=>`<span class="${DecisionPlanner.equipped(state,pivotChampion).some(x=>Academy.itemMatches(id,x))?'is-equipped':''}">${compactItem(id)}</span>`).join('')}</div><div class="decision-actions"><button data-plan-pivot="${esc(i.id)}">Plan pivot</button>${ready?`<button data-build-pivot="${esc(i.id)}">Build now</button>`:''}${owned?`<button data-owned-pivot="${esc(i.id)}">Use owned</button>`:''}</div></article>`;
    }).join('')||'<p class="decision-note">No supported S/A combination contains that item alongside your completed items. Your current plan stays intact.</p>';
  }
  function openPivot(name){pivotChampion=name;pivotQuery='';document.getElementById('champion-pivot-search').value='';drawPivot();pivot.showModal();MetaBuilds.request(name);document.getElementById('champion-pivot-search').focus();}
  function draw(){
    for(const b of document.querySelectorAll('[data-tempo]'))b.setAttribute('aria-pressed',String(b.dataset.tempo===(state.tempo||'balanced')));
    drawPlan();drawCarousel();drawIntents();
    if(pivot.open)drawPivot();
  }
  document.getElementById('champion-pivot-search').addEventListener('input',e=>{pivotQuery=e.target.value;drawPivot();});
  document.addEventListener('click',e=>{
    let b=e.target.closest('[data-tempo]');if(b)mutate(()=>state.tempo=b.dataset.tempo,b.dataset.tempo==='urgent'?'Prioritizing useful crafts now.':'Balanced planning.');
    b=e.target.closest('#craft-plan');if(b){const result=get().craft;if(result.actions.length)mutate(()=>DecisionPlanner.execute(state,result),'Items recorded. Remaining targets updated; Undo restores the whole change.');}
    b=e.target.closest('[data-batch-champion]');if(b){const action=get().craft.actions.find(a=>a.choice.champion===b.dataset.batchChampion);if(action)mutate(()=>DecisionPlanner.execute(state,{actions:[action]}),'Pivot crafted and remaining targets adjusted.');}
    b=e.target.closest('[data-plan-pivot],[data-build-pivot],[data-owned-pivot]');if(b){const id=b.dataset.planPivot||b.dataset.buildPivot||b.dataset.ownedPivot,mode=b.dataset.buildPivot?'craft':b.dataset.ownedPivot?'owned':'plan';if(!DecisionPlanner.pivot(state,pivotChampion,id))return;let applied=false;mutate(()=>applied=DecisionPlanner.applyPivot(state,pivotChampion,id,mode),'Champion plan updated. Completed items kept.');if(applied){pivot.close();MetaReference.filter(id);drawIntents();}}
    b=e.target.closest('#clear-pivot-intent');if(b)mutate(()=>{delete state.pivotIntents?.[Academy.normalizeName(MetaReference.selected())];},'Pivot target released. Current queue kept.');

  });
  const oldRender=render;render=function(){oldRender();draw();};
  document.addEventListener('carousel-meta-updated',()=>{cacheKey='';draw();});
  document.addEventListener('carousel-new-game',()=>{pivot.close();cacheKey='';draw();});
  document.querySelector('#help ol').insertAdjacentHTML('beforeend','<li><b>Balanced / Need strength now:</b> one optional preference. Both compare compatible crafts across your whole bench. Strength now tolerates more deviation from Academy for immediate crafts. These are fit estimates, not win probabilities. Suggestions never rewrite your queue until you use a build/pivot action.</li><li><b>Good together:</b> a bounded search of Academy targets and supported MetaTFT S/A combinations. Mark made records the entire displayed combination and spends components once. Undo reverses the transaction. Manual Craft now shortcuts remain available.</li><li><b>Champion pivot:</b> open S/A builds from a champion, then Pivot to an item. Plan pivot preserves equipment and replaces unfinished targets with a compatible S/A combination. Build now also spends the recipe; Use owned assigns an unassigned completed copy. A pivot target stays locked until built, removed, or released.</li><li><b>Anvil choices:</b> scan ranked icons and record only the item selected. Holder names are suggestions; an exact queued target is completed, otherwise the item remains unassigned. Component anvils follow the carousel ranking and record Other automatically. Browse the full list or compare only your offers; entering offers does not add inventory.</li>');
  for(const li of document.querySelectorAll('#help li'))if(li.textContent.startsWith('Build instead'))li.textContent='Build & adjust beneath a queued champion shows a compatible S/A pivot from the whole-bench plan. It updates that champion’s unfinished targets together. Completed items stay; Undo restores the transaction.';
  render();return {openPivot,refresh:draw,get};
})();

</script><script>
/* Evidence-led offer comparison. Academy endorsements are the strongest signal.
   Description-based adjustments are explicitly local heuristics. Neither these
   scores nor the candidate catalog represent win rates or a reroll distribution. */
const AugmentAdvisor={
  stages:['2-1','3-2','4-2'],
  held(plan){return CompFinder.heldAugments(plan);},
  slots(plan){return [plan.firstAugment||plan.chosenAugments?.[0]||'',plan.chosenAugments?.[1]||'',plan.chosenAugments?.[2]||''];},
  ensure(plan){
    if(!plan.augmentOffers||!Array.isArray(plan.augmentOffers.ids))plan.augmentOffers={round:Math.max(0,this.slots(plan).findIndex(id=>!id)),ids:['','',''],seen:[]};
    return plan.augmentOffers;
  },
  eligible(a,round){return !a.stages?.length||a.stages.includes(this.stages[round]);},
  catalog(plan,round){const held=new Set(this.held(plan));return (Academy.snapshot.augments||[]).filter(a=>!held.has(a.apiName)&&this.eligible(a,round)).sort((a,b)=>a.name.localeCompare(b.name));},
  context(plan){
    const guide=Academy.guide(plan),ranked=CompFinder.ranked(plan),routes=ranked.filter(r=>!r.blocked).slice(0,8);
    const units=CompFinder.units(plan),pending=plan.queue.filter(q=>!q.done),done=plan.queue.filter(q=>q.done),needs=Tracker.allocate(plan,DATA.items).needs;
    return {plan,guide,ranked,routes,units,pending,done,needs,urgent:plan.tempo==='urgent',held:this.held(plan)};
  },
  evaluate(a,ctx,round){
    const {plan,guide,units,pending,done,needs,urgent,held}=ctx,reasons=[],links=[];let score=0,evidence=0,conflict=false;
    const add=(points,text)=>{score+=points;reasons.push({points,text});};
    if(held.includes(a.apiName))return {augment:a,score:-999,evidence:0,reasons:[{text:'Already selected'}],invalid:true};
    if(!this.eligible(a,round))return {augment:a,score:-999,evidence:0,reasons:[{text:'Not listed for this augment round'}],invalid:true};
    const endorses=g=>(g.augments||[]).some(x=>x.apiName===a.apiName)||g.mainAugment?.apiName===a.apiName;
    if(guide&&endorses(guide)){
      add(guide.mainAugment?.apiName===a.apiName?58:42,guide.mainAugment?.apiName===a.apiName?'Academy featured augment for your comp':'Academy recommends this for your comp');evidence=3;
    }else if(!guide){
      // Keep item/board fit dominant. An augment can also open a specifically
      // gated Academy route, without pretending any promised items are owned.
      const options=ctx.ranked.filter(r=>endorses(r.guide)&&(!r.blocked||r.missingAugment===a.apiName&&r.missingEmblems.length===0)).map(r=>({...r,adjusted:r.fitScore+(r.missingAugment===a.apiName?40:0)})).sort((a,b)=>b.adjusted-a.adjusted);
      if(options.length){
        const best=options[0],nearBest=ctx.routes[0]?.fitScore||0,closeness=Math.max(0,1-Math.max(0,nearBest-best.adjusted)/50);
        add(14+closeness*20,'Academy match: '+best.guide.title);evidence=2;links.push(best.guide);
        if(best.keepers.length||best.matched.length||best.specialMatches.length){add(Math.min(9,best.unitScore/6+best.itemScore/12),'That route fits your recorded units or completed items');}
      }
    }
    const text=a.description||'',lower=text.toLowerCase(),normal=Academy.normalizeName(text),style=(guide?.style||ctx.routes[0]?.guide.style||'').toLowerCase();
    // Explicit item names provide a narrow, auditable connection. No inferred
    // inventory grants; an offer and even a chosen augment are not receipts.
    const referenced=DATA.items.filter(i=>i.name.length>5&&normal.includes(Academy.normalizeName(i.name)));
    const ownedRefs=referenced.filter(i=>done.some(q=>Academy.itemMatches(i.id,q.item))),targetRefs=referenced.filter(i=>pending.some(q=>q.item===i.id));
    const reward=/\bgain\b|choose .*items?|item anvil/i.test(text),itemBuff=/grant|always give|permanently gain|holders|your .*gain/i.test(text);
    if(ownedRefs.length&&itemBuff){add(12,'Works with an item you already own');evidence=Math.max(evidence,1);}
    else if(targetRefs.length&&reward){add(9,'Mentions an item in your build queue');evidence=Math.max(evidence,1);}
    const componentAliases={BFSword:['bfsword'],RecurveBow:['recurvebow'],NeedlesslyLargeRod:['needlesslylargerod'],TearOfTheGoddess:['tearofthegoddess'],ChainVest:['chainvest'],NegatronCloak:['negatroncloak'],GiantsBelt:['giantsbelt'],SparringGloves:['sparringgloves']};
    const parts=Object.entries(componentAliases).filter(([id,aliases])=>needs[id]&&aliases.some(n=>normal.includes(n))).map(([id])=>id);
    if(parts.length&&reward){add(Math.min(10,parts.reduce((s,id)=>s+Math.min(3,needs[id].count)*3,0)),'Offers a component your current targets need');evidence=Math.max(evidence,1);}
    const reroll=/reroll/.test(style),leveling=/fast\s*[89]|fast\s*10/.test(style),shop=/shop (?:reroll|refresh)|free reroll/.test(lower),xp=/\bxp\b|level up/.test(lower);
    if(reroll&&shop){add(8,'Shop rerolls support your reroll route');evidence=Math.max(evidence,1);}
    if(leveling&&xp){add(8,'XP supports your leveling route');evidence=Math.max(evidence,1);}
    const unfinishedStars=units.some(u=>u.stars<3&&(guide?.finalComp||[]).some(c=>c.apiName===u.apiName&&c.stars===3));
    if(unfinishedStars&&/duplicator|shop reroll|free reroll/.test(lower)){add(5,'Helps pursue an unfinished star upgrade');evidence=Math.max(evidence,1);}
    const delayed=/after (?:\d+|every)|next \d+ rounds|every \d+ player|hatches in/.test(lower),immediateCombat=/^(?:your team|your units|allies|combat start|when an enemy dies)/i.test(text)&&/damage|attack speed|armor|magic resist|omnivamp|healed|shield|mana/.test(lower);
    if(urgent&&delayed&&!/\bnow\b/.test(lower)){add(-12,'Delayed payoff while you need strength now');conflict=true;evidence=Math.max(evidence,1);}
    if(urgent&&immediateCombat){add(7,'Combat effect supports strength now');evidence=Math.max(evidence,1);}
    // Broad repeated effects are noted, not treated as worthless duplicates.
    const prior=held.map(id=>CompFinder.augment(id)?.description||'').join(' ').toLowerCase();
    if(/omnivamp/.test(lower)&&/omnivamp/.test(prior)){add(-3,'Already have an Omnivamp augment; additional value may be smaller');}
    if(/after losing your combat/.test(lower)&&urgent){add(-8,'Rewards losses rather than immediate board strength');conflict=true;evidence=Math.max(evidence,1);}
    if(/cannot choose your carousel/.test(lower)&&Object.values(needs).reduce((s,n)=>s+n.count,0)>0){add(-8,'Gives up choosing the carousel components you need');conflict=true;evidence=Math.max(evidence,1);}
    if(/permanently transform/.test(lower)&&units.some(u=>u.stars>=2)){add(-10,'Transforms your recorded upgraded units');conflict=true;evidence=Math.max(evidence,1);}
    if(!reasons.length)reasons.push({points:0,text:'No specific match in the available data'});
    reasons.sort((a,b)=>Math.abs(b.points||0)-Math.abs(a.points||0));
    return {augment:a,score,evidence,conflict,reasons,links,items:[...new Set([...ownedRefs,...targetRefs].map(i=>i.id))],components:parts,invalid:false};
  },
  compare(plan,offers=this.ensure(plan)){
    const ctx=this.context(plan),round=offers.round,rows=offers.ids.map((id,slot)=>({a:CompFinder.augment(id),slot})).filter(x=>x.a).map(({a,slot})=>({...this.evaluate(a,ctx,round),slot})).sort((a,b)=>b.score-a.score||a.slot-b.slot);
    const valid=rows.filter(r=>!r.invalid),best=valid[0],seen=new Set([...offers.ids,...offers.seen,...ctx.held]);
    let action='enter',message='Enter your three offered augments.',reroll=null;
    if(best){
      const complete=offers.ids.every(Boolean)&&valid.length===3;
      const alternatives=this.catalog(plan,round).filter(a=>!seen.has(a.apiName)).map(a=>this.evaluate(a,ctx,round));
      // A same-rarity, same-stage fit comparison is not a claim the replacement
      // will appear. Missing annotations alone never justify a reroll.
      const weakest=[...valid].reverse().find(r=>r.evidence>0&&(r.conflict||r.score<20));
      const better=weakest&&alternatives.filter(r=>r.augment.tier===weakest.augment.tier&&r.evidence>=2&&r.score>=best.score+16&&r.score>=32).sort((a,b)=>b.score-a.score)[0];
      if(!complete){action='partial';message='Add all three offers to compare. Current best fit shown below.';}
      else if(best.score>=38&&best.evidence>=2){action='take';message='Take '+best.augment.name+' — strongest supported fit.';}
      else if(better&&weakest){action='reroll';reroll={slot:weakest.slot,example:better};message='Consider rerolling '+weakest.augment.name+' if available. Keep '+best.augment.name+' as your fallback.';}
      else if(best.evidence>0&&best.score>=8){action='lean';message='Lean '+best.augment.name+'. No strong reason to spend a reroll from the available data.';}
      else{action='unknown';message='No clear pick or reroll edge. Missing matches do not mean these augments are bad.';}
    }
    return {rows,best,action,message,reroll,round};
  },
  record(plan,slot){
    const offers=this.ensure(plan),id=offers.ids[slot],a=CompFinder.augment(id);
    if(!a||!this.eligible(a,offers.round)||this.held(plan).includes(id))return false;
    const selected=this.slots(plan);selected[offers.round]=id;plan.chosenAugments=selected;plan.firstAugment=selected[0];
    plan.augmentOffers={round:Math.min(2,offers.round+1),ids:['','',''],seen:[]};return true;
  }
};

</script><script>
const AugmentUI=(()=>{
  let activeSlot=0,query='',searchRows=[],searchIndex=0,result=null,contextKey='';
  const button=document.createElement('button');button.id='augment-open';button.textContent='Augment choices';document.querySelector('.decision-controls').append(button);
  const selected=document.createElement('div');selected.id='chosen-augments';selected.className='chosen-augments';document.querySelector('.decision-controls').after(selected);
  const modal=document.createElement('dialog');modal.id='augment-dialog';modal.setAttribute('aria-labelledby','augment-title');
  modal.innerHTML='<div class="modal-heading"><h2 id="augment-title">Choose your augment</h2><button data-close="augment-dialog" aria-label="Close augment chooser">×</button></div><div class="augment-stage" role="group" aria-label="Augment round"></div><div id="augment-verdict" role="status" aria-live="polite"></div><div class="augment-search-wrap"><label id="augment-search-label" for="augment-offer-search">Offer 1</label><input id="augment-offer-search" class="search" type="search" autocomplete="off" placeholder="Type a name, Enter → next offer" aria-controls="augment-search-results"><div id="augment-search-results" hidden></div></div><div id="augment-offers"></div><details class="augment-method"><summary>How this is compared</summary><p>Academy’s comp-specific recommendations lead. Your items, components, current units and stars inform nearby comp routes. Descriptions add smaller adjustments for matching items, leveling/reroll plans, previously chosen augments, and Need strength now. Existing MetaTFT item evidence contributes through comp fit; these are not MetaTFT augment statistics.</p><p>Reroll advice compares other known augments of the same rarity and round. It does not know your actual replacement pool or remaining rerolls. “No data” never means “bad.” Choosing an augment records it only; promised items and units are not added to inventory.</p><p id="augment-source"></p></details>';
  document.body.append(modal);
  const input=document.getElementById('augment-offer-search'),list=document.getElementById('augment-search-results');
  const badge=a=>['','Silver','Gold','Prismatic'][a.tier]||'Augment';
  function offers(){return AugmentAdvisor.ensure(state);}
  function getResult(){const key=JSON.stringify(state)+'|'+Academy.snapshot.updated+'|'+Academy.snapshot.augments.length;if(key!==contextKey){contextKey=key;result=AugmentAdvisor.compare(state);}return result;}
  function drawSelected(){const ids=AugmentAdvisor.slots(state);selected.hidden=!ids.some(Boolean);selected.innerHTML=ids.map((id,n)=>{const a=CompFinder.augment(id);if(!id)return '';return `<button data-edit-augment="${n}" title="${esc(a?.name||'Saved augment')} · ${AugmentAdvisor.stages[n]}" aria-label="Review ${esc(a?.name||'saved augment')} at ${AugmentAdvisor.stages[n]}">${CompFinder.augmentIcon(id)}<span>${esc(a?.name||'Saved augment')}</span><small>${AugmentAdvisor.stages[n]}</small></button>`;}).join('');}
  function search(){
    const o=offers(),norm=Academy.normalizeName(query);list.hidden=!norm;
    searchRows=norm?AugmentAdvisor.catalog(state,o.round).filter(a=>!o.ids.includes(a.apiName)&&Academy.normalizeName(a.name).includes(norm)).sort((a,b)=>Number(!Academy.normalizeName(a.name).startsWith(norm))-Number(!Academy.normalizeName(b.name).startsWith(norm))||a.name.localeCompare(b.name)).slice(0,7):[];
    searchIndex=Math.max(0,Math.min(searchIndex,searchRows.length-1));
    list.innerHTML=searchRows.map((a,n)=>`<button class="${n===searchIndex?'search-active':''}" data-offer-add="${esc(a.apiName)}" title="${esc(a.description)}">${CompFinder.augmentIcon(a.apiName)}<span><strong>${esc(a.name)}</strong><small>${esc(a.description)}</small></span><b class="augment-rarity rarity-${a.tier}">${badge(a)}</b></button>`).join('')||'<p>No match for this round. Check the round or try another part of the name.</p>';
  }
  function draw(){
    drawSelected();if(!modal.open)return;
    const o=offers(),comparison=getResult(),logged=AugmentAdvisor.slots(state)[o.round];
    modal.querySelector('.augment-stage').innerHTML=AugmentAdvisor.stages.map((s,n)=>`<button data-augment-round="${n}" aria-pressed="${o.round===n}">${n+1}${['st','nd','rd'][n]} · ${s}${AugmentAdvisor.slots(state)[n]?' ✓':''}</button>`).join('');
    const verdict=document.getElementById('augment-verdict');verdict.dataset.action=comparison.action;verdict.textContent=comparison.message;
    if(comparison.reroll){const hint=document.createElement('small');hint.textContent='Stronger same-rarity fits exist in the catalog; their appearance is not guaranteed.';verdict.append(hint);}
    if(logged){const hint=document.createElement('small');hint.textContent='This round is already recorded. Taking a different augment replaces that record.';verdict.append(hint);}
    document.getElementById('augment-search-label').textContent='Offer '+(activeSlot+1)+' · type a few letters, Enter';
    document.getElementById('augment-offers').innerHTML=o.ids.map((id,slot)=>{
      const a=CompFinder.augment(id),r=comparison.rows.find(r=>r.slot===slot),best=comparison.best?.slot===slot&&['take','lean'].includes(comparison.action),reroll=comparison.reroll?.slot===slot;
      if(!a)return `<article class="augment-offer empty-offer ${slot===activeSlot?'active-slot':''}"><button data-offer-edit="${slot}"><span>${slot+1}</span>${id?'Augment unavailable · replace offer':'Add offer '+(slot+1)}</button></article>`;
      const name=`<span>${CompFinder.augmentIcon(id)}<strong>${esc(a.name)}</strong></span>`;
      return `<article class="augment-offer ${slot===activeSlot?'active-slot':''} ${best?'best-offer':''}"><div class="augment-offer-heading"><button data-offer-edit="${slot}" aria-label="Change offer ${slot+1}: ${esc(a.name)}">${name}</button><span class="augment-rarity rarity-${a.tier}">${badge(a)}</span><button class="quiet" data-offer-replace="${slot}">Enter reroll</button></div><div class="augment-fit-label">${best?'Best supported pick':reroll?'Consider reroll · if available':r?.invalid?'Check offer':r?.evidence?'Contextual fit':'Limited evidence'}</div><div class="augment-reasons">${(r?.reasons||[]).slice(0,2).map(x=>`<span>${esc(x.text)}</span>`).join('')}</div>${r?.items?.length?'<div class="augment-related">'+r.items.slice(0,3).map(id=>`<span title="${esc(byId[id].name)}">${icon(id)}</span>`).join('')+'</div>':''}<details class="augment-description"><summary>Effect</summary><p>${esc(a.description)}</p></details><button class="augment-take" data-augment-take="${slot}" ${r?.invalid?'disabled':''}>Took this</button></article>`;
    }).join('');
    document.getElementById('augment-source').textContent='Academy snapshot: '+(Academy.snapshot.updated?new Date(Academy.snapshot.updated).toLocaleDateString():'bundled data')+'. Refreshes with the app’s Academy data.';
    search();
  }
  function open(round){offers();if(Number.isInteger(round)&&state.augmentOffers.round!==round){state.augmentOffers={round,ids:['','',''],seen:[]};save();}activeSlot=Math.max(0,offers().ids.findIndex(id=>!id));query='';input.value='';contextKey='';modal.showModal();draw();input.focus();}
  function add(id){
    const o=offers(),a=CompFinder.augment(id);if(!a||!AugmentAdvisor.eligible(a,o.round)||o.ids.includes(id)||AugmentAdvisor.held(state).includes(id))return;
    const slot=activeSlot;query='';input.value='';searchIndex=0;
    mutate(()=>{offers().ids[slot]=id;},'Offer '+(slot+1)+' entered.');
    const next=offers().ids.findIndex((id,n)=>n>slot&&!id);activeSlot=next>=0?next:Math.max(0,offers().ids.findIndex(id=>!id));draw();input.focus();
  }
  button.addEventListener('click',()=>open());
  input.addEventListener('input',e=>{query=e.target.value;searchIndex=0;search();});
  input.addEventListener('keydown',e=>{if(e.key==='Enter'&&searchRows[searchIndex]){e.preventDefault();add(searchRows[searchIndex].apiName);}else if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();searchIndex+=e.key==='ArrowDown'?1:-1;search();}else if(e.key==='Escape'&&query){e.preventDefault();e.stopPropagation();query='';input.value='';search();}});
  document.addEventListener('click',e=>{
    let b=e.target.closest('[data-offer-add]');if(b)add(b.dataset.offerAdd);
    b=e.target.closest('[data-edit-augment]');if(b)open(Number(b.dataset.editAugment));
    b=e.target.closest('[data-augment-round]');if(b){const round=Number(b.dataset.augmentRound);if(round===offers().round)return;query='';input.value='';activeSlot=0;mutate(()=>state.augmentOffers={round,ids:['','',''],seen:[]},'Augment round changed.');input.focus();}
    b=e.target.closest('[data-offer-edit]');if(b){activeSlot=Number(b.dataset.offerEdit);query='';input.value='';draw();input.focus();}
    b=e.target.closest('[data-offer-replace]');if(b){activeSlot=Number(b.dataset.offerReplace);query='';input.value='';mutate(()=>{const o=offers(),id=o.ids[activeSlot];if(id&&!o.seen.includes(id))o.seen.push(id);o.ids[activeSlot]='';},'Enter the new offer after rerolling in game.');input.focus();}
    b=e.target.closest('[data-augment-take]');if(b){let recorded=false;mutate(()=>{recorded=AugmentAdvisor.record(state,Number(b.dataset.augmentTake));},'Augment recorded. Enter any item rewards when received.');if(recorded)modal.close();}
  });
  const previous=render;render=function(){previous();contextKey='';draw();};
  document.addEventListener('carousel-new-game',()=>{modal.close();query='';input.value='';contextKey='';drawSelected();});
  document.addEventListener('carousel-meta-updated',()=>{contextKey='';draw();});
  document.querySelector('#help ol').insertAdjacentHTML('beforeend','<li><b>Augment choices:</b> type a few letters and Enter for each of the three offers. Entry advances automatically. The round defaults to your next unrecorded augment; change it if needed. Took this records the selected augment, keeps your inventory untouched and updates comp fit. Enter reroll replaces only that offer after you reroll in game. Reroll guidance is conditional; the app does not know the replacement pool or rerolls left.</li>');
  drawSelected();return {open,refresh:draw};
})();

</script><script>
/* Anvil entry is offer selection only. Inventory changes only on Took this.
   Numeric shortcuts are scoped to the topmost component-anvil dialog. */
const AnvilUI=(()=>{
  const types=[['components','Components'],['ornns','Artifacts'],['craftables','Completed'],['radiants','Radiant'],['emblems','Emblems']];
  let type='ornns',mode='browse',query='',rows=[],matches=[],searchIndex=0,offers={};
  const modal=document.createElement('dialog');modal.id='anvil-dialog';modal.setAttribute('aria-labelledby','anvil-dialog-title');
  modal.innerHTML='<div class="modal-heading"><h2 id="anvil-dialog-title">Anvil choices</h2><button data-close="anvil-dialog" aria-label="Close anvil choices">×</button></div><div id="anvil-tabs" class="decision-tabs" role="group" aria-label="Anvil item category"></div><div class="anvil-mode" role="group" aria-label="Browse or compare anvil offers"><button data-anvil-mode="browse">Full priority list</button><button data-anvil-mode="compare">My offers</button></div><p id="anvil-instructions" class="decision-note"></p><div id="anvil-component-keys" class="anvil-component-keys" hidden></div><div class="anvil-search-wrap"><label for="anvil-search" class="visuallyhidden">Find an offered item</label><input id="anvil-search" class="search" type="search" autocomplete="off" placeholder="Find an offered item…"><div id="anvil-search-matches" hidden></div></div><div id="anvil-offer-chips" class="anvil-offer-chips"></div><div id="anvil-verdict" role="status" aria-live="polite"></div><div id="anvil-results" class="decision-list"></div>';
  document.body.append(modal);
  const input=document.getElementById('anvil-search'),searchList=document.getElementById('anvil-search-matches');
  const picked=()=>offers[type]||[];
  function setQuery(q=''){query=q;input.value=q;searchIndex=0;}
  function matchesQuery(r,q){return Academy.normalizeName(r.item.name).includes(q)||Academy.normalizeName(shortNames[r.item.id]||'').includes(q);}
  function addOffer(id){
    if(!rows.some(r=>r.item.id===id)||picked().includes(id))return;
    offers[type]=[...picked(),id];mode='compare';setQuery();draw();input.focus();
  }
  function removeOffer(id){offers[type]=picked().filter(x=>x!==id);draw();}
  function drawSearch(){
    const q=Academy.normalizeName(query),available=rows.filter(r=>!picked().includes(r.item.id)&&matchesQuery(r,q));
    matches=q?available.sort((a,b)=>Number(!Academy.normalizeName(a.item.name).startsWith(q))-Number(!Academy.normalizeName(b.item.name).startsWith(q))).slice(0,7):[];
    searchIndex=Math.max(0,Math.min(searchIndex,matches.length-1));
    searchList.hidden=mode!=='compare'||!q;
    searchList.innerHTML=matches.map((r,n)=>`<button class="${n===searchIndex?'search-active':''}" data-anvil-offer-add="${esc(r.item.id)}">${icon(r.item.id)}<span>${esc(r.item.name)}</span><small>Add offer ↵</small></button>`).join('')||'<p>No new match in this category.</p>';
  }
  function draw(recalculate=false){
    if(recalculate)rows=DecisionPlanner.anvil(state,type);
    // A refresh can remove items from a set; never record a stale offer.
    offers[type]=picked().filter(id=>rows.some(r=>r.item.id===id));
    document.getElementById('anvil-tabs').innerHTML=types.map(([id,name])=>`<button data-anvil-type="${id}" aria-pressed="${type===id}">${name}</button>`).join('');
    for(const b of modal.querySelectorAll('[data-anvil-mode]'))b.setAttribute('aria-pressed',String(mode===b.dataset.anvilMode));
    input.placeholder=mode==='compare'?'Type an offer, Enter → add the next…':'Find an offered item… Enter adds to My offers';
    document.getElementById('anvil-instructions').textContent=mode==='compare'?'Enter the options shown in game. Use a take button to add it to inventory.':'Pick the highest-ranked item you see in game, or enter offers to compare.';
    const keys=document.getElementById('anvil-component-keys');keys.hidden=type!=='components';
    keys.innerHTML=type==='components'?'<small>1–8 add offers · Shift + number removes · no inventory changes</small><div>'+componentOrder.slice(0,8).map((id,n)=>`<button data-component-offer="${id}" aria-pressed="${picked().includes(id)}" aria-label="${n+1}: ${esc(byId[id].name)} ${picked().includes(id)?'offered, click to remove':'add offer'}"><kbd>${n+1}</kbd>${icon(id)}<span>${esc(shortNames[id])}</span></button>`).join('')+'</div>':'';
    document.getElementById('anvil-offer-chips').innerHTML=mode==='compare'?picked().map(id=>`<button data-anvil-offer-remove="${esc(id)}" title="Remove ${esc(byId[id].name)} from offers" aria-label="Remove offered ${esc(byId[id].name)}">${icon(id)}<span>${esc(byId[id].name)}</span><b>×</b></button>`).join('')+(picked().length?'<button id="anvil-clear-offers" class="quiet">Clear offers</button>':''):'';
    const q=Academy.normalizeName(query),visible=mode==='compare'?rows.filter(r=>picked().includes(r.item.id)):rows.filter(r=>matchesQuery(r,q));
    const ranked=[...visible]; // model order (including pins) is authoritative
    const best=ranked[0],second=ranked[1];
    const supported=best&&(best.component?best.score>0||state.pins.includes(best.item.id):best.score>0);
    const tied=second&&best.score===second.score&&(!best.component||(!!best.count===!!second.count&&(!best.count||best.carrierRank===second.carrierRank)&&state.pins.includes(best.item.id)===state.pins.includes(second.item.id)));
    let verdict='';
    if(mode==='compare')verdict=!ranked.length?'Add your offers to compare.':ranked.length===1?'1 offer entered — add the others to compare.':!supported?'No supported preference among these offers.':tied?'Top options are similarly supported.':'';
    document.getElementById('anvil-verdict').textContent=verdict;
    document.getElementById('anvil-verdict').hidden=!verdict;
    document.getElementById('anvil-results').innerHTML=ranked.map((r,n)=>{
      const recommended=mode==='compare'&&ranked.length>1&&n===0&&supported&&!tied;
      const count=r.component?(r.count?`<b class="component-shortage">×${r.count} needed</b>`:'<small>No queued need</small>'):'';
      const tag=r.component&&state.pins.includes(r.item.id)?'<span class="anvil-recommended">Pinned priority</span>':'';
      return `<article class="decision-row anvil-row ${r.score>0?'supported':''} ${recommended?'recommended-offer':''}">${recommended?'<span class="anvil-pick-check" role="img" aria-label="Recommended choice"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></span>':`<span class="anvil-rank">${n+1}</span>`}<div class="decision-primary">${icon(r.item.id)}<div><strong>${esc(r.item.name)}</strong>${count}<small>${esc(r.reason)}</small>${tag}</div></div><div class="anvil-fit">${r.champion?IconUI.championLabel(r.champion):''}${!state.activeComp&&r.guide?'<small>'+esc(r.guide.title)+'</small>':''}</div>${mode==='browse'?`<button class="anvil-compare-add" data-anvil-offer-add="${esc(r.item.id)}" aria-label="Add ${esc(r.item.name)} to offers">+ Offer</button>`:''}<button data-take-anvil="${esc(r.item.id)}" ${r.component&&(state.owned[r.item.id]||0)>=99?'disabled':''} aria-label="${recommended?'Recommended: take':'Record'} ${esc(r.item.name)} from anvil">${recommended?'Take this':'Took this'}</button></article>`;
    }).join('')||(mode==='compare'?'':'<p class="decision-note">No matching items.</p>');
    drawSearch();
  }
  function open(){setQuery();draw(true);modal.showModal();if(type!=='components')input.focus();}
  document.getElementById('anvil-open').addEventListener('click',open);
  input.addEventListener('input',e=>{query=e.target.value;searchIndex=0;draw();});
  input.addEventListener('keydown',e=>{
    if(e.key==='Enter'&&matches[searchIndex]){e.preventDefault();addOffer(matches[searchIndex].item.id);}
    else if(mode==='compare'&&(e.key==='ArrowDown'||e.key==='ArrowUp')){e.preventDefault();searchIndex+=e.key==='ArrowDown'?1:-1;drawSearch();}
    else if(e.key==='Escape'&&query){e.preventDefault();e.stopPropagation();setQuery();draw();}
  });
  modal.addEventListener('click',e=>{
    let b=e.target.closest('[data-anvil-type]');if(b){type=b.dataset.anvilType;setQuery();draw(true);}
    b=e.target.closest('[data-anvil-mode]');if(b){mode=b.dataset.anvilMode;setQuery();draw();if(type!=='components')input.focus();}
    b=e.target.closest('[data-anvil-offer-add]');if(b)addOffer(b.dataset.anvilOfferAdd);
    b=e.target.closest('[data-anvil-offer-remove]');if(b)removeOffer(b.dataset.anvilOfferRemove);
    b=e.target.closest('#anvil-clear-offers');if(b){offers[type]=[];draw();}
    b=e.target.closest('[data-component-offer]');if(b){const id=b.dataset.componentOffer;if(picked().includes(id))removeOffer(id);else addOffer(id);}
    b=e.target.closest('[data-take-anvil]');if(b&&!b.disabled){const row=rows.find(r=>r.item.id===b.dataset.takeAnvil);if(!row)return;
      const component=!!row.component;mutate(()=>DecisionPlanner.receiveAnvil(state,row),component?row.item.name+' received from anvil.':row.item.name+' received; loose components kept.');
      offers={};mode='browse';setQuery();modal.close();
    }
  });
  document.addEventListener('keydown',e=>{
    if(!modal.open||type!=='components'||e.defaultPrevented||e.repeat||e.isComposing||e.ctrlKey||e.metaKey||e.altKey)return;
    const dialogs=[...document.querySelectorAll('dialog[open]')];if(dialogs[dialogs.length-1]!==modal)return;
    const match=/^(?:Digit|Numpad)([1-8])$/.exec(e.code||'');if(!match)return;
    if(document.activeElement===input&&query.trim())return;
    e.preventDefault();const id=componentOrder[Number(match[1])-1];if(e.shiftKey)removeOffer(id);else addOffer(id);
  });
  const previous=render;render=function(){previous();if(modal.open)draw(true);};
  document.addEventListener('carousel-meta-updated',()=>{if(modal.open)draw(true);});
  document.addEventListener('carousel-new-game',()=>{modal.close();offers={};mode='browse';setQuery();});
  document.querySelector('#help ol').insertAdjacentHTML('beforeend','<li><b>Anvil offers:</b> keep the full priority list, or switch to My offers. Type a few letters and Enter for each option; the chosen offers are ranked automatically. Component anvils also use the displayed 1–8 keys (Shift removes an offer). These keys only enter offers inside that dialog. Took this adds exactly one selected item; component anvils are recorded as Other, not PvE. Closing and reopening keeps unfinished offers; taking an item clears them.</li><li><b>Carousel counts:</b> ×N is the number still missing from your current queue after using your loose bench components. Planned needs rank before alternatives. Pivot item means a component supports a suggested alternative build; Not needed means no current queue shortage or supported pivot. Pins move components within these priority groups. The single item icon shows the highest-priority planned target, or the top compatible pivot when there is no planned need. Completed copies and loose components are already accounted for.</li>');
  return {open,refresh:()=>draw(true)};
})();

</script><script>
/* One header, compact controls, and pointer/keyboard sorting without inventory edits. */
(()=>{
  const top=document.querySelector('.topright'),actions=document.querySelector('.actions');
  const help=top.querySelector('[data-action="help"]'),settings=document.getElementById('settings-open');
  const menu=document.createElement('details');menu.id='utility-menu';menu.className='utility-menu';
  menu.innerHTML='<summary aria-label="More options" title="More options">⋯</summary><div class="utility-options"></div>';
  menu.querySelector('.utility-options').append(help,settings);actions.append(menu);top.append(actions);document.querySelector('.pagehead').remove();
  menu.addEventListener('click',e=>{if(e.target.closest('button'))menu.removeAttribute('open');});
  document.addEventListener('click',e=>{if(!menu.contains(e.target))menu.removeAttribute('open');});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu.open){menu.removeAttribute('open');menu.querySelector('summary').focus();}});
  document.getElementById('academy-tierlist').addEventListener('click',e=>{e.preventDefault();MetaReference.openPage('https://tftacademy.com/tierlist/comps','TFT Academy tierlist');});
  const reset=document.createElement('button');reset.id='reset-queue-order';reset.className='quiet';reset.textContent='Reset order';reset.title='Restore recommended order; keep current targets and inventory';
  document.querySelector('.queuehead').insertBefore(reset,document.getElementById('receive-open'));
  const queue=document.getElementById('queue');
  queue.insertAdjacentHTML('beforebegin','<span id="queue-drag-help" class="visuallyhidden">Drag to reorder. Keyboard: Space to pick up, arrows to move, Enter to drop, Escape to cancel.</span><span id="queue-sort-status" class="visuallyhidden" role="status" aria-live="polite"></span>');
  const announce=text=>document.getElementById('queue-sort-status').textContent=text;
  let drag=null,frame=0;
  const cards=()=>[...queue.querySelectorAll('.qcard')];
  const cardFor=uid=>cards().find(c=>c.dataset.queueUid===uid);
  function stop(){
    if(frame&&typeof cancelAnimationFrame==='function')cancelAnimationFrame(frame);frame=0;
    if(drag){drag.card.classList.remove('queue-dragging');drag.card.querySelector('.queue-grip')?.setAttribute('aria-pressed','false');try{drag.handle?.releasePointerCapture(drag.pointer);}catch(e){}}
    drag=null;queue.classList.remove('is-sorting');
  }
  function begin(card,fields={}){
    if(drag||document.querySelector('dialog[open]'))return;
    drag={card,uid:card.dataset.queueUid,active:false,...fields};
  }
  function activate(){if(!drag||drag.active)return;drag.active=true;queue.classList.add('is-sorting');drag.card.classList.add('queue-dragging');drag.card.querySelector('.queue-grip').setAttribute('aria-pressed','true');announce('Moving '+byId[state.queue.find(q=>q.uid===drag.uid).item].name);}
  function preview(y){
    if(!drag?.active)return;
    const other=cards().filter(c=>c!==drag.card),before=other.find(c=>{const r=c.getBoundingClientRect();return y<r.top+r.height/2;});
    if(drag.card.nextElementSibling!==before&&(before||queue.lastElementChild!==drag.card))queue.insertBefore(drag.card,before||null);
  }
  function scrollTick(){
    if(!drag?.active||drag.keyboard){frame=0;return;}
    const height=window.innerHeight||document.documentElement.clientHeight,edge=65,y=drag.y;
    const amount=y<edge?-Math.ceil((edge-y)/5):y>height-edge?Math.ceil((y-height+edge)/5):0;
    if(amount&&typeof window.scrollBy==='function'){window.scrollBy(0,Math.max(-20,Math.min(20,amount)));preview(y);}
    if(typeof requestAnimationFrame==='function')frame=requestAnimationFrame(scrollTick);
  }
  function finish(commit){
    if(!drag)return;const {uid,active}=drag,ids=cards().map(c=>c.dataset.queueUid);stop();
    const current=QueueOrder.pending(state).map(q=>q.uid);
    if(commit&&active&&ids.length===current.length&&ids.some((id,n)=>id!==current[n]))mutate(()=>QueueOrder.apply(state,ids),'Queue reordered.');else render();
    cardFor(uid)?.querySelector('.queue-grip')?.focus({preventScroll:true});announce(commit&&active?'Queue order saved.':'Reorder cancelled.');
  }
  reset.addEventListener('click',()=>mutate(()=>QueueOrder.reset(state),'Recommended order restored.'));
  queue.addEventListener('pointerdown',e=>{
    if(e.button!==0||e.isPrimary===false)return;
    const card=e.target.closest('.qcard'),handle=e.target.closest('.queue-grip');
    if(!card||(!handle&&(e.pointerType!=='mouse'||!e.target.closest('.qtop')||e.target.closest('button,a,input'))))return;
    begin(card,{pointer:e.pointerId,handle:handle||card,startX:e.clientX,startY:e.clientY,y:e.clientY});
    if(!drag)return;e.preventDefault();(handle||card).focus?.({preventScroll:true});try{(handle||card).setPointerCapture(e.pointerId);}catch(error){}
  });
  document.addEventListener('pointermove',e=>{
    if(!drag||drag.keyboard||drag.pointer!==e.pointerId)return;
    if(!drag.active&&Math.hypot(e.clientX-drag.startX,e.clientY-drag.startY)<6)return;
    e.preventDefault();activate();drag.y=e.clientY;preview(e.clientY);if(!frame&&typeof requestAnimationFrame==='function')frame=requestAnimationFrame(scrollTick);
  },{passive:false});
  document.addEventListener('pointerup',e=>{if(drag&&!drag.keyboard&&drag.pointer===e.pointerId){e.preventDefault();finish(true);}});
  document.addEventListener('pointercancel',e=>{if(drag&&drag.pointer===e.pointerId)finish(false);});
  queue.addEventListener('dragstart',e=>e.preventDefault());
  queue.addEventListener('keydown',e=>{
    const handle=e.target.closest('.queue-grip');if(!handle)return;
    if(!drag&&(e.key===' '||e.key==='Enter')){e.preventDefault();begin(handle.closest('.qcard'),{keyboard:true});activate();return;}
    if(!drag?.keyboard)return;
    if(e.key==='Escape'){e.preventDefault();finish(false);return;}
    if(e.key===' '||e.key==='Enter'){e.preventDefault();finish(true);return;}
    if(['ArrowUp','ArrowDown','Home','End'].includes(e.key)){
      e.preventDefault();const list=cards(),at=list.indexOf(drag.card),to=e.key==='Home'?0:e.key==='End'?list.length-1:Math.max(0,Math.min(list.length-1,at+(e.key==='ArrowUp'?-1:1)));
      if(to!==at){const other=list.filter(c=>c!==drag.card);queue.insertBefore(drag.card,other[to]||null);drag.card.querySelector('.queue-grip').focus({preventScroll:true});drag.card.scrollIntoView?.({block:'nearest'});announce('Position '+(to+1)+' of '+list.length);}
    }
  });
  document.addEventListener('keydown',e=>{if(drag&&e.key==='Escape'){e.preventDefault();finish(false);}});
  const previous=render;render=function(){if(drag)stop();previous();const pending=QueueOrder.pending(state),recommended=QueueOrder.recommended(state);reset.disabled=pending.every((q,n)=>q.uid===recommended[n]?.uid);};
  render();
})();

</script></body></html>
