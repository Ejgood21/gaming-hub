,"games":84,"avg":4.571,"score":-0.05157,"tier":"D"},{"items":["DA_Deathblade","DA_Deathblade","DA_SpearOfShojin"],"games":34,"avg":4.559,"score":-0.0546,"tier":"D"},{"items":["DA_GiantSlayer","DA_InfinityEdge","DA_LastWhisper"],"games":73,"avg":4.589,"score":-0.05546,"tier":"D"},{"items":["DA_GuinsoosRageblade","DA_JeweledGauntlet","DA_StrikersFlail"],"games":73,"avg":4.575,"score":-0.05869,"tier":"D"},{"items":["DA_GuinsoosRageblade","DA_LastWhisper","DA_SpearOfShojin"],"games":58,"avg":4.586,"score":-0.06039,"tier":"D"},{"items":["DA_Deathblade","DA_GuinsoosRageblade","DA_LastWhisper"],"games":39,"avg":4.692,"score":-0.06546,"tier":"D"},{"items":["DA_GuinsoosRageblade","DA_GuinsoosRageblade","DA_SpearOfShojin"],"games":34,"avg":4.706,"score":-0.06945,"tier":"D"},{"items":["DA_Component_SparringGloves","DA_RedBuff","DA_SpearOfShojin"],"games":33,"avg":4.727,"score":-0.07178,"tier":"D"},{"items":["DA_Component_BFSword","DA_GuinsoosRageblade","DA_InfinityEdge"],"games":34,"avg":4.794,"score":-0.07569,"tier":"D"},{"items":["DA_JeweledGauntlet","DA_NashorsTooth","DA_NashorsTooth"],"games":83,"avg":4.663,"score":-0.07605,"tier":"D"},{"items":["DA_GuinsoosRageblade","DA_SpearOfShojin","DA_StrikersFlail"],"games":47,"avg":4.723,"score":-0.07955,"tier":"D"},{"items":["DA_ArchangelsStaff","DA_ArchangelsStaff","DA_ArchangelsStaff"],"games":58,"avg":4.897,"score":-0.10496,"tier":"D"},{"items":["DA_GuinsoosRageblade","DA_GuinsoosRageblade","DA_InfinityEdge"],"games":86,"avg":4.872,"score":-0.10999,"tier":"D"},{"items":["DA_BlueBuff","DA_GuinsoosRageblade","DA_JeweledGauntlet"],"games":106,"avg":4.821,"score":-0.11465,"tier":"D"},{"items":["DA_Component_TearOfTheGoddess","DA_InfinityEdge","DA_RedBuff"],"games":35,"avg":5.257,"score":-0.12724,"tier":"D"},{"items":["DA_Morellonomicon","DA_RabadonsDeathcap","DA_VoidStaff"],"games":30,"avg":5.4,"score":-0.13921,"tier":"D"},{"items":["DA_Component_BFSword","DA_InfinityEdge","DA_SpearOfShojin"],"games":44,"avg":5.591,"score":-0.18197,"tier":"D"},{"items":["DA_GuinsoosRageblade","DA_InfinityEdge","DA_KrakensFury"],"games":239,"avg":4.895,"score":-0.18753,"tier":"D"},{"items":["DA_Deathblade","DA_GuinsoosRageblade","DA_KrakensFury"],"games":180,"avg":5.183,"score":-0.25316,"tier":"D"},{"items":["DA_Component_RecurveBow","DA_InfinityEdge","DA_SpearOfShojin"],"games":158,"avg":5.259,"score":-0.25712,"tier":"D"},{"items":["DA_InfinityEdge","DA_SpearOfShojin","DA_SteraksGage"],"games":52,"avg":6.058,"score":-0.26444,"tier":"D"}],"rankFilter":"ALL"}]};

