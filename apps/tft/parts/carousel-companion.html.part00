.picker-label,.picker-caption{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:13px;color:var(--muted)}.picker-label button{font-size:12px;padding:4px 7px;background:transparent}.component-picker{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:5px;margin:10px 0}.base-filter{padding:4px;display:grid;place-items:center;min-height:40px;background:#101920;border-color:#36424b}.base-filter .icon{width:29px;height:29px;border:0}.base-filter.all{font-size:13px}.base-filter[aria-pressed=true]{background:#284b38;border:2px solid var(--green);padding:3px}.picker-caption{font-size:12px}.item-preview{min-height:66px;margin-top:12px;padding-top:10px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:5px}.item-preview strong{font-size:14px;line-height:1.25}.item-preview>span{display:flex;gap:5px;align-items:center;font-size:12px;color:var(--muted);flex-wrap:wrap}.item-preview .icon{width:21px;height:21px;border-radius:3px}.item-preview b{font-weight:400;color:#7a8993}.fast-catalog{display:grid!important;grid-template-columns:repeat(auto-fill,minmax(47px,1fr))!important;gap:7px;max-height:495px;align-content:start}.quick-item{position:relative;display:flex;align-items:center;justify-content:center;padding:5px;aspect-ratio:1;border:1px solid transparent;background:#1d2931;min-width:0;border-radius:7px}.quick-item>.icon{width:100%;height:auto;max-width:46px;aspect-ratio:1;border-color:#635a48}.quick-item:hover,.quick-item:focus-visible{border-color:var(--green);background:#284137}.quick-count{position:absolute;right:0;top:0;min-width:19px;font-size:12px;padding:0 3px;line-height:19px;text-align:center;border-radius:4px;background:#a2e6bb;color:#153321;border:1px solid #17261c}.fast-catalog.with-names{grid-template-columns:repeat(2,minmax(0,1fr))!important}.with-names .quick-item{aspect-ratio:auto;gap:8px;justify-content:flex-start;padding:8px;min-height:63px;text-align:left}.with-names .quick-item>.icon{width:32px;flex:0 0 32px}.with-names .quick-item>span{font-size:13px;line-height:1.3}.catalogfoot{font-size:12px}.pivot-section{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-top:22px;padding:17px 18px;border-color:#4d5546;background:#1b2828}.pivot-section .eyebrow{color:var(--gold);font-size:11px}.pivot-section h2{font-size:18px;margin-top:4px}.pivot-section p{font-size:13px;color:var(--muted);margin-top:5px}.pivot-section button{font-size:14px;white-space:nowrap;border-color:#637257;background:#2b3b31}.pivot-trigger{padding:5px 9px;font-size:13px;background:transparent;color:var(--gold);margin-right:auto}.qbottom{gap:7px}.rankbtns{flex-shrink:0}.qbottom .make{font-size:13px}#pivot-dialog{width:760px;max-width:calc(100vw - 32px);max-height:calc(100vh - 36px);padding:24px;overflow:auto}#pivot-dialog .eyebrow{color:var(--gold)}.pivot-dialog-head{display:flex;justify-content:space-between;align-items:start;gap:15px;margin-bottom:20px}.pivot-dialog-head h2{margin:4px 0 0;font-size:25px}.pivot-dialog-head>button{padding:2px 11px;font-size:25px;background:transparent}.pivot-target{border:1px solid var(--line);border-radius:8px;background:#101b22;padding:14px}.pivot-target label,.pivot-options label{font-size:13px;color:var(--muted);display:block;margin-bottom:6px}#pivot-target,#pivot-role{background:#233039;color:var(--text);border:1px solid #42525a;border-radius:5px;padding:9px 12px;font-size:14px;width:100%}#pivot-original{display:flex;gap:10px;align-items:center;margin-top:12px}#pivot-original small{display:block;margin-top:3px;font-size:12px;color:#a8b9b5}#pivot-original>span{font-size:15px}.pivot-options{margin-top:15px}.avoid-field{border:0;padding:0;margin:17px 0}.avoid-field legend{font-size:14px;margin-bottom:9px}.avoid-field legend small{display:block;font-size:12px}.avoid-icons{display:flex;gap:7px;flex-wrap:wrap}.avoid-icons button{position:relative;padding:5px;background:#152029}.avoid-icons .icon{height:29px;width:29px}.avoid-icons button[aria-pressed=true]{border-color:#e7b979;background:#4d3226}.avoid-icons button>span{position:absolute;right:-3px;top:-7px;border-radius:50%;background:#e7b979;color:#30251a;font-weight:700;width:18px;height:18px;line-height:16px;text-align:center}.pivot-context{font-size:13px!important;color:#a4b8b0!important;margin:13px 0!important}.pivot-option{background:#111d24;border:1px solid #354650;border-radius:9px;padding:14px;margin:10px 0}.pivot-itemhead{display:flex;gap:11px;align-items:center}.pivot-itemhead>div{flex:1;min-width:0}.pivot-itemhead h3{font-size:15px}.pivot-itemhead p{font-size:12px!important;margin:3px 0 0!important}.pivot-ready{font-size:12px;white-space:nowrap;color:#d6c3a5}.pivot-ready.ready{color:var(--green)}.pivot-recipe{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:11px}.pivot-recipe>b{color:var(--muted);font-size:12px}.pivot-ingredient{display:flex;align-items:center;gap:6px;font-size:12px;color:#c2b8a5;background:#252c2d;border:1px solid #4e5047;padding:4px 7px;border-radius:5px}.pivot-ingredient .icon{height:23px;width:23px;border:0}.pivot-ingredient.have{color:#c4e5d0;background:#243c31;border-color:#3a5948}.pivot-tradeoff{font-size:12px!important;color:#d8bd89!important;margin:8px 0 0!important}.pivot-actions{display:flex;justify-content:flex-end;gap:9px;margin-top:13px}.pivot-actions button{font-size:14px;padding:7px 12px}.pivot-method{font-size:12px!important;line-height:1.55;margin:14px 0 0!important;color:var(--muted)!important}.pivot-section:has(button:disabled){opacity:.7}@media(max-width:680px){.fast-catalog{grid-template-columns:repeat(auto-fill,minmax(49px,1fr))!important;max-height:330px}.component-picker{grid-template-columns:repeat(11,minmax(0,1fr));gap:4px}.base-filter{min-height:36px;padding:2px}.base-filter .icon{width:25px;height:25px}.base-filter[aria-pressed=true]{padding:1px}.pivot-section{padding:15px;gap:10px}.pivot-section button{white-space:normal}.pivot-itemhead{flex-wrap:wrap}.pivot-ready{flex-basis:100%;padding-left:49px}.pivot-dialog-head h2{font-size:22px}#pivot-dialog{padding:18px}.with-names .quick-item>span{font-size:14px}}@media(max-width:410px){.component-picker{grid-template-columns:repeat(6,minmax(0,1fr))}.pivot-actions{flex-wrap:wrap}.pivot-actions button{flex:1}.qbottom .make{font-size:12px;padding:6px 7px}}

.qbottom{flex-wrap:wrap}.qbottom .make{margin-left:auto}.pivot-ready{max-width:150px;white-space:normal;text-align:right}@media(max-width:680px){.pivot-ready{text-align:left;max-width:none}}

</style><style>
[hidden]{display:none!important}button{min-height:34px}.actions{flex-wrap:wrap;justify-content:flex-end}.pagehead h1{font-size:27px}.pagehead{align-items:flex-start;margin-bottom:20px}.pagehead p{font-size:14px}.workspace>*{min-width:0}.topbar{height:auto;min-height:72px;padding-top:10px;padding-bottom:10px}.topright{flex-wrap:wrap;justify-content:flex-end;gap:10px}.wrap{max-width:1600px}.queuehead{flex-wrap:wrap;gap:8px;padding-bottom:10px}.queuehead>div{margin-right:auto}.queuehead h2{font-size:18px}.queuehead .count{order:0}.receive-open{font-size:13px;padding:5px 8px;background:transparent;color:#b8d3c5}.craft-strip{display:flex;align-items:center;gap:10px;height:54px;padding:5px 10px;margin-bottom:10px;background:#182c22;border:1px solid #365444;border-radius:8px;max-width:100%;overflow:hidden}.craft-label{font-size:13px;color:var(--green);white-space:nowrap;font-weight:600}#craft-options{display:flex;gap:6px;overflow-x:auto;align-items:center;min-width:0;height:44px;scrollbar-width:thin}.craft-chip{position:relative;flex:0 0 38px;width:38px;height:38px;padding:3px;background:#1d3529;border-color:#4e745b}.craft-chip .icon{width:30px;height:30px}.craft-chip>span{position:absolute;right:-1px;bottom:-2px;background:var(--green);color:#14291c;width:15px;height:15px;font-size:11px;line-height:15px;border-radius:4px;font-weight:700}.craft-chip.shared{border-color:#ab925f}.craft-chip.shared>span{background:var(--gold)}.item-owner{display:block;color:#a8caba;font-size:12px;margin-top:3px}.special-note{font-size:13px;color:var(--gold)}.benchitem{position:relative}.bench-key{position:absolute;left:6px;top:5px}.benchitem .icon{margin-top:9px}kbd{font:12px/1.7 ui-monospace,monospace;border:1px solid #405748;border-bottom-width:2px;border-radius:4px;background:#18251e;color:#bdcfc2;padding:0 5px}.completeitem{flex-wrap:wrap}.completeitem strong{min-width:100px;text-decoration:none}.completeitem .icon{opacity:1}.completeitem button{font-size:12px;padding:3px 6px}.qbottom{padding:8px 12px}.qbottom .make{margin-left:auto}.pivot-trigger{margin-right:0}.pivot-section{padding:12px 15px;margin-top:16px}.pivot-section p,.pivot-section .eyebrow{display:none}.pivot-section h2{margin-top:0;font-size:16px}.pivot-section button{padding:6px 9px}.footer{font-size:12px}.modal-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.modal-heading h2{margin-bottom:8px}.modal-heading button{padding:0 10px;font-size:25px}dialog{max-height:calc(100dvh - 32px);overflow:auto}dialog label{display:block;font-size:14px;margin:12px 0 7px}dialog input,dialog select,dialog textarea{max-width:100%;font:inherit}dialog textarea{width:100%;background:#101920;color:var(--text);resize:vertical;padding:10px;border:1px solid var(--line);border-radius:6px;font-family:ui-monospace,monospace;font-size:13px}dialog input[type=file]{width:100%;font-size:14px}.dialogactions{flex-wrap:wrap}.keep-label,.shortcut-toggle{display:flex;align-items:center;gap:10px;margin-top:15px}.keep-label input,.shortcut-toggle input{accent-color:var(--green);width:18px;height:18px}.backup-buttons{display:flex;gap:10px;flex-wrap:wrap}.receive-items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:14px;max-height:55vh;overflow:auto}.receive-items button{display:flex;align-items:center;gap:10px;padding:9px;text-align:left;font-size:14px}.receive-items small{display:block;font-size:12px;margin-top:3px}#receive-dialog{width:680px;max-width:calc(100vw - 32px)}hr{border:0;border-top:1px solid var(--line);margin:20px 0}#import-confirm{background:#223d2c;border:1px solid #52715e;border-radius:7px;padding:12px;margin-top:15px}.storagewarn{padding:10px;border:1px solid #75613c;background:#30281a;border-radius:5px}.bench .panelhead{padding-top:14px}.benchgrid{padding-bottom:12px}.benchnote{font-size:12px;padding-bottom:12px}.panelhead{padding-top:17px}.topbar button{font-size:13px}.pagehead .actions button{font-size:14px}.brand small{font-size:11px}
@media(max-width:1150px){.pagehead{flex-wrap:wrap}.actions{justify-content:flex-start}}
@media(max-width:680px){.topbar{padding-left:14px;padding-right:14px;gap:10px}.topright{gap:6px}.brand small{font-size:10px}.topright button{font-size:12px;padding:5px 8px}.receive-open{font-size:12px}.craft-strip{height:52px}.queuehead h2{font-size:17px}#academy-dialog{padding:17px}.import-recipe .icon{width:20px;height:20px}.pagehead h1{font-size:25px}.completeitem button{font-size:12px}}
@media(max-width:440px){.receive-items{grid-template-columns:1fr}.import-item{gap:6px;font-size:13px}.import-item>.icon{width:25px;height:25px}.code-form{flex-wrap:wrap}.code-form input{flex-basis:100%}.code-form button{width:100%}.brand small{display:none}.topbar{min-height:58px}.queuehead .count{display:none}}

.academy-bar{display:flex;align-items:center;flex-wrap:wrap;gap:6px 18px;margin:-5px 0 16px;font-size:13px;color:var(--muted)}.academy-bar a{color:#b8d3c5;white-space:nowrap}.academy-bar span{font-size:12px}.quick-import-feedback{font-size:13px;color:#b3d4bf;margin:-5px 0 16px;overflow-wrap:anywhere}.quick-import-feedback:empty{display:none}.quick-import-feedback.error{color:var(--gold)}.pagehead p kbd{font-size:12px}.pagehead h1{overflow-wrap:anywhere}

</style><style>
/* Primary flow: bench, queue, shortlist. The manual picker opens on demand. */
.wrap{padding-top:20px}.pagehead{margin-bottom:16px}.pagehead h1{font-size:25px}.academy-bar{margin-bottom:12px}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:20px;align-items:start}.centercol{min-width:0}.rightcol{grid-column:auto;order:0}.bench{margin:0 0 10px;overflow:visible;box-shadow:0 5px 18px #0002}.bench .panelhead{padding:8px 12px 5px;gap:9px;flex-wrap:wrap}.bench h2{font-size:15px}.bench .count{font-size:12px}.bench .benchnote{padding:0;margin-left:auto;font-size:12px;line-height:1.4}.benchgrid{grid-template-columns:repeat(10,minmax(0,1fr));padding:0 10px 8px;gap:6px}.benchitem{display:grid;grid-template-columns:25px 1fr;gap:4px;padding:5px 7px}.benchitem .icon{grid-column:2;grid-row:1;justify-self:center;width:28px;height:28px;margin:0}.benchitem strong{display:none}.bench-key{position:static;grid-column:1;grid-row:1;align-self:center;justify-self:start;font-size:13px;min-width:22px;text-align:center;padding:0 4px}.benchitem .counter{grid-column:1/-1;margin:0;gap:6px}.counter button{width:27px;height:26px;min-height:26px;min-width:25px}.counter output{font-size:16px;min-width:19px}.item-drawer{margin-bottom:16px;border-color:#303c43;background:#131d23}.item-drawer>summary{display:flex;justify-content:space-between;align-items:center;list-style:none;padding:9px 14px;cursor:pointer;font-size:14px;color:#b8ccc1;min-height:40px}.item-drawer>summary::-webkit-details-marker{display:none}.item-drawer>summary:after{content:'⌄';font-size:17px;margin-left:12px}.item-drawer[open]>summary:after{content:'⌃'}.drawer-key{margin-left:auto}.item-drawer>summary:focus-visible,.completed-drawer>summary:focus-visible{outline:2px solid var(--green);outline-offset:-3px}.item-drawer .leftcol{width:100%;border:0;border-top:1px solid var(--line);border-radius:0;display:grid;grid-template-columns:270px minmax(0,1fr);gap:0;padding-top:10px}.item-drawer .panelhead,.item-drawer .catalogfoot{display:none}.item-drawer .catalogtools{padding:0 14px 12px}.item-drawer .fast-catalog{max-height:264px;align-content:start;grid-template-columns:repeat(auto-fill,minmax(47px,1fr))!important}.item-drawer .fast-catalog.with-names{grid-template-columns:repeat(auto-fill,minmax(145px,1fr))!important}.item-drawer .component-picker{grid-template-columns:repeat(6,minmax(0,1fr))}.item-drawer .item-preview{min-height:52px}.item-drawer .quick-item>.icon{max-width:44px}.qcard{margin-bottom:0}.qtop{padding:11px 12px 8px;gap:9px}.qtop .icon{width:37px;height:37px}.itemtitle h3{font-size:14px}.priority{font-size:11px;margin-bottom:2px;letter-spacing:.5px}.item-owner{font-size:12px;margin-top:2px}.recipe{padding:0 12px 9px;gap:5px;flex-wrap:wrap}.componentpill{font-size:12px;padding:4px 6px;gap:5px}.componentpill img{width:22px;height:22px}.qbottom{padding:6px 10px;gap:6px}.qbottom .make{font-size:12px;padding:5px 8px}.qbottom button{min-height:30px}.pivot-trigger{font-size:12px;padding:4px 8px}.rankbtns button{padding:2px 8px}.queuehead{padding-bottom:10px}.queuehead .hint{font-size:12px}.queuehead h2{font-size:17px}#queue{display:grid;grid-template-columns:1fr;gap:10px}#queue>.empty{grid-column:1/-1;min-height:220px}.craft-strip{height:auto;min-height:74px;padding:5px 10px;margin-bottom:10px;gap:10px}#craft-options{height:auto;min-height:60px;align-items:stretch;gap:5px;padding-bottom:2px}.craft-chip{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;flex:0 0 78px;width:78px;height:auto;min-height:59px;padding:4px;background:#1b3126;border-color:#3e5e49}.craft-chip .icon{width:31px;height:31px}.craft-chip .craft-champion{position:static;background:none;color:#c7dfcf;width:100%;height:auto;line-height:1.2;font-size:12px;font-weight:500;white-space:normal;overflow-wrap:anywhere;border-radius:0;text-align:center}.craft-label{font-size:12px}.completed-drawer{margin-top:14px;color:var(--muted);border-top:1px solid var(--line)}.completed-drawer>summary{padding:10px 3px;cursor:pointer;font-size:13px}.completed-drawer>summary span{margin-left:6px;font-size:12px;background:#26323a;border-radius:4px;padding:1px 6px}.completed-drawer .completehead{display:none}.completeitem{padding:8px 10px;margin:6px 0}.completeitem strong{font-size:13px}.completeitem .icon{width:26px;height:26px}.shopping .panelhead{padding:15px 15px 8px}.shoppingintro{display:none}.shoppinglist{grid-template-columns:1fr;padding:0 10px 10px;gap:7px}.need{padding:9px}.needtop .icon{width:33px;height:33px}.needname{font-size:14px}.needed{font-size:20px}.shoppingfoot{padding:9px 14px;font-size:12px}#pivot-dialog{width:960px;max-width:calc(100vw - 28px);max-height:calc(100dvh - 28px);padding:16px;overflow:hidden}#pivot-dialog[open]{display:flex;flex-direction:column;gap:12px}.pivot-dialog-head{margin:0;align-items:center;gap:12px;flex-shrink:0}.pivot-dialog-head>button{min-height:33px;font-size:23px;padding:0 9px}#pivot-original{display:flex;align-items:center;gap:10px;margin:0;min-width:0}#pivot-original>.icon{width:36px;height:36px}#pivot-original small{font-size:12px;display:block;margin:0;color:var(--muted)}#pivot-original h2{font-size:18px;line-height:1.25;margin:1px 0 0}#pivot-search{padding:8px 10px;font-size:14px;flex-shrink:0}#pivot-results{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;overflow:auto;min-height:0;align-content:start;padding:1px 4px 4px 1px;scrollbar-width:thin}.pivot-option{padding:10px;margin:0;border-radius:7px;min-width:0}.pivot-itemhead{display:flex;align-items:center;gap:8px;flex-wrap:nowrap}.pivot-itemhead>.icon{width:30px;height:30px}.pivot-itemhead h3{font-size:14px;line-height:1.2;margin:0;min-width:0}.pivot-recipe{margin-top:8px;gap:4px;flex-wrap:wrap}.pivot-ingredient{gap:4px;font-size:12px;padding:3px 5px}.pivot-ingredient .icon{width:21px;height:21px}.pivot-recipe>b{font-size:11px}.pivot-actions{gap:6px;margin-top:9px;display:grid;grid-template-columns:1fr 1fr}.pivot-actions button{font-size:12px;white-space:nowrap;padding:5px 6px;min-height:31px}.pivot-option:has(.pivot-ingredient.have):not(:has(.pivot-ingredient:not(.have))){border-color:#497558}.footer{margin-top:18px}
@media(min-width:1100px){#queue{grid-template-columns:repeat(2,minmax(0,1fr))}.qcard{align-self:start}}
@media(min-width:900px) and (min-height:650px){.bench{position:sticky;top:8px;z-index:5;background:#141d24}.rightcol{position:sticky;top:128px}}
@media(max-width:1099px){.workspace{grid-template-columns:minmax(0,1fr) 270px}.benchitem{padding:5px 3px}.counter{gap:3px}.counter button{width:25px}.item-drawer .leftcol{grid-template-columns:250px 1fr}}
@media(max-width:800px){#pivot-results{grid-template-columns:repeat(2,minmax(0,1fr))}.workspace{grid-template-columns:minmax(0,1fr) 240px;gap:14px}.benchgrid{grid-template-columns:repeat(5,minmax(0,1fr))}.benchitem{grid-template-columns:25px 1fr;padding:5px 9px}.item-drawer .leftcol{grid-template-columns:220px 1fr}.rightcol{position:static}.bench{position:static}}
@media(max-width:680px){.wrap{padding:16px 12px}.workspace{display:grid;grid-template-columns:1fr;gap:16px}.rightcol{order:0;grid-column:1}.centercol{order:0;grid-column:1}.bench .benchnote{margin-left:0}.benchgrid{gap:5px;padding:0 7px 7px}.benchitem{padding:5px 3px;gap:4px}.benchitem .counter{gap:2px}.counter button{min-width:23px;width:23px}.counter output{min-width:16px}.benchitem .icon{width:25px;height:25px}.bench-key{font-size:12px;padding:0 3px;min-width:20px}.item-drawer .leftcol{display:block}.item-drawer .catalogtools{padding:0 12px 10px}.item-drawer .component-picker{grid-template-columns:repeat(11,minmax(0,1fr))}.item-drawer .fast-catalog{max-height:220px}.item-drawer .item-preview{display:none}.shoppinglist{grid-template-columns:repeat(2,minmax(0,1fr))}.need{display:block}.needactions{margin-top:8px}.needname small{white-space:normal;max-width:none}.pagehead h1{font-size:23px}.craft-chip{flex-basis:72px;width:72px}.craft-strip{gap:6px}.academy-bar{font-size:12px;gap:3px 12px}.pagehead p{font-size:12px}.pagehead p .muted{display:none}}
@media(max-width:540px){#pivot-results{grid-template-columns:1fr}#pivot-dialog{padding:12px}.pivot-option{padding:9px}.pivot-itemhead h3{font-size:14px}.pivot-actions{margin-top:7px}.pivot-actions button{font-size:13px}.pivot-recipe{margin-top:6px}.item-drawer .component-picker{grid-template-columns:repeat(6,minmax(0,1fr))}.shoppinglist{grid-template-columns:1fr}.bench .benchnote{font-size:11px}.bench h2{font-size:14px}.bench .panelhead{gap:6px}.benchitem{grid-template-columns:20px 1fr}}
/* One reading order, at every viewport width. */
#queue,#pivot-results{grid-template-columns:minmax(0,1fr)}
#pivot-dialog{width:610px}
.pivot-option{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 14px;align-items:center}
.pivot-itemhead{grid-column:1}.pivot-recipe{grid-column:1;margin:0}.pivot-actions{grid-column:2;grid-row:1/3;margin:0;display:flex;flex-direction:column;gap:5px}
.pivot-actions button{min-width:100px}.meta-status{margin-left:auto;font-size:12px;color:var(--muted)}
.inline-pivot{border-top:1px solid #304a3b;padding:7px 11px 9px;background:#1b2b2259}
.inline-pivot-label{display:flex;justify-content:space-between;gap:8px;font-size:11px;color:#8da899;margin-bottom:5px}
.inline-pivot-label a{color:#a5bcae;text-decoration:none}.inline-pivot-label b{background:#344738;color:#c1e49d;padding:1px 4px;border-radius:3px;font-weight:700}
.inline-pivot-build{display:flex;align-items:center;width:100%;gap:9px;padding:5px 8px;background:#233b2b;border:1px solid #405c48;border-radius:6px;text-align:left;min-width:0}
.inline-pivot-build:hover{background:#304d37;border-color:#82b36b}.inline-pivot-build>.icon{width:28px;height:28px}.inline-pivot-build strong{font-size:13px;font-weight:600;flex:1;min-width:0}.inline-pivot-recipe{display:flex;align-items:center;gap:4px;color:var(--muted);font-size:11px}.inline-pivot-recipe .icon{width:22px;height:22px}.inline-build-label{font-size:12px;white-space:nowrap;color:#c6e9b7}
@media(max-width:540px){.meta-status{margin-left:0}.inline-pivot-build{gap:6px}.inline-build-label{font-size:11px}.pivot-option{gap:5px 8px}.pivot-actions button{min-width:89px}}

.academy-priority{display:flex;align-items:center;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:11px;margin:0 0 10px}.academy-priority[hidden]{display:none}.academy-priority-item{display:flex;align-items:center;gap:4px}.academy-priority-item .icon{height:26px;width:26px}.academy-priority-item small{font-size:10px}

.pivot-source,.pivot-build-context{display:inline-flex;align-items:center;gap:5px}.pivot-build-context{gap:2px}.pivot-build-context .icon{width:18px;height:18px}.pivot-meta-tier{margin-left:auto;font-size:10px;white-space:nowrap;color:var(--green)}

/* Inventory reads independently of the ten input controls. */
.benchitem.has{background:#244936;border:1px solid #87d4a4;box-shadow:inset 0 0 0 1px #538d68}
.benchitem:not(.has)>.icon{filter:grayscale(1);opacity:.36}.benchitem.has>.icon{filter:none;opacity:1;border-color:#c9dbae}
.benchitem.has .counter output{color:#e2ffe8;background:#396444;border-radius:4px;min-width:25px;font-weight:800;font-size:18px}
.benchitem:not(.has) .counter output{color:#798992}.benchitem.has .bench-key{color:#d3ebda;border-color:#659c77;background:#213c2b}
.owned-bench{display:flex;align-items:center;gap:12px;padding:8px 12px;border-top:1px solid #354e40;background:#10251a;min-height:49px;border-radius:0 0 11px 11px}
.owned-bench-label{color:#b9d0bf;font-size:12px;font-weight:600;white-space:nowrap}.owned-bench-items{display:flex;align-items:center;gap:7px;flex-wrap:wrap;min-width:0}
.owned-component{display:inline-flex;align-items:center;gap:5px;padding:3px 6px 3px 3px;border:1px solid #477055;border-radius:5px;background:#264331}
.owned-component .icon{width:28px;height:28px}.owned-component b{color:#e5ffe8;font-size:14px;font-variant-numeric:tabular-nums}.owned-bench-empty{color:#85988b;font-size:12px}
@media(min-width:900px) and (min-height:650px){.rightcol{top:185px}}
@media(max-width:540px){.owned-bench{gap:8px;padding:7px 9px}.owned-bench-items{gap:5px}.owned-component .icon{width:24px;height:24px}}

/* Completed inventory stays visible above the queue, one compact tile per copy. */
.completed-strip{display:flex;gap:12px;align-items:flex-start;margin:0 0 12px;padding:9px 10px;background:#14221d;border:1px solid #344c3e;border-radius:8px}
.completed-strip[hidden]{display:none}.completed-strip h2{font-size:12px;font-weight:600;line-height:1.4;color:#b2c7ba;padding-top:6px;white-space:nowrap;letter-spacing:0}
.completed-strip h2 span{display:block;color:#8ba794;font-size:11px;font-weight:400;text-align:left}
.completed-strip #completed{display:flex;flex-wrap:wrap;align-items:flex-start;gap:7px;min-width:0}
.completed-strip .completeitem{display:flex;flex-direction:column;align-items:center;gap:5px;flex:0 0 64px;width:64px;margin:0;padding:5px 3px;background:#20362a;border:1px solid #3b5745;border-radius:6px}
.completed-strip .completeitem .icon{width:34px;height:34px;opacity:1}
.completed-strip .completeitem button{font-size:11px;line-height:1.2;padding:5px 4px;min-height:26px;width:100%;color:#c2dfca;border-color:#4a6753;border-radius:4px}
@media(max-width:540px){.completed-strip{gap:8px;padding:8px}.completed-strip h2{font-size:11px}.completed-strip #completed{gap:5px}.completed-strip .completeitem{flex-basis:59px;width:59px}}

/* Green is inventory/ready-to-craft; references and past actions stay neutral. */
.completed-strip{background:#151b21;border-color:#2a333d;padding:7px 9px;box-shadow:none}
.completed-strip h2,.completed-strip h2 span{color:#93a0ad}
.completed-strip .completeitem{background:transparent;border-color:transparent;padding:3px;gap:3px;flex-basis:58px;width:58px}
.completed-strip .completeitem .icon{width:30px;height:30px}
.completed-strip .completeitem button{color:#a8b4c1;border-color:#34404c;background:#1a222b}
.bench-source{font-size:11px;color:#a6b4c2;display:flex;gap:7px;align-items:center;margin-left:auto}
.bench-source select{padding:3px 7px;font-size:12px;min-height:29px;background:#1c2530;color:#d0dae5;border:1px solid #3b4856;border-radius:5px}
.loot-note{padding:8px 12px;border-top:1px solid #303b46;color:#97a8ba;font-size:11px;line-height:1.5}
.loot-note summary{cursor:pointer}.loot-note p{margin:8px 0;font-size:11px}.loot-note label{display:flex;gap:7px;align-items:center}
#loot-counts{display:flex;gap:5px;flex-wrap:wrap;margin-top:9px;align-items:center}#loot-counts>span{display:inline-flex;align-items:center;gap:3px}#loot-counts .icon{width:19px;height:19px}.needname .loot-history-label{font-size:10px;color:#98a8bc;margin-top:3px;white-space:normal}
.champion-builds{margin:0 11px 8px;padding:4px 7px;min-height:28px;align-self:start;font-size:12px;color:#b4c6e0;background:#1d2938;border:1px solid #3a4d66;border-radius:5px;text-align:left}
#browse-meta{font-size:12px;padding:5px 8px;white-space:nowrap}.queuehead{flex-wrap:wrap;gap:8px}
#meta-reference{width:650px;max-width:calc(100vw - 24px);max-height:calc(100dvh - 24px);padding:16px;overflow:hidden}
#meta-reference[open]{display:flex;flex-direction:column;gap:10px}#meta-reference .modal-heading{margin:0;gap:10px}#meta-reference h2{font-size:18px}
.reference-controls{display:grid;grid-template-columns:1fr 1fr;gap:12px}.reference-controls label{font-size:11px;color:#9cabbd;display:flex;flex-direction:column;gap:4px}.reference-controls select{width:100%;min-width:0;padding:8px;background:#1b2634;color:#e0e8f3;border:1px solid #3a4b60;border-radius:5px}
.reference-options{display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap}.reference-options label{font-size:12px;display:flex;gap:6px;align-items:center}.reference-options button{font-size:12px;padding:5px 9px;min-height:30px;background:#202c3b;border-color:#42546c;color:#c4d5ed}
.reference-date{font-size:11px;color:#94a4b8;margin:0}.reference-empty{font-size:13px;line-height:1.6;color:#aebdcc}
#reference-results{overflow:auto;min-height:0;display:flex;flex-direction:column;gap:6px;scrollbar-width:thin}
.reference-build{display:grid;grid-template-columns:24px minmax(0,1fr) 82px;gap:10px;align-items:center;padding:9px;background:#18222d;border:1px solid #303d4e;border-radius:6px}
.build-tier{display:grid;place-items:center;width:23px;height:25px;border-radius:4px;background:#413455;color:#e2c9ff;font-size:13px}.tier-A{background:#283e59;color:#b8d8ff}
.reference-items{display:flex;gap:7px;min-width:0;flex-wrap:wrap}.reference-items button{display:flex;align-items:center;gap:5px;padding:3px;background:transparent;border-color:transparent;text-align:left;min-height:30px;max-width:100%}.reference-items .icon{width:30px;height:30px;flex-shrink:0}.reference-items span{font-size:11px;max-width:90px;line-height:1.2;color:#becbdb}.reference-items button:hover{background:#2b3c51;border-color:#546b8a}.reference-build>small{font-size:11px;text-align:right;color:#97a9be;line-height:1.6;font-variant-numeric:tabular-nums}
#meta-site{width:1400px;max-width:calc(100vw - 20px);height:calc(100dvh - 20px);max-height:calc(100dvh - 20px);padding:10px;overflow:hidden}
#meta-site[open]{display:flex;flex-direction:column;gap:7px}#meta-site .modal-heading{margin:0;gap:12px}#meta-site h2{font-size:16px;margin-right:auto}#site-external{font-size:12px;color:#b6cce9}.frame-note{font-size:11px;margin:0;color:#96a6b8}#meta-frame{border:1px solid #354355;border-radius:5px;background:#101826;width:100%;flex:1;min-height:0}
@media(max-width:540px){.reference-items span{display:none}.reference-build{gap:7px;grid-template-columns:24px minmax(0,1fr) 74px}.reference-controls{gap:7px}.bench-source{margin-left:0}.reference-items{gap:3px}#meta-reference{padding:12px}}

</style><style>
/* One vertical queue beside the Academy board, not two competing item lists. */
.wrap{max-width:1840px;padding-left:24px;padding-right:24px}.workspace{grid-template-columns:minmax(0,1fr) 254px;gap:16px}.centercol{display:grid;grid-template-columns:minmax(320px,.94fr) minmax(390px,1.06fr);gap:16px;align-items:start}.plan-queue{min-width:0}.plan-overview{min-width:0;display:flex;flex-direction:column;gap:12px}.plan-overview[hidden],.baseline-note[hidden]{display:none}.centercol:has(.plan-overview[hidden]){grid-template-columns:1fr}
.baseline-note{display:flex;align-items:center;justify-content:space-between;gap:9px;font-size:11px;color:#9fb0c3;margin:0 0 9px}.baseline-note b{font-weight:600;color:#ccd5e0}.baseline-note button{font-size:10px;padding:3px 6px;min-height:25px;color:#92a2b7;border-color:#344254}.queuehead{gap:6px}.queuehead>div:first-child{flex:1 0 50%}.queuehead #progress{font-size:11px}.queuehead .receive-open,#browse-meta{font-size:11px}.priority{font-size:9px;letter-spacing:.25px}.qtop{padding:8px 10px 6px}.qtop .icon{width:32px;height:32px}.itemtitle h3{font-size:13px}.recipe{padding:0 10px 7px}.qbottom{padding:5px 8px}.champion-builds{font-size:11px;margin:0 10px 6px;min-height:24px}.inline-pivot-label{flex-wrap:wrap}.inline-pivot-build strong{font-size:12px}.inline-pivot-build{gap:6px}.inline-pivot-recipe{display:none}
.board-panel,.tips-panel,.advisor-panel{background:#151e28;border:1px solid #334151;border-radius:10px;box-shadow:none;padding:12px}.board-heading,.advisor-heading{display:flex;align-items:center;justify-content:space-between;gap:10px}.board-heading h2,.tips-heading h2,.advisor-heading h2{font-size:15px;color:#dbe5ef;margin:0}.board-heading a{font-size:12px;color:#b3cae5;white-space:nowrap}.board-heading span{font-size:11px;color:#8fa2b9;display:block;margin-top:3px}#board-progress-label{font-size:11px;color:#b5c6d8;margin-top:13px}#board-progress{height:6px;width:100%;accent-color:#81abd9;border:0;border-radius:5px;display:block;margin:6px 0 9px;background:#283543}#board-progress::-webkit-progress-bar{background:#283543;border-radius:5px}#board-progress::-webkit-progress-value{background:#81abd9;border-radius:5px}
#position-board{padding:3px 12px 1px 0}.hex-row{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:2px;min-height:92px}.hex-row:nth-child(even){transform:translateX(3.5%)}.board-cell{position:relative;display:flex;align-items:center;flex-direction:column;justify-content:center;min-width:0;min-height:92px;padding:10px 0 3px}.empty-cell span{width:76%;height:40px;background:#1c2936;border:1px solid #2b3b4c;clip-path:polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0 50%);opacity:.45}.champion-portrait{width:42px;height:42px;object-fit:cover;border:1px solid #62768d;border-radius:8px;background:#263341}.board-stars{font-size:9px;letter-spacing:-1px;color:#c6b77c;position:absolute;top:0;white-space:nowrap}.board-name{font-size:9px;color:#b7c7d9;line-height:1.4;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.board-items{display:flex;gap:1px;justify-content:center;flex-wrap:wrap;min-height:20px;width:100%;margin-top:2px}.board-item{position:relative;padding:0;border:1px solid #43536a;background:#15202e;border-radius:3px;min-height:18px;min-width:0;width:19px;height:19px}.board-item .icon{width:17px;height:17px;border:0;display:block;border-radius:2px}.board-item.is-planned .icon{filter:grayscale(.75);opacity:.45}.board-item.is-ready{border-color:#d0ac60;box-shadow:0 0 0 1px #907338}.board-item.is-done{border-color:#8ec4a4}.board-item b{position:absolute;bottom:-4px;right:-3px;font-size:9px;color:#10251b;background:#a0d0b2;border-radius:50%;line-height:10px;min-width:10px}.board-item.is-ready b{background:#dbbd79}.board-item b:empty{display:none}.board-adjusted{position:absolute;top:4px;right:2px;color:#a9c6f1;font-size:11px}.board-legend{border-top:1px solid #2b3c4e;padding-top:9px;display:flex;flex-wrap:wrap;gap:6px 11px;color:#99acc2;font-size:10px}.unplaced-units{display:flex;flex-wrap:wrap;border-top:1px dashed #364557}.unplaced-units>small{flex-basis:100%;font-size:10px;color:#9cacc0}.unplaced-units .unit-cell{width:14%}
#board-extras{display:flex;gap:6px;flex-wrap:wrap;align-items:center;font-size:11px;color:#b4bfd0;margin-top:8px}#board-extras:empty{display:none}#board-extras button{display:flex;align-items:center;gap:5px;padding:3px 6px;font-size:10px;background:#243247;color:#c9d8eb;border-color:#4c607a}#board-extras .icon{width:23px;height:23px}
.advisor-heading{align-items:baseline;flex-wrap:wrap;gap:3px}.advisor-heading>span{font-size:10px;color:#9bafd0}.advisor-empty{font-size:12px;color:#8fa4bd;line-height:1.5;margin:9px 0 0}.adapt-card{border-top:1px solid #354659;margin-top:10px;padding-top:10px}.adapt-card>div:first-child{display:flex;align-items:center;justify-content:space-between;gap:7px}.adapt-card strong{font-size:13px}.adapt-card>div>span{font-size:10px;color:#9db3d1}.adapt-card p{font-size:11px;color:#b7c6d9;margin:6px 0}.adapt-items{display:flex;flex-direction:column;gap:5px}.adapt-items>span{display:flex;align-items:center;gap:7px}.adapt-items .icon{width:26px;height:26px}.adapt-items>span>span{font-size:12px}.adapt-card>button{font-size:12px;padding:6px 10px;background:#2b4161;color:#d6e6ff;border-color:#5676a0;margin-top:8px;width:100%}.adapt-card>small{font-size:10px;color:#8ba1bc;margin-top:6px;display:block}
.tips-heading h2{margin-bottom:9px}#tip-tabs{display:flex;gap:5px;flex-wrap:wrap}#tip-tabs button{font-size:11px;padding:4px 8px;min-height:28px;border-color:#3c4c60;background:#1d2a3a;color:#a8bcd5}#tip-tabs button[aria-pressed=true]{background:#344861;border-color:#7291b7;color:#e4edfa}#stage-tip{font-size:12px;line-height:1.6;color:#b8c8dc;margin:10px 0 0;white-space:pre-line}
.data-diagnostics{margin-top:18px;border-top:1px solid #354052;padding-top:12px;font-size:12px}.data-diagnostics summary{cursor:pointer}.data-diagnostics p{font-size:12px;overflow-wrap:anywhere}.connection-error{color:#dec297}.completed-strip .completeitem button.completed-holder{width:auto;min-height:0;padding:0;background:none;border:0}.completed-holder .icon{display:block}.receive-holder,#assign-holder label{display:flex;align-items:center;gap:10px;margin:10px 0;font-size:12px}.receive-holder select,#holder-select{min-width:0;flex:1;background:#1c2836;color:#c7d7ea;border:1px solid #485b75;padding:7px;border-radius:5px}.meta-status{font-size:11px}.bench{position:static}.rightcol{top:12px}
@media(min-width:1450px) and (min-height:800px){.plan-overview{position:sticky;top:12px}.hex-row,.board-cell{min-height:96px}}
@media(max-width:1240px){.centercol{grid-template-columns:minmax(0,1fr)}.plan-overview{grid-row:1;display:grid;grid-template-columns:minmax(330px,1fr) minmax(240px,.8fr);align-items:start}.board-panel{grid-row:1/3}.tips-panel{grid-column:2}.advisor-panel{grid-column:2;grid-row:1}.plan-queue{grid-row:2}.workspace{grid-template-columns:minmax(0,1fr) 240px}.hex-row,.board-cell{min-height:80px}.champion-portrait{width:34px;height:34px}.board-stars{top:1px}.board-item{width:16px;height:16px;min-height:16px}.board-item .icon{width:14px;height:14px}}
@media(max-width:1030px){.plan-overview{display:flex}.workspace{grid-template-columns:minmax(0,1fr) 230px}.plan-overview .board-panel{max-width:none}.hex-row,.board-cell{min-height:86px}.champion-portrait{width:38px;height:38px}.board-item{width:18px;height:18px;min-height:18px}.board-item .icon{width:16px;height:16px}}
@media(max-width:680px){.wrap{padding:14px 10px}.workspace{grid-template-columns:1fr}.centercol{grid-column:1}.plan-overview{grid-row:auto}.plan-queue{grid-row:auto}.rightcol{position:static}.board-panel{padding:10px}.board-name{font-size:8px}.board-item{width:16px;height:16px;min-height:16px}.board-item .icon{width:14px;height:14px}}

