/* Shared icon language and compact, source-familiar references. */
.champ-icon,.champ-fallback{width:24px;height:24px;object-fit:cover;flex-shrink:0;border:1px solid #667180;border-radius:3px;vertical-align:middle}.champ-fallback{display:inline-grid;place-items:center;background:#303941;color:#aeb8c3}.inline-entity{display:inline-flex;align-items:center;gap:5px;vertical-align:middle}.inline-entity>.icon,.inline-entity>.champ-icon{width:19px;height:19px}.item-owner{display:flex;align-items:center;gap:4px;flex-wrap:wrap}.item-owner .champ-icon{width:19px;height:19px}.craft-champion .inline-entity{gap:3px;justify-content:center;font-size:10px}.craft-champion .champ-icon{width:17px;height:17px}.champion-builds{display:flex;align-items:center;gap:6px}.champion-builds .champ-icon{width:21px;height:21px}.champion-builds>span:last-child{margin-left:auto}.modal-heading h2{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.modal-heading h2>.icon{width:30px;height:30px}
.icon-select{position:relative;min-width:0;width:100%}.icon-select-trigger{display:flex;align-items:center;gap:8px;width:100%;text-align:left;padding:7px 9px;min-height:43px;background:#26282c;color:#e5e5e5;border:1px solid #52555d;border-radius:5px;font-size:13px}.icon-select-trigger>.icon,.icon-select-trigger>.champ-icon,.any-icon{width:28px;height:28px;flex:0 0 28px}.icon-select-trigger>span:not(.picker-chevron):not(.any-icon){overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.any-icon{display:inline-grid;place-items:center;background:#373a40;border-radius:3px;color:#9da6b1}.picker-chevron{margin-left:auto;color:#969da9}.icon-select-popup{position:absolute;left:0;right:0;top:calc(100% + 4px);min-width:205px;background:#232529;border:1px solid #626773;box-shadow:0 12px 28px #000a;border-radius:5px;z-index:50;padding:7px}.icon-select-popup[hidden]{display:none}.icon-select-search{width:100%;padding:7px 9px;border:1px solid #565d6a;background:#191b1f;color:#e4e8ef;font-size:12px;border-radius:4px;margin-bottom:5px}.icon-select-options{max-height:235px;overflow:auto;scrollbar-width:thin;display:flex;flex-direction:column;gap:2px}.icon-select-option{display:flex;align-items:center;gap:8px;text-align:left;min-height:36px;padding:4px 6px;border:1px solid transparent;background:transparent;font-size:12px;color:#d6dbe4;flex-shrink:0}.icon-select-option>.icon,.icon-select-option>.champ-icon{width:28px;height:28px;flex-shrink:0}.icon-select-option b{margin-left:auto;color:#c6a867}.icon-select-option[aria-pressed=true]{background:#363632;border-color:#827548}.icon-select-option:hover,.icon-select-option:focus-visible{background:#3e4147}.picker-no-match{padding:12px;color:#a0a7b3;font-size:12px}.receive-holder .icon-select,#assign-holder label .icon-select{flex:1}.receive-holder>select[hidden],select[hidden]{display:none!important}.reference-controls label{position:relative}
/* MetaTFT-style dark striped rows, square icons and colored tier badges. */
#meta-reference{width:690px;background:#1e2023;border:1px solid #4a4e56;border-radius:7px;padding:18px;gap:12px}
#reference-title{flex-wrap:nowrap;font-size:20px;line-height:1.25}#reference-title>.champ-icon{width:45px;height:45px;border-width:2px}#reference-title small{display:block;font-size:11px;font-weight:400;color:#aaaeb7;margin-top:4px}.reference-controls{gap:10px}.reference-controls label{font-size:11px;color:#aeb2bb}.reference-options label{font-size:12px;color:#d4d8df}.reference-options button{display:flex;align-items:center;gap:5px;background:#303237;border-color:#565c67;color:#d7d9df}.reference-options button .champ-icon{width:21px;height:21px}.reference-owned{display:flex;align-items:center;gap:6px;min-height:26px;flex-wrap:wrap}.reference-owned>span:first-child{font-size:11px;color:#a8afb8;margin-right:4px}.equipped-chip{display:inline-flex;position:relative;background:#1c442e;border:1px solid #70cc92;border-radius:3px;padding:2px}.equipped-chip>.icon{width:26px;height:26px}.equipped-chip>b{position:absolute;right:-3px;bottom:-4px;background:#79d499;color:#0c2315;font-size:10px;border-radius:3px;padding:0 2px}.reference-hint{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:10px;color:#93bda3}.reference-hint button{font-size:10px;min-height:24px;padding:2px 6px;border-color:#4d535c;background:transparent;color:#b4bcc7}.reference-data{font-size:10px;color:#949ca9}.reference-data summary{cursor:pointer;min-height:18px}.reference-date{font-size:10px;color:#9ca6b4;margin:5px 0 0}
.reference-table-heading,.reference-build{display:grid;grid-template-columns:minmax(148px,1fr) 52px 78px 90px;gap:6px;align-items:center}.reference-table-heading{padding:6px 10px;font-size:11px;color:#b8bec8;border-bottom:1px solid #5c543a;margin-bottom:-12px}.reference-table-heading>span:not(:first-child){text-align:right}.reference-table-heading>span:nth-child(2){text-align:center}
#reference-results{gap:0;border-radius:0;min-height:0;max-height:55dvh}.reference-build{border:0;border-bottom:1px solid #35373b;border-radius:0;background:#242629;padding:6px 10px;min-height:49px}.reference-build:nth-child(even){background:#292b2f}.reference-build:hover{background:#35373c}.reference-items{display:flex;gap:5px;flex-wrap:nowrap;align-items:center}.reference-items .build-item{position:relative;display:block;width:36px;height:36px;min-height:36px;padding:0;border:1px solid #666058;border-radius:0;background:#16171a;flex-shrink:0}.reference-items .build-item>.icon{width:34px;height:34px;border-radius:0;border:0;display:block}.reference-items .build-item-name{display:none}.reference-items .build-item.equipped{border:2px solid #72d498;box-shadow:0 0 0 1px #3a7650;background:#205438}.reference-items .build-item.equipped>.icon{width:32px;height:32px}.equipped-check{position:absolute;right:-4px;bottom:-4px;background:#7ee0a4;color:#113923;min-width:14px;line-height:14px;text-align:center;border:1px solid #132c1d;border-radius:3px;font-size:11px;z-index:1}.reference-items .build-item.filter-selected{outline:2px solid #d0b65d;outline-offset:2px}.build-tier{width:27px;height:27px;border-radius:2px;justify-self:center;display:grid;place-items:center;font-size:17px;font-weight:700;color:#171717}.build-tier.tier-S{background:#ff7e83}.build-tier.tier-A{background:#ffbf7f}.build-average,.build-games{font-size:13px;color:#d9dde2;text-align:right;font-variant-numeric:tabular-nums}.build-games{font-size:12px;color:#b4bac4}.reference-empty{font-size:12px;line-height:1.7;padding:20px 9px;color:#afb9c8}
/* Academy board geometry: point-topped hexagons, half-cell row offsets,
   cost borders, star banners, and three tucked-under item icons. */
.board-panel{background:#0e1012;border-color:#363739}.board-heading h2{font-size:14px}.board-heading span{font-size:10px;color:#9ba6b3}.board-heading button{font-size:10px;min-height:25px;padding:3px 7px;white-space:nowrap;color:#d2c78a;border-color:#5b5841}.board-legend{border-color:#35363a;font-size:9px;gap:6px 9px}#position-board{padding:12px 2% 15px 0;max-width:620px;margin:0 auto;width:100%}.hex-row{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:0;width:93.333%;min-height:0;margin-top:-4px}.hex-row:first-child{margin-top:0}.hex-row:nth-child(even){transform:translateX(7.142857%)}.board-cell{aspect-ratio:1;min-height:0;padding:0;position:relative;display:block}.empty-cell span{display:block;width:92%;height:100%;margin:0 4%;border:0;background:linear-gradient(180deg,#29292980,#39393980);opacity:1;clip-path:polygon(50% 0,96% 25%,96% 75%,50% 100%,4% 75%,4% 25%)}.board-champion{position:relative;display:block;width:100%;height:100%;min-height:0;padding:0;background:none;border:0;border-radius:0;overflow:visible}.champion-hex{position:absolute;inset:0 4%;background:var(--unit-color);clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%)}.champion-hex .champion-portrait{position:absolute;inset:6%;width:88%;height:88%;max-width:none;border:0;border-radius:0;clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);object-fit:cover}.board-champion:hover{background:none;filter:brightness(1.15)}.board-champion:focus-visible{outline:2px solid #d6bc63;outline-offset:2px}.board-stars{position:absolute;top:5%;left:15%;right:15%;font-size:clamp(8px,1vw,11px);letter-spacing:0;color:#0a0b0d;background:#ffc107;border-radius:2px;line-height:1.15;padding:1px 2px;text-align:center;transform:skewX(-8deg);box-shadow:0 0 7px #ffd03f55;pointer-events:none}.board-stars:empty{display:none}.board-name{position:absolute;top:40%;left:5%;right:5%;color:#fff;text-shadow:0 1px 3px #000,0 0 5px #000;font-size:10px;text-align:center;opacity:0;white-space:nowrap;overflow:hidden}.board-champion:hover .board-name,.board-champion:focus-visible .board-name{opacity:1}.board-items{position:absolute;bottom:-2%;left:0;right:0;width:100%;display:flex;align-items:flex-start;justify-content:center;gap:0;min-height:0;margin:0;z-index:2;flex-wrap:nowrap;pointer-events:none}.board-item{width:30%;height:auto;aspect-ratio:1;min-height:0;padding:1px;background:#4d4f55;border:0;border-radius:0;clip-path:polygon(50% 0,96% 25%,96% 75%,50% 100%,4% 75%,4% 25%);pointer-events:auto;flex-shrink:1}.board-item:nth-child(2){transform:translateY(23%)}.board-item .icon{display:block;width:100%;height:100%;border-radius:0;clip-path:inherit}.board-item.is-planned .icon{filter:grayscale(.4);opacity:.65}.board-item.is-done{background:#6ade96;box-shadow:none;padding:2px}.board-item.is-ready{background:#ffd374;box-shadow:none;padding:2px}.board-item b{right:7%;bottom:12%;font-size:8px;min-width:8px;line-height:9px}.board-item b:empty{display:none}.board-adjusted{top:0;right:0;font-size:10px;z-index:3;pointer-events:none}.unplaced-units .unit-cell{width:14%;flex-shrink:0}.adapt-equipped{display:flex;align-items:center;gap:6px;margin:8px 0}.adapt-equipped small{font-size:10px;color:#a6b5c8}.adapt-card .inline-entity{font-size:13px}.adapt-card .inline-entity .champ-icon{width:25px;height:25px}#site-title{display:flex;align-items:center;gap:7px}
@media(max-width:540px){#meta-reference{padding:12px}.reference-table-heading,.reference-build{grid-template-columns:minmax(113px,1fr) 31px 54px 60px;gap:4px;padding-left:6px;padding-right:6px}.reference-items{gap:3px}.reference-items .build-item{width:32px;height:32px;min-height:32px}.reference-items .build-item>.icon{width:30px;height:30px}.reference-items .build-item.equipped>.icon{width:28px;height:28px}.build-average{font-size:12px}.build-games{font-size:10px}.reference-table-heading{font-size:10px}.icon-select-trigger{gap:5px;padding:6px;font-size:12px}.icon-select-popup{min-width:170px}.reference-controls>label:last-child .icon-select-popup{left:auto;right:0}.reference-hint{font-size:9px}.reference-items .equipped-check{font-size:9px;min-width:11px;line-height:11px}.board-stars{font-size:9px}.board-name{font-size:8px}}

</style><style>
.comp-finder{padding:15px;margin-bottom:16px;overflow:visible;background:#151e28;border-color:#334151}
.comp-finder[hidden],#queue .empty[hidden]{display:none}
.finder-heading h2{font-size:18px}.finder-heading p,.finder-note{font-size:12px;color:#9eafc2;margin-top:4px}
