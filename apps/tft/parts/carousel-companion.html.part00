.comp-suggestion{display:flex;align-items:center;gap:10px;padding:10px 0;border-top:1px solid #2c3847}.finder-rank{width:17px;color:#8194aa;font-size:13px;flex-shrink:0}.finder-comp{flex:1;min-width:0}.finder-titleline{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.finder-titleline h3{font-size:14px;font-weight:600}.finder-titleline>.champ-icon{width:30px;height:30px;border-radius:5px}.comp-suggestion>button{font-size:12px;padding:6px 10px;background:#22364a;border-color:#3b5673;flex-shrink:0}.academy-tier{font-size:10px;line-height:1.6;padding:1px 6px;border:1px solid #4a5565;border-radius:3px;background:#293748;color:#cbd6e3;white-space:nowrap}.academy-tier.tier-A{background:#5b3827;color:#ffcaac;border-color:#77503b}.academy-tier.tier-S{background:#562e41;color:#ffb6d1;border-color:#80435e}.academy-tier.tier-B{background:#4a4329;color:#e2d398;border-color:#625936}.academy-tier.tier-X{background:#313043;color:#b9b6df}
