#augment-dialog{max-width:650px;max-height:88vh;overflow:auto}.augment-stage{display:flex;gap:7px;margin:0 0 12px}.augment-stage button{font-size:12px;padding:7px 11px}.augment-stage [aria-pressed=true]{background:#36455a;border-color:#96abc6}.augment-search-wrap{position:relative;margin:10px 0}.augment-search-wrap label{display:block;font-size:11px;color:#a6b8ce;margin-bottom:5px}#augment-search-results{position:relative;max-height:280px;overflow:auto;background:#101922;border:1px solid #53657c;border-radius:7px;margin-top:3px}#augment-search-results[hidden]{display:none}#augment-search-results button{display:flex;align-items:center;gap:8px;width:100%;border:0;border-bottom:1px solid #304050;border-radius:0;background:transparent;text-align:left;padding:8px}#augment-search-results button.search-active{background:#283b50}#augment-search-results button>span{flex:1;min-width:0}#augment-search-results strong{font-size:13px;display:block}#augment-search-results small{display:block;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#augment-search-results p{font-size:12px;margin:12px}#augment-verdict{border:1px solid #41516a;border-radius:8px;background:#1a2839;color:#dbe7f9;padding:11px;font-size:13px;line-height:1.45}#augment-verdict[data-action=take]{border-color:#7897be}#augment-verdict[data-action=reroll]{border-color:#9c855b}#augment-verdict small{display:block;font-size:11px;color:#aebfd4;margin-top:6px}#augment-offers{display:flex;flex-direction:column;gap:8px;margin-top:12px}.augment-offer{background:#141e28;border:1px solid #334153;border-radius:9px;padding:11px}.augment-offer.active-slot{border-color:#7b91ad}.augment-offer.best-offer{border-left:3px solid #9dbbdd}.augment-offer-heading{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.augment-offer-heading>button:first-child{flex:1;background:transparent;border:0;padding:0;text-align:left;min-width:160px}.augment-offer-heading>button>span{display:flex;align-items:center;gap:9px}.augment-offer strong{font-size:14px}.augment-offer-heading .quiet{font-size:11px;padding:6px}.augment-rarity{font-size:10px;font-weight:500;color:#b6c4d2;white-space:nowrap}.rarity-2{color:#d8bf78}.rarity-3{color:#c6a1e9}.augment-fit-label{font-size:11px;color:#b7cce6;margin:7px 0 3px}.augment-reasons{display:flex;flex-direction:column;gap:3px;font-size:12px;color:#9fb0c5}.augment-description{font-size:11px;color:#a6b7ca;margin-top:8px}.augment-description summary{cursor:pointer}.augment-description p{font-size:12px!important;margin:5px 0!important;white-space:pre-line}.augment-take{margin-top:9px;font-size:12px;padding:7px 14px}.best-offer .augment-take{background:#324d70;border-color:#6c89af}.empty-offer button{width:100%;text-align:left;background:transparent;border:0;font-size:13px;color:#b3c2d4}.empty-offer button span{display:inline-flex;border:1px solid #425773;border-radius:50%;width:23px;height:23px;align-items:center;justify-content:center;margin-right:10px}.augment-method{font-size:11px;color:#91a6be;margin-top:15px}.augment-method p{font-size:11px!important}.chosen-augments{display:flex;gap:6px;flex-wrap:wrap;padding:0 16px 12px}.chosen-augments[hidden]{display:none}.chosen-augments button{display:flex;gap:6px;align-items:center;padding:4px 7px;font-size:11px;background:#1a2531;border-color:#37475a}.chosen-augments img{width:23px;height:23px}.chosen-augments small{font-size:9px}.augment-related{display:flex;gap:4px;margin-top:6px}.augment-related img{width:24px;height:24px}@media(max-width:450px){.augment-stage button{padding:7px;font-size:11px}.augment-offer-heading>button:first-child{min-width:125px}.augment-offer strong{font-size:12px}.augment-rarity{font-size:9px}.augment-offer-heading .quiet{font-size:10px}.chosen-augments button span{max-width:115px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}}

