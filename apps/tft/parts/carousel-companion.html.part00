#finder-more{width:100%;font-size:12px;margin-top:6px;padding:5px}.finder-method{margin-top:8px;font-size:11px;color:#8799af}.finder-method summary{cursor:pointer}.finder-method p{margin-top:7px;max-width:850px}.queue-item-pivot{padding:0;border:0;background:transparent;display:flex;flex-shrink:0;border-radius:5px}.queue-item-pivot:hover{outline:1px solid #90acc7}.queue-item-pivot .icon{width:32px;height:32px}
