<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#0d1318"><title>Carousel — TFT Item Companion</title><meta name="description" content="Plan your TFT items, track your components, and keep your carousel priorities in view."><link rel="icon" href="data:image/svg+xml;base64," type="image/svg+xml"><style>
:root{color-scheme:dark;--bg:#0d1318;--surface:#141d24;--line:#29333b;--muted:#93a0aa;--text:#edf2f3;--green:#8de0b2;--gold:#e6c17d;--font:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.5 var(--font)}button,input,select{font:inherit}button,a,input,select{touch-action:manipulation}button{cursor:pointer;color:inherit}button{border:1px solid var(--line);background:#1c2730;border-radius:7px;padding:9px 13px;transition:background .16s,border-color .16s}button:hover{background:#2b3942;border-color:#53636d}button:disabled{opacity:.32;cursor:default}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--green);outline-offset:3px}a{color:var(--muted);text-underline-offset:4px}h1,h2,h3,p{margin:0}h1,h2,h3,.brand{font-family:var(--font)}h1{font-size:30px;letter-spacing:-1.1px;font-weight:700}h2{font-size:18px;letter-spacing:-.4px}h3{font-size:16px}small,.small{font-size:13px;color:var(--muted)}.muted{color:var(--muted)}.eyebrow{font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase}.topbar{border-bottom:1px solid var(--line);height:80px;display:flex;align-items:center;justify-content:space-between;padding:0 36px;gap:16px}.brand{font-size:23px;font-weight:800;letter-spacing:-.7px;display:flex;align-items:center;gap:12px}.brand svg{width:32px;height:32px;color:var(--green)}.brand small{font-size:11px;letter-spacing:1.8px;font-weight:500;display:block;line-height:1.4}.topright{display:flex;align-items:center;gap:18px}.local{font-size:13px;color:var(--green);border:1px solid #345344;padding:5px 10px;border-radius:30px}.helpbutton{background:transparent}.wrap{max-width:1520px;margin:auto;padding:30px 36px 18px}.pagehead{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px;gap:20px}.pagehead p{color:var(--muted);margin-top:5px;font-size:14px}.actions{display:flex;gap:10px}.quiet{background:transparent;color:var(--muted)}.workspace{display:grid;grid-template-columns:310px minmax(300px,1fr) 306px;gap:22px;align-items:start}.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden}.panelhead{padding:20px 20px 16px;display:flex;align-items:center;justify-content:space-between;gap:10px}.count{border-radius:5px;background:#26323a;padding:2px 8px;color:#b1bdc5;font-size:12px}.catalogtools{padding:0 16px 14px;display:grid;gap:10px}.search{width:100%;background:#0f171e;border:1px solid var(--line);border-radius:7px;color:var(--text);padding:10px 12px;font-size:14px}.filters{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:13px}.filters select{min-width:0;flex:1;background:#1b262e;border:1px solid var(--line);border-radius:5px;color:#cdd5da;padding:6px;font-size:13px}.catalog{padding:0 12px 12px;max-height:520px;overflow:auto;scrollbar-width:thin;scrollbar-color:#394650 transparent;display:grid;grid-template-columns:1fr 1fr;gap:7px}.itemtile{position:relative;display:flex;flex-direction:column;align-items:flex-start;text-align:left;min-height:101px;padding:11px;background:#1b252d;border-color:transparent}.itemtile:hover{border-color:var(--green);background:#213630}.itemtile .icon{width:36px;height:36px;margin-bottom:8px}.itemtile strong{font-size:12px;font-weight:500;line-height:1.35}.tileplus{position:absolute;top:13px;right:11px;font-size:18px;color:var(--muted)}.tilecount{position:absolute;top:16px;right:12px;background:#315143;color:var(--green);font-size:12px;border-radius:4px;padding:0 5px}.catalogfoot{padding:12px 16px;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}.icon{width:38px;height:38px;border-radius:5px;border:1px solid #5a5143;object-fit:cover;flex-shrink:0;background:#111}.queuehead{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 0 16px}.queuehead .eyebrow{color:var(--gold);margin-top:2px}.hint{font-size:13px;color:var(--muted);margin-top:2px}.empty{min-height:306px;border:1px dashed #3b4851;border-radius:12px;padding:34px 26px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:linear-gradient(150deg,#17232a,#101a21)}.empty .emptyicon{font-size:30px;color:var(--green);margin-bottom:16px;width:66px;height:66px;border:1px solid #3a554b;border-radius:18px;display:grid;place-items:center}.empty p{color:var(--muted);font-size:14px;max-width:290px;margin-top:9px}.steps{display:flex;gap:14px;margin-top:24px;color:#a5b7b5;font-size:12px}.steps span{border-top:1px solid #42514f;padding-top:12px;flex:1}.qcard{border:1px solid var(--line);background:var(--surface);border-radius:10px;margin-bottom:11px;overflow:hidden}.qcard.first{border-color:#576047}.qtop{display:flex;align-items:center;gap:12px;padding:15px 16px 10px}.qtop .icon{width:44px;height:44px}.itemtitle{flex:1;min-width:0}.itemtitle h3{font-size:15px;line-height:1.35}.priority{color:var(--gold);font-size:11px;font-weight:600;letter-spacing:1px;margin-bottom:4px}.remove{padding:1px 7px;background:transparent;border:0;color:var(--muted);font-size:20px}.recipe{display:flex;gap:7px;padding:0 16px 14px;align-items:center}.componentpill{padding:5px 7px;display:flex;gap:7px;align-items:center;font-size:12px;border:1px solid var(--line);background:#101920;border-radius:5px;min-width:0}.componentpill img{height:23px;width:23px;border-radius:3px}.componentpill.have{border-color:#355648;background:#193129;color:#a2e4be}.componentpill span{line-height:1.2}.recipe .plus{color:#65747f;font-size:12px}.qbottom{border-top:1px solid var(--line);padding:9px 16px;display:flex;align-items:center;justify-content:space-between;gap:10px}.rankbtns{display:flex;gap:5px}.rankbtns button{font-size:14px;padding:2px 9px;background:transparent}.make{font-size:12px;padding:6px 10px;color:var(--green);border-color:#355447;background:#1d322a}.make.ready{background:var(--green);color:#152b20;border-color:var(--green)}.completehead{display:flex;justify-content:space-between;margin:24px 0 12px;color:var(--muted);font-size:13px}.completeitem{display:flex;align-items:center;gap:10px;padding:12px;border:1px solid var(--line);border-radius:8px;margin:7px 0;background:#121e22}.completeitem .icon{height:30px;width:30px;opacity:.65}.completeitem strong{flex:1;font-size:13px;color:var(--muted);text-decoration:line-through}.completeitem button{font-size:12px;padding:5px 8px}.shopping{border-color:#3d5547;background:linear-gradient(165deg,#20382e 0%,#172921 150px,#15221f 100%)}.shopping .panelhead{padding-bottom:9px}.shopping h2{color:#d9f0df}.shoppingintro{padding:0 20px 16px;color:#a6beb0;font-size:13px}.shoppinglist{padding:0 13px 13px;display:grid;gap:8px}.need{background:#13231d;border:1px solid #345043;border-radius:8px;padding:11px}.need.pinned{border-color:#a9915f}.needtop{display:flex;align-items:center;gap:9px}.needtop .icon{width:38px;height:38px}.needname{flex:1;font-size:14px;font-weight:600;min-width:0}.needname small{display:block;font-size:11px;font-weight:400;color:#9eb3a7;margin-top:2px}.needed{font-family:var(--font);font-size:22px;line-height:1}.needactions{margin-top:10px;display:flex;gap:7px}.pin{color:#a7b3a7;background:transparent;padding:4px 10px}.pin.active{color:var(--gold);border-color:#806d45}.got{flex:1;padding:5px 9px;font-size:12px;background:#284a37;color:#c5ecd4;border-color:#3c624b}.shopempty{padding:25px 14px 30px;text-align:center;font-size:14px;color:#adc3b6}.shopempty b{display:block;color:#d2e4d9;margin-bottom:8px;font-size:17px}.shoppingfoot{border-top:1px solid #30483b;padding:12px 20px;font-size:12px;color:#9eb5a5}.bench{margin-top:24px}.bench .panelhead{padding-bottom:3px}.benchnote{padding:0 20px 16px;color:var(--muted);font-size:13px}.benchgrid{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:8px;padding:0 16px 18px}.benchitem{background:#101920;border:1px solid var(--line);border-radius:7px;padding:12px 7px 8px;text-align:center}.benchitem .icon{width:35px;height:35px;display:block;margin:0 auto 8px}.benchitem strong{display:block;font-size:11px;line-height:1.3;min-height:29px;font-weight:500;color:#b6c1ca}.counter{display:flex;align-items:center;justify-content:center;margin-top:8px;gap:5px}.counter button{padding:0;width:26px;height:27px;background:#24313a;font-size:17px;border:0}.counter output{font-size:15px;min-width:15px}.benchitem.has{border-color:#43604e}.footer{display:flex;justify-content:space-between;gap:20px;margin-top:23px;padding-bottom:8px;font-size:12px;color:#73818c}.footer a{color:#87969e}.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);padding:12px 20px;border:1px solid #4f6659;background:#253d30;border-radius:8px;box-shadow:0 10px 40px #0008;z-index:10;font-size:14px;max-width:90vw;text-align:center}.toast:empty{display:none}dialog{max-width:520px;width:calc(100% - 32px);background:#18242c;color:var(--text);border:1px solid #44554e;border-radius:14px;padding:27px}dialog::backdrop{background:#030a10c9;backdrop-filter:blur(3px)}dialog h2{font-size:23px;margin-bottom:18px}dialog p,dialog li{font-size:14px;color:#b4c1ca;margin:12px 0}dialog ol{padding-left:20px}dialog .dialogactions{display:flex;justify-content:flex-end;gap:10px;margin-top:24px}.primary{background:var(--green);color:#11291c;border-color:var(--green)}.danger{background:#653832;border-color:#995449}.emptysearch{grid-column:1/-1;padding:35px 15px;text-align:center;color:var(--muted);font-size:14px}.storagewarn{color:var(--gold);font-size:13px;margin-bottom:14px}.visuallyhidden{position:absolute;width:1px;height:1px;clip:rect(0,0,0,0);overflow:hidden}@media(min-width:1450px){.workspace{grid-template-columns:340px minmax(350px,1fr) 330px}.catalog{max-height:550px}.itemtile strong{font-size:13px}}@media(max-width:1150px){.wrap{padding:25px 22px}.topbar{padding:0 22px}.workspace{grid-template-columns:260px minmax(270px,1fr)}.rightcol{grid-column:1/-1}.shoppinglist{grid-template-columns:repeat(3,1fr)}.benchgrid{grid-template-columns:repeat(5,1fr)}.catalog{max-height:500px}.itemtile{padding:9px}.itemtile strong{font-size:12px}}@media(max-width:680px){.topbar{height:70px;padding:0 16px}.brand{font-size:20px}.brand small{font-size:9px}.local{display:none}.wrap{padding:22px 14px}.pagehead{align-items:flex-start;flex-wrap:wrap;gap:15px}.pagehead h1{font-size:27px}.pagehead p{font-size:13px}.actions button{font-size:13px;padding:7px 12px}.workspace{display:flex;flex-direction:column;gap:22px}.leftcol,.centercol,.rightcol{width:100%}.rightcol{order:-1}.centercol{order:0}.leftcol{order:1}.catalog{grid-template-columns:repeat(3,1fr);max-height:310px}.shoppinglist{grid-template-columns:repeat(2,minmax(0,1fr))}.needtop{gap:6px}.needname{font-size:12px}.needname small{font-size:10px}.needed{font-size:19px}.needtop .icon{width:30px;height:30px}.benchgrid{grid-template-columns:repeat(5,minmax(0,1fr));padding:0 10px 12px;gap:5px}.benchitem{padding:10px 3px 6px}.benchitem strong{font-size:10px}.counter{gap:2px}.counter button{width:20px}.counter output{font-size:14px}.footer{flex-direction:column;gap:6px}.steps{font-size:11px}.empty{min-height:225px;padding:25px}.helpbutton{font-size:13px;padding:7px 10px}.recipe{flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}@media(min-width:681px){.rightcol{position:sticky;top:22px}}
/* Keep frequently used controls readable at compact widths. */
.itemtile strong{font-size:14px!important}.componentpill,.make,.got{font-size:14px}.benchitem strong{font-size:12px;min-height:33px}.needname small{font-size:12px}.counter button{min-width:25px;min-height:29px}.tileplus{font-size:20px}.priority{font-size:12px}.brand small{font-size:12px;letter-spacing:1.2px}.completeitem strong,.completeitem button{font-size:14px}
@media(max-width:680px){.benchgrid{grid-template-columns:repeat(3,minmax(0,1fr))}.benchitem strong{font-size:13px}.counter button{width:30px;height:30px}.counter{gap:8px}.needname{font-size:14px}.needname small{font-size:12px}.catalog{grid-template-columns:repeat(2,minmax(0,1fr))}.brand small{font-size:10px}.shoppinglist{grid-template-columns:1fr}.needtop .icon{width:38px;height:38px}.need{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center}.needactions{margin:0}.got{font-size:13px;padding:7px}.pin{padding:7px}.needname small{max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}}

@media(max-width:430px){.need{display:block}.needactions{margin-top:10px}.needname small{max-width:none;white-space:normal}.shoppinglist{grid-template-columns:1fr}}

