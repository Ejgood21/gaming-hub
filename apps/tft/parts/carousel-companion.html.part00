.decision-controls{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:0 16px 12px;flex-wrap:wrap}.tempo-control{display:flex;gap:2px;background:#0e171e;border:1px solid #35434c;border-radius:8px;padding:3px}.tempo-control button{font-size:12px;background:transparent;border:0;padding:7px 10px;color:#a9b8c4}.tempo-control button[aria-pressed=true]{color:#f4ead8;background:#514334}.decision-controls>button{font-size:12px;padding:8px 12px}.bench-plan{display:flex;align-items:center;gap:10px;padding:9px 11px;background:#19232d;border:1px solid #455469;border-radius:8px;margin-bottom:8px;flex-wrap:wrap}.bench-plan[hidden]{display:none}.decision-label{font-size:11px;color:#c1cde0;font-weight:650}.bench-plan-items{display:flex;gap:10px;flex-wrap:wrap;flex:1}.bench-plan-item{display:flex;gap:5px;align-items:center}.bench-plan-item .icon{width:29px;height:29px}.bench-plan-item small{display:flex;max-width:100px;line-height:1.15}.bench-plan-item .champion-icon{width:20px;height:20px}.bench-plan button{font-size:12px;padding:7px}.plan-adjustment{font-size:10px;color:#a6b5c6;width:100%}.decision-item{display:inline-flex;vertical-align:middle}.decision-item .icon{width:29px;height:29px}.decision-note{font-size:12px!important;color:#adbac7;margin:6px 0 13px!important}.decision-list{display:flex;flex-direction:column;gap:7px;margin-top:12px}.decision-row{display:flex;align-items:center;gap:10px;border:1px solid #32414e;background:#141e27;border-radius:8px;padding:9px;flex-wrap:wrap}.decision-primary{display:flex;gap:9px;align-items:center;flex:1;min-width:160px}.decision-primary>.icon{width:36px;height:36px}.decision-primary strong{font-size:13px;display:block}.decision-primary small{display:block;font-size:10px;margin-top:2px}.decision-actions{display:flex;gap:6px}.decision-actions button,.anvil-row>button{font-size:12px;padding:8px 10px}.pivot-combination{display:flex;gap:4px}.pivot-combination .is-equipped{border:2px solid #5aa980;border-radius:6px;po