const ACADEMY_BUNDLED = {"patch":"18.3b","set":18,"updated":"2026-09-30 21:33:53.721Z","fetchedAt":"2026-10-01T00:44:26.432Z","augments":[{"apiName":"DA_18_CaretakersAlly","name":"Caretaker's Ally","description":"Gain a random 2-cost champion now. Gain the same one again every time you level up.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_LevelUp","name":"Level Up!","description":"When you buy XP, gain an additional 2. Gain 6 immediately.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_HedgeFund","name":"Hedge Fund","description":"Gain 22 gold. Your max interest is increased to 10.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_WorththeWait","name":"Worth the Wait","description":"Gain a random 1-cost champion. Gain another copy of them at the start of each round for the rest of the game.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_WorththeWaitII","name":"Worth the Wait II","description":"Gain 2 copies of a random 2-cost champion. Gain another copy of them at the start of each round for the rest of the game.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_MaliciousMonetization","name":"Malicious Monetization","description":"Gain 4 gold. For the next 2 rounds, enemy champions drop 2 gold when killed.","stages":["4-2"],"tier":2},{"apiName":"DA_PatientStudy","name":"Patient Study","description":"After player combat, gain 2 XP if you won or 3 XP if you lost.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_GoodForSomethingI","name":"Good For Something I","description":"Champions that aren't holding items have a 40% chance to drop 1 gold on death.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_BuriedTreasuresIII","name":"Buried Treasures III","description":"Gain a random item component now and at the start of the next 6 rounds.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_GlassCannon_Gold","name":"Glass Cannon II","description":"Allies that start combat in the back row begin combat at 80% Health but gain 25% Damage Amp.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_ItemGrabBag","name":"Item Grab Bag I","description":"Gain 1 random completed item.","stages":["2-1","3-2","4-2"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_BigGrabBag","name":"Big Grab Bag","description":"Gain 3 random components, 2 gold, and 1 Reforger.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_18_BranchingOut","name":"Branching Out","description":"Gain a random Emblem.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_BranchingOutPlus","name":"Branching Out+","description":"Gain a random Emblem and a Reforger.","stages":["3-2"],"tier":1},{"apiName":"DA_CalledShot","name":"Called Shot","description":"Set your win streak to +4. Gain 4 gold.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_GlassCannon_Silver","name":"Glass Cannon I","description":"Allies that start combat in the back row begin combat at 80% Health but gain 16% Damage Amp.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_HeroicGrabBag","name":"Heroic Grab Bag","description":"Gain 2 Lesser Champion Duplicators. Gain 4 gold.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_HeroicGrabBagPlus","name":"Heroic Grab Bag+","description":"Gain 2 Lesser Champion Duplicators. Gain 8 gold.","stages":["3-2"],"tier":2},{"apiName":"DA_HeroicGrabBagPlusPlus","name":"Heroic Grab Bag++","description":"Gain 2 Lesser Champion Duplicators. Gain 14 gold.","stages":["4-2"],"tier":2},{"apiName":"DA_InvestmentStrategy","name":"Investment Strategy II","description":"Your champions gain 10 permanent max health per interest you earn. Your max interest is increased by 2. Gain 8 gold now.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_OneBuffTwoBuff","name":"One Buff Two Buff","description":"Gain a Red Buff, a Blue Buff, and a Champion Duplicator.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_18_OnesTwosThree","name":"Ones Two Three","description":"Gain 2 1-cost champions, 1 2-cost champion, and 1 3-cost champion.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_PortableForge","name":"Portable Forge","description":"Choose 1 of 4 Artifacts. Artifacts are more powerful items with a unique effect.","stages":["2-1","3-2","4-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_SilverSpoon","name":"Silver Spoon","description":"Gain 10 XP.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_CalculatedLoss","name":"Calculated Loss","description":"After losing your combat, gain 2 gold and a free Shop reroll.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_RollingForDays","name":"Rolling For Days","description":"Gain 10 free Shop rerolls.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_18_OneTwoFive","name":"One, Two, Five!","description":"Gain 1 random component, 2 gold, and 1 random 5-cost champion.","stages":["4-2"],"tier":1},{"apiName":"DA_LatentForge","name":"Latent Forge","description":"After 8 player combats, gain an Artifact anvil.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_IronAssets","name":"Iron Assets","description":"Gain a component anvil and 3 gold.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_InvestedPlus","name":"Invested+","description":"Gain 26 gold. At the start of each round, gain 1 Shop reroll for every 10 gold above 50 (max 80 gold).","stages":["3-2"],"tier":3},{"apiName":"DA_InvestedPlusPlus","name":"Invested++","description":"Gain 45 gold. At the start of each round, gain 1 Shop reroll for every 10 gold above 50 (max 80 gold).","stages":["4-2"],"tier":3},{"apiName":"DA_HealingOrbsI","name":"Healing Orbs I","description":"When an enemy dies, a nearby ally is healed for 250 Health.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_HealingOrbsII","name":"Healing Orbs II","description":"When an enemy dies, a nearby ally is healed for 575 Health.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_StandUnited","name":"Stand United","description":"Your units gain 1.5% Attack Damage and 1.5% Ability Power for each non-unique Trait active across your team.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_ShoppingSpree","name":"Shopping Spree","description":"When you level up, gain a number of free shop refreshes equal to your level +1. Gain 6 gold.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_SwordOverflow","name":"Sword Overflow","description":"Gain 4 BF Swords. Your BF Swords grant +4% Attack Speed.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_TradeSector","name":"Trade Sector","description":"Gain a free Shop reroll every round. Gain 2 gold.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_UpwardMobility","name":"Upward Mobility","description":"Buying XP costs 1 less. Gain 2 Health and 1 free reroll whenever you level up.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_InvestmentStrategyI","name":"Investment Strategy I","description":"Your champions gain 8 permanent max health per interest you earn. Gain 4 gold now.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_CaretakersFavor","name":"Caretaker's Favor","description":"Gain a component anvil when you reach level 5, 6, 7, and 8.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_YoungAndWildAndFree","name":"Young and Wild and Free","description":"You can always move freely on Carousel rounds. Gain 5 gold.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_TimeSkip","name":"Time Skip","description":"Disable your Shop for the next 3 rounds. Then gain 32 XP.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_BeltOverflow","name":"Belt Overflow","description":"Gain 4 Giant's Belts. Your Giant's Belts grant +85 bonus Health.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_ExplosiveGrowth","name":"Explosive Growth","description":"Now and at the start of the next 3 rounds, gain 7 XP.","stages":["3-2"],"tier":2},{"apiName":"DA_ExplosiveGrowthPlus","name":"Explosive Growth+","description":"Now and at the start of the next 3 rounds, gain 10 XP.","stages":["4-2"],"tier":2},{"apiName":"DA_PrismaticTicket","name":"Prismatic Ticket","description":"Each time your shop is rerolled you have a 45% chance to gain a free reroll.","stages":["2-1","3-2"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_PatienceIsAVirtue","name":"Patience Is A Virtue","description":"Gain 4 rerolls now. Each round, gain 1 free reroll if you did not buy a champion last round.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_LivingForge","name":"Living Forge","description":"Gain an Artifact Anvil now and after every 10 player combats.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_Epoch","name":"Epoch","description":"Now, and at the start of every stage, gain 4 XP and 2 free rerolls.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_EpochPlus","name":"Epoch+","description":"Now, and at the start of every stage, gain 8 XP and 2 free rerolls.","stages":["3-2"],"tier":2},{"apiName":"DA_Coronation","name":"Coronation","description":"Gain a Tactician's Crown. Tactician's Crown, Cape, and Shield grant the holder 20% Attack Speed, 25% Attack Damage, and 30% Ability Power.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_WandOverflow","name":"Wand Overflow","description":"Gain 4 Needlessly Large Rods. Your Needlessly Large Rods grant +5% Attack Speed.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_Kingslayer","name":"Kingslayer","description":"After winning player combat, gain 1 gold. If they had more health than you, gain 6 Gold instead. Gain 1 gold.","stages":["2-1","3-2"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_CookingPot","name":"Cooking Pot","description":"At the start of each turn, all allies holding a Frying Pan or Spatula item grant the nearest champion 60 permanent Health. Gain a Frying Pan.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_RadiantRelic","name":"Radiant Relics","description":"Choose 1 of 5 Radiant Items. Gain a Magnetic Remover.","stages":["2-1","3-2","4-2"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_HardBargain","name":"Hard Bargain","description":"You cannot choose your Carousel rewards. Gain an additional 6 player health and 8 gold each carousel round.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_Min_Max","name":"Min-Max","description":"Gain a Golden Item Remover and 4 random components.","stages":["3-2"],"tier":3},{"apiName":"DA_FocusedFire","name":"Focused Fire","description":"Your team gains 10% Attack Damage. Every 5 seconds, they gain 5% more.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_Recombobulator","name":"Recombobulator","description":"Champions on your board permanently transform into random champions 1 cost tier higher (max 5). Gain 2 Magnetic Removers and 3 free rerolls.","stages":["3-2"],"tier":1},{"apiName":"DA_ExtraBuckles","name":"Extra Buckles","description":"Gain a Giant's Belt. After your champions take 75000 damage, get 2 more.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_JeweledLotus_I","name":"Jeweled Lotus I","description":"Your team gains 10% Critical Strike Chance and Precision.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_JeweledLotus_II","name":"Jeweled Lotus II","description":"Your team gains 25% Critical Strike Chance, 10% Critical Strike Damage, and Precision.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_MakeshiftArmorI","name":"Makeshift Armor I","description":"Champions without items equipped gain 30 Armor and Magic Resist.","stages":["2-1","3-2"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_MakeshiftArmorII","name":"Makeshift Armor II","description":"Champions without items equipped gain 50 Armor and Magic Resist.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_CognitiveTax","name":"Cognitive Tax","description":"Gain 8 gold and 1 XP.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_CognitiveTaxPlus","name":"Cognitive Tax+","description":"Gain 12 gold and 3 XP.","stages":["3-2"],"tier":1},{"apiName":"DA_CryMeARiver","name":"Cry Me A River","description":"Gain a Tear of the Goddess. Your team gains 1 Mana Regen. After 12 seconds in combat, increase this to 4.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_BandOfThieves","name":"Band of Thieves","description":"Gain 1 Thief's Gloves.","stages":["2-1","3-2","4-2"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_BandOfThievesII","name":"Band of Thieves II","description":"Gain 2 Thief's Gloves. After 5 player combats, gain another.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_BandOfThievesIIPlus","name":"Band of Thieves II+","description":"Gain 2 Thief's Gloves. After 5 player combats, gain another.","stages":["3-2"],"tier":3},{"apiName":"DA_BandOfThievesIIPlusPlus","name":"Band of Thieves II++","description":"Gain 2 Thief's Gloves. After 3 player combats, gain another.","stages":["4-2"],"tier":3},{"apiName":"DA_GroupHugI","name":"Group Hug I","description":"Combat start: Champions grant other adjacent champions 6 Armor and Magic Resist. This effect stacks.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_GroupHugII","name":"Group Hug II","description":"Combat start: Champions grant other adjacent champions 9 Armor and Magic Resist. This effect stacks.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_BacklineBlueprint","name":"Backline Blueprint","description":"Gain a 3-cost non-Tank champion and an Emblem that matches their class.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_BronzeForLifeI","name":"Bronze For Life I","description":"Your team gains 2.5% Damage Amp for each Bronze-tier trait.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_BronzeForLifeII","name":"Bronze For Life II","description":"Your team gains 2.5% Damage Amp and 4 Armor and Magic Resist for each Bronze-tier trait.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_GoldenEgg","name":"The Golden Egg","description":"Gain a golden egg that hatches in 11 turns for a huge amount of loot. Winning player combat speeds up the hatch timer by an extra turn.","stages":["4-2"],"tier":3},{"apiName":"DA_TradeSectorPlus","name":"Trade Sector+","description":"Gain a free Shop reroll every round. Gain 8 gold.","stages":["3-2"],"tier":2},{"apiName":"DA_BackupBows","name":"Backup Bows","description":"Gain a Recurve Bow. After your champions attack 1000 times, get 2 more.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_CarveAPath","name":"Carve a Path","description":"Gain a B.F. Sword. After your champions deal 65000 physical damage, gain 2 more.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_LuckyGloves","name":"Lucky Gloves","description":"Thief's Gloves will always give your champions ideal items. Gain 2 Sparring Gloves and 4 gold.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_LuckyGlovesPlus","name":"Lucky Gloves+","description":"Thief's Gloves will always give your champions ideal items. Gain 2 Sparring Gloves now, then another after 4 player combats.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_MoneyHungry_NotBroken","name":"Money Hungry","description":"Gain 7 gold now, then 7 gold at the start of every stage. Picking up gold makes your Tactician larger.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_MoneyHungryPlus","name":"Money Hungry+","description":"Gain 13 gold now, then 7 gold at the start of every stage. Picking up gold makes your Tactician larger.","stages":["3-2"],"tier":2},{"apiName":"DA_MoneyMonsoon","name":"Money Monsoon","description":"Gain 7 gold now and every round for the rest of the game.","stages":["4-2"],"tier":3},{"apiName":"DA_Slammin","name":"Slammin'","description":"Gain 3 gold. After each player combat, if there are no items on your bench (other than consumables), gain 2 XP.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_SlamminPlus","name":"Slammin'+","description":"Gain 4 gold and 10 XP now. After each player combat, if there are no items on your bench (other than consumables), gain 2 XP.","stages":["3-2"],"tier":2},{"apiName":"DA_CraftedCrafting","name":"Crafted Crafting","description":"Whenever you craft a completed item, gain 2 rerolls.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_PandorasItemsI","name":"Pandora's Items I","description":"Round start: items on your bench are randomized. \n\nGain 1 random component.","stages":["2-1","3-2","4-2"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_PandorasItemsII","name":"Pandora's Items II","description":"Round start: items on your bench are randomized. \n\nGain 2 random components.","stages":["2-1","3-2","4-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_PandorasItemsIII","name":"Pandora's Items III","description":"Round start: items on your bench are randomized. \n\nGain 1 Radiant item.","stages":["2-1","3-2"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_SalvageBin","name":"Salvage Bin","description":"Gain 1 random completed item now, and 1 component after 8 player combats. Selling champions breaks completed items into components (excluding Tactician's items and Emblems).","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_SalvageBinPlus","name":"Salvage Bin+","description":"Gain 1 random completed item now, and 1 component after 4 player combats. Selling champions breaks completed items into components (excluding Tactician's items and Emblems).","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_ClockworkAccelerator","name":"Clockwork Accelerator","description":"Your team gains 10% Attack Speed every 3 seconds in combat.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_ClearMind","name":"Clear Mind","description":"If there are no champions on your bench at the end of player combat, gain 3 XP.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_CelestialBlessingI","name":"Celestial Blessing I","description":"Your team gains 12% Omnivamp. Excess healing is converted to a shield up to 200 Health.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_CelestialBlessingII","name":"Celestial Blessing II","description":"Your team gains 18% Omnivamp. Excess healing is converted to a shield up to 400 Health.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_CelestialBlessingIII","name":"Celestial Blessing III","description":"Your team gains 25% Omnivamp. Excess healing is converted to a shield up to 1000 Health.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_AdvancedLoan","name":"Advanced Loan","description":"Gain 20 Gold. Your next augment is one tier lower.","stages":[],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_AdvancedLoanPlus","name":"Advanced Loan+","description":"Gain 33 Gold. Your next augment is one tier lower.","stages":["3-2"],"tier":2},{"apiName":"DA_Pilfer","name":"Pilfer","description":"Each round, gain a 1-star copy of the first champion you killed last combat. The first time you gain 21 gold worth of champions in this way, gain a Thief's Gloves.","stages":["3-2"],"tier":2},{"apiName":"DA_TeamBuilding","name":"Team Building","description":"Gain a Lesser Champion Duplicator. Gain another after 5 player combats.","stages":["2-1","3-2"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_RadiantRascal","name":"Radiant Rascal","description":"Gain a Radiant Thief's Gloves item. This equips 2 random Radiant items every round.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_HardCommit","name":"Hard Commit","description":"Gain a random emblem. Now and at the start of each stage, gain a 1-star champion of that trait with a cost equal to the Stage (max 5) and 3 gold.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_GainGold","name":"Gain 21 Gold","description":"Gain 21 gold.","stages":["3-2"],"tier":2},{"apiName":"DA_LateGameSpecialist","name":"Late Game Specialist","description":"When you reach Level 9, gain 27 gold.","stages":["3-2"],"tier":1},{"apiName":"DA_SmallGrabBag","name":"Small Grab Bag","description":"Gain 2 random item components.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_HoldTheLine","name":"Hold the Line","description":"Champions in your back 2 rows gain 10% Ability Power and 9% Attack Damage for each champion that starts combat in your front row.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_FindYourCenter","name":"Find Your Center","description":"Your champion that starts combat in the center of the front row gains 15% Damage Amp and 25% max Health.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_LegionOfThrees","name":"Legion Of Threes","description":"Gain a random Emblem. Your 3-cost champions and all allies equipped with an Emblem gain 150 Health and 12% Attack Speed.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_BirthdayReunion","name":"Birthday Reunion","description":"Gain a random 2-star 2-cost champion. At Level 6, gain a random item component. At Level 9, gain a random 2-star 5-cost champion.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_TacticiansKitchen","name":"Tactician's Kitchen","description":"Gain a random Emblem. After 3 rounds, gain a Tactician's Cape.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_Flexible","name":"Flexible","description":"Gain 1 random Emblem. At the start of every Stage, gain a random Emblem. Your team gains 30 Health for each Emblem they are holding.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_EpicRolldown","name":"Epic Rolldown","description":"When you reach Level 8, gain 20 Shop rerolls.","stages":["3-2"],"tier":2},{"apiName":"DA_LateGameScaling","name":"Late Game Scaling","description":"Gain 2 XP at the start of player combat rounds. Your 5-cost champions gain 12% Health and 12% Attack Speed.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_Retribution","name":"Retribution","description":"Gain 2 Hands of Justice. Allies equipped with Hand of Justice gain Precision and 25% Critical Strike Chance.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_SoloPlate","name":"Solo Plate","description":"Gain a Gargoyle Stoneplate. Allies holding Gargoyle Stoneplate gain 17% max Health if they start combat alone in their row.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_TwinGuardians","name":"Twin Guardians","description":"If you have exactly 2 allies in your first row, grant them 100 Health, 35 Armor, and 35 Magic Resist.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_PromisedProtection","name":"Promised Protection","description":"Gain a Protector's Vow. Protector's Vow grants its holder 20% additional Mana from all sources and 200 max Health.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_CommerceCore","name":"Commerce Core","description":"Gain 16 free Shop rerolls now and 3 every round for the rest of the game.","stages":["4-2"],"tier":3},{"apiName":"DA_BodyguardTraining","name":"Bodyguard Training","description":"Allies gain 15 Armor and Magic Resist, increased by 2 per player level.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_SpeedyDoubleKill","name":"Speedy Double Kill","description":"Gain a Guinsoo's Rageblade. When 2 players are eliminated, gain 40 gold.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_ForgedInStrength","name":"Forged In Strength","description":"Gain 1 random Artifact. When you drop below 35 Health, gain 1 more random Artifact, 1 random completed item, and 2 random components.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_SoulAwakening","name":"Soul Awakening","description":"Combat start: Your team gains 1.5% Attack Damage and Ability Power per second for 10 seconds. At max stacks, deal 12% bonus true damage.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_FlowingTears","name":"Flowing Tears","description":"Gain a Tear of the Goddess. After your champions spend 6500 Mana, gain 2 more.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_TheGoldenDragon","name":"The Golden Dragon","description":"Gain a Mogul's Mail. Champions holding Mogul's Mail take up +1 team slot but gain 600 Health and 15% Durability.","stages":["3-2"],"tier":2},{"apiName":"DA_ShimmerscaleEssence","name":"Shimmerscale Essence","description":"Gain a Mogul's Mail. After 8 player combats, gain a Gamblers Blade.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_SeraphimsStaff","name":"Seraphim's Staff","description":"Gain an Archangel's Staff. Archangel's Staff grants 2 additional Mana Regen if its holder has 90% or more Ability Power.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_ChallengersGrace","name":"Challenger's Grace","description":"At the start of combat, allies gain 25% Attack Speed for 3 seconds. On takedown, allies dash to their next target and gain this bonus again.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_ArcaneViktory","name":"Arcane Viktor-y","description":"After 8 seconds of combat, stun the enemy team for 1.5 seconds. Repeat this after 18 seconds of combat.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_KnowYourEnemy","name":"Know Your Enemy","description":"You can see who you will fight next. Your team gains 8% Damage Amp, increased to 15% if you and your opponent have any of the same traits active.","stages":[],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_GiantAndMighty","name":"Giant and Mighty","description":"Your team becomes large, gaining 200 Health and 10% max Health.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_WovenMagic","name":"Woven Magic","description":"Gain a random item component. Every 2200 Mana spent by your champions, grants an additional component (max: 0/3).","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_MaxBuild","name":"Max Build","description":"Gain 10 free Shop rerolls. When you reach level 9, gain 3 free Shop rerolls and a Champion Duplicator.","stages":["4-2"],"tier":2},{"apiName":"DA_GoingLong","name":"Going Long","description":"You no longer gain interest. Gain 10 gold now. Gain 4 XP after every player combat.\n\n10","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_Hustler","name":"Hustler","description":"You no longer gain interest but gain 3 gold at the start of every player combat round. Gain 3 gold now.\n\n 10","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_SliceOfLife","name":"Slice of Life","description":"Twice per stage, gain a random champion. Its cost increases by Stage. This effect ends after receiving 1 5-cost champion.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_SoloLeveling","name":"Solo Leveling","description":"For the next 5 combats, your team size is 1, but the champion you field has massively increased stats. Gain 1 XP for every kill they get. Afterwards, gain 2 item components.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_AugmentedPower","name":"Augmented Power","description":"Your next augment is one tier higher.","stages":["3-2"],"tier":1},{"apiName":"DA_Staffsmith","name":"Staffsmith","description":"Gain 2 random completed items that build from Needlessly Large Rod.","stages":["4-2"],"tier":2},{"apiName":"DA_Swordsmith","name":"Swordsmith","description":"Gain 2 random completed items that build from B.F. Sword.","stages":["4-2"],"tier":2},{"apiName":"DA_InfinityProtection","name":"Infinity Protection","description":"Gain 3 gold now. On Stage 3-7, gain an Infinity Force. Infinity Force gives allies in the same row a 12% Health shield.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_WeStickTogether","name":"We Stick Together","description":"Gain a random Emblem and a completed item anvil. Allies that share a trait with that Emblem gain 30% Attack Speed.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_ElectrochargeI","name":"Electrocharge I","description":"Every 4 attacks an ally takes, they deal 30-90 (based on current Stage) magic damage to nearby enemies (1 second cooldown).","stages":["2-1","3-2","4-2"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_ElectrochargeII","name":"Electrocharge II","description":"Every 4 attacks an ally takes, they deal 50-140 (based on current Stage) magic damage to nearby enemies (1 second cooldown).","stages":["2-1","3-2","4-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_DoubleTrouble","name":"Double Trouble","description":"When you field exactly 2 copies of a champion, they both gain 30% Attack Damage and Ability Power and 30 Armor, and Magic Resist. When you 3-star, gain a 2-star copy.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_CognitiveOverload","name":"Cognitive Overload","description":"Gain 7 gold, 1 2-star 1-cost champion, 1 2-cost champion, 2 3-cost champions, 1 XP, and 1 Shop reroll.","stages":["3-2"],"tier":2},{"apiName":"DA_Dummify","name":"Dummify","description":"Lose all champions on your board and bench. Gain a Training Dummy with 60% of their combined health. The dummy gains 1150 Health per stage. Gain a random non-tank 2-star 2 cost champion.","stages":["3-2"],"tier":1},{"apiName":"DA_EarlyLearnings","name":"Early Learnings","description":"Your team gains 5% Attack Damage & Ability Power. This increases by 1% after each player combat. 1-cost champions gain double.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_KickStart","name":"Kick Start","description":"Gain a random 2-star 2-cost champion and 1 gold.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_BaronsLair","name":"Baron's Lair","description":"Gain a random Tank item. After 8 seconds of combat, your team gains 4% bonus Attack Damage and Ability Power every second for the rest of combat.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_HeartOfSteel","name":"Heart of Steel","description":"Gain a Steadfast Heart. Every 10 seconds of combat its holder survives, Steadfast Heart gains additional 16 permanent max Health.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_CursedCrown","name":"Cursed Crown","description":"Gain +2 max team size and your team gains 4% Durability, but you take double player damage when you lose a player combat.","stages":["2-1","3-2"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_Corrosion","name":"Corrosion","description":"Enemies in the first two rows lose 4 Armor and Magic Resist every 2 seconds.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_BoxingLessons","name":"Boxing Lessons","description":"Your team gains 30 Health for each champion that starts combat in the front row.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_Ascension","name":"Ascension","description":"After 12 seconds of combat, your units gain 35% Damage Amp.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_NoScoutNoPivot","name":"NO SCOUT NO PIVOT","description":"Champions that fight in player combat cannot be benched or sold. Your team gains 1% Health, and 1% Attack Damage and Ability Power after player combat.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_GildedSteel","name":"Gilded Steel","description":"Gain two 5-cost champions. If you field at least one 5-cost champion, your 1 to 4-cost champions gain 8% Durability.","stages":["4-2"],"tier":2},{"apiName":"DA_Replication","name":"Replication","description":"Choose 1 of 3 components. For the next 2 rounds, gain a copy of that component.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_SweetTreats","name":"Sweet Treats","description":"Gain an Artifact anvil. Your team gains 16 Health for each item equipped on champions.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_ComponentBuffet","name":"Component Buffet","description":"Whenever you would get a component, gain a component anvil instead. Gain a random component.The anvil offers 4 choices.","stages":[],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_MagicRoll","name":"Magic Roll","description":"Roll 3 dice. Gain rewards based on their total.","stages":["3-2"],"tier":2},{"apiName":"DA_SlightlyMagicRoll","name":"Slightly Magic Roll","description":"Roll a die. Gain rewards based on the number rolled.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_FrontlineFoundation","name":"Frontline Foundation","description":"Gain a 2-star 1-cost Tank champion and an Emblem that matches their class.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_SpiritOfRedemption","name":"Spirit Of Redemption","description":"Gain a Spirit Visage. Every 5 seconds, Spirit Visage heals allies within 1 hex for 7.5% of their missing Health.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_TheTower","name":"The Tower","description":"Gain a giant Training Dummy. Every 4 seconds, it zaps the 3 nearest enemies dealing 5% max Health true damage.","stages":["2-1","3-2","4-2"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_ExclusiveCustomization","name":"Exclusive Customization","description":"Gain a Lucky Item Chest, a Magnetic Remover and 7 gold.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_Warpath","name":"Warpath","description":"Gain a 2-star 2-cost champion. After dealing 80 player damage, gain a chest of high cost champions and items.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_DeadlierBlades","name":"Deadlier Blades","description":"Gain a Deathblade. Deathblades permanently gain 1% Attack Damage whenever their holders score a takedown.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_FeelingLucky","name":"Feeling Lucky","description":"Gain 12 gold, then flip a coin. If heads, gain 4 more gold.","stages":["3-2"],"tier":1},{"apiName":"DA_ComebackStory","name":"Comeback Story","description":"Your team gains 4 Health and 0.3% Attack Speed per missing player Health.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_CallToChaos","name":"Call To Chaos","description":"Gain a powerful and random reward.","stages":["4-2"],"tier":3},{"apiName":"DA_LuxurySubscription","name":"Luxury Subscription","description":"Gain a package containing a 5-cost champion, a 2-star 1-cost champion, and 3 gold.\n\nAt the start of the next 2 stages, gain the package again.","stages":["3-2"],"tier":3},{"apiName":"DA_18_FOURcing","name":"FOURcing","description":"Gain a random 4-cost champion. For each item equipped to that champion, your team gains 100 health.","stages":["3-2"],"tier":2},{"apiName":"DA_18_WeightTheWorth","name":"Weight The Worth","description":"The first time you 3-star a champion, gain a copy of them each round for the rest of the game. 3-starring the same champion again grants additional copies. Gain a Lesser Champion Duplicator and a Tiny Champion Duplicator.","stages":["3-2"],"tier":2},{"apiName":"DA_18_ResidualMagic","name":"Residual Magic","description":"Your team gains 60 Health. Each time you purchase a Wisp, increase this by 10.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_ResidualMagicPlus","name":"Residual Magic +","description":"Your team gains 75 Health. Each time you purchase a Wisp, increase this by 10.","stages":["3-2"],"tier":1},{"apiName":"DA_18_ResidualMagicPlusPlus","name":"Residual Magic ++","description":"Your team gains 90 Health. Each time you purchase a Wisp, increase this by 10.","stages":["4-2"],"tier":1},{"apiName":"DA_LoadedDice","name":"Loaded Dice","description":"Your dice and coins are luckier.\n\nRoll a die and gain gold equal to the number rolled. Then flip a coin and gain 1 gold if you flip heads.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_TraitLadder","name":"Trait Ladder","description":"Gain a random emblem. After fielding 2 non-unique traits in a player combat, gain a reward. Then increase the number of traits needed and the size of the reward.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_ComponentQuest","name":"Component Quest","description":"Gain a random component and 1 gold. The next 7 times you win a player combat, gain a different random component. Afterwards, gain 5 gold.","stages":["2-1"],"tier":3,"icon":"data:image/webp;base64,"},{"apiName":"DA_BonusGift","name":"Bonus Gift","description":"Whenever you open a loot orb, you have a 25% chance to gain a gray loot orb. Gain 1 gray loot orbs.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_BonusGiftPlus","name":"Bonus Gift+","description":"Whenever you open a loot orb, you have a 25% chance to gain a gray loot orb. Gain 2 gray loot orbs.","stages":["3-2"],"tier":2},{"apiName":"DA_18_WispRebatePlus","name":"Wisp Rebate","description":"Each time you purchase a Wisp, gain 2 gold. Gain 4 gold now.","stages":["3-2"],"tier":1},{"apiName":"DA_NestingAnvils","name":"Nesting Anvils","description":"Gain an Artifact Anvil. After you open it, gain a Component Anvil. After you open that, gain 4 gold.","stages":["3-2"],"tier":3},{"apiName":"DA_NestingAnvilsPlus","name":"Nesting Anvils+","description":"Gain an Artifact Anvil. After you open it, gain a Component Anvil. After you open that, gain 8 gold.","stages":["4-2"],"tier":3},{"apiName":"DA_ChampDelivery","name":"Champ Delivery","description":"Gain 3 2-cost champions. After 6 rounds, gain 3 more.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_ChampDeliveryPlus","name":"Champ Delivery+","description":"Gain 3 3-cost champions. After 6 rounds, gain 3 more.","stages":["3-2"],"tier":1},{"apiName":"DA_ChampDeliveryPlusPlus","name":"Champ Delivery++","description":"Gain 3 4-cost champions. After 6 rounds, gain 3 more.","stages":["4-2"],"tier":1},{"apiName":"DA_18_WispRebatePlusPlus","name":"Wisp Rebate+","description":"Each time you purchase a Wisp, gain 2 gold. Gain 8 gold now.","stages":["4-2"],"tier":1},{"apiName":"DA_VerticalityI","name":"Verticality I","description":"Champions gain 1.5% Attack Damage, 1.5% Ability Power, 1.5 Armor, and 1.5 Magic Resist for each ally that shares a trait with them.","stages":["3-2","4-2"],"tier":1},{"apiName":"DA_VerticalityII","name":"Verticality II","description":"Champions gain 2% Attack Damage, 2% Ability Power, 2 Armor, and 2 Magic Resist for each ally that shares a trait with them.","stages":["3-2","4-2"],"tier":2},{"apiName":"DA_VerticalityIII","name":"Verticality III","description":"Champions gain 3.5% Attack Damage, 3.5% Ability Power, 3.5 Armor, and 3.5 Magic Resist for each ally that shares a trait with them.","stages":["3-2","4-2"],"tier":3},{"apiName":"DA_CapitalGainsI","name":"Capital Gains I","description":"Store gold equal to the interest you earn. On 3-3, gain gold equal to 100% of the stored gold. Gain 1 gold now.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,"},{"apiName":"DA_CapitalGainsII","name":"Capital Gains II","description":"Store gold equal to the interest you earn. On 3-3, gain gold equal to 125% of the stored gold. Gain 3 gold now.","stages":["2-1"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_RivalsAugment","name":"Unrivaled","description":"You can field Rengar and Kha'Zix together with no penalties, and they gain bonuses when the other casts. Gain a Rengar and a Kha'Zix.","stages":["2-1","3-2"],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_18_RivalsAugmentPlus","name":"Unrivaled","description":"You can field Rengar and Kha'Zix together with no penalties, and they gain bonuses when the other casts. Gain a Rengar and a Kha'Zix.","stages":[],"tier":2,"icon":"data:image/webp;base64,"},{"apiName":"DA_FutureFocused","name":"Future Focused","description":"Your Tactician loses 20 Health, but after 5 player combats, gain 3 4-cost champions and 8 gold.","stages":["2-1"],"tier":1,"icon":"data:image/webp;base64,