.component-shortage{font-size:13px;color:#f0dca1;white-space:nowrap;margin-left:3px}.component-option{display:block;color:#96a8bc;font-size:10px;font-weight:400}.anvil-mode{display:flex;gap:5px;margin:4px 0 8px}.anvil-mode button{font-size:12px;padding:7px 12px}.anvil-mode [aria-pressed=true]{background:#344356;border-color:#97a7bf}.anvil-component-keys>small{font-size:11px;display:block;margin-bottom:7px}.anvil-component-keys>div{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:5px;margin-bottom:10px}.anvil-component-keys button{position:relative;display:flex;flex-direction:column;align-items:center;gap:3px;padding:7px 2px;font-size:10px;background:#192633;min-width:0}.anvil-component-keys kbd{position:absolute;top:3px;left:4px;font-size:10px;color:#d7e5f4;background:#18212c;border:1px solid #576a83;border-radius:3px;padding:0 3px}.anvil-component-keys .icon{width:32px;height:32px}.anvil-component-keys [aria-pressed=true]{background:#314561;border-color:#93a9ca}.anvil-component-keys[hidden]{display:none}.anvil-search-wrap{position:relative}.anvil-offer-chips{display:flex;flex-wrap:wrap;gap:5px;margin:8px 0}.anvil-offer-chips:empty{display:none}.anvil-offer-chips button{display:flex;align-items:center;gap:5px;padding:4px 7px;font-size:11px}.anvil-offer-chips img{width:25px;height:25px}.anvil-offer-chips b{font-size:16px;color:#b1c3d9}#anvil-search-matches{max-height:235px;overflow:auto;border:1px solid #53657c;background:#101922;border-radius:6px;margin-top:3px}#anvil-search-matches[hidden]{display:none}#anvil-search-matches button{display:flex;gap:8px;align-items:center;width:100%;border:0;border-bottom:1px solid #304050;border-radius:0;background:transparent;text-align:left;padding:7px}#anvil-search-matches button.search-active{background:#283b50}#anvil-search-matches .icon{width:27px;height:27px}#anvil-search-matches span{flex:1;font-size:12px}#anvil-search-matches small{font-size:10px}#anvil-search-matches p{font-size:12px;margin:10px}#anvil-verdict{background:#1a2839;border:1px solid #41516a;color:#dbe7f9;border-radius:7px;font-size:12px;padding:9px;margin-top:9px}#anvil-verdict[hidden]{display:none}.anvil-recommended{display:block;font-size:10px;color:#c2d5ee;margin-top:3px}.anvil-rank{font-size:10px;color:#99adc5}.anvil-row .anvil-fit:empty{display:none}.anvil-row .anvil-compare-add{font-size:11px;padding:6px 8px;background:transparent}.anvil-row .component-shortage{font-size:11px;margin:0}.anvil-row .decision-primary{min-width:130px}.anvil-row .decision-primary small{font-size:10px}@media(max-width:550px){.anvil-component-keys>div{grid-template-columns:repeat(4,minmax(0,1fr))}.anvil-offer-chips span{max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.anvil-row{gap:6px}.anvil-row .anvil-fit{max-width:100px}.anvil-row .anvil-compare-add{font-size:10px;padding:6px}.anvil-row>button{padding:7px;font-size:11px}.decision-need .needname{min-width:0}}

/* One unmistakable recommendation, using shape and contrast as well as color. */
.anvil-row.recommended-offer{border:3px solid #69e5a1;background:#142e25;padding:7px;box-shadow:0 0 0 1px #102b21}
.anvil-pick-check{display:flex;align-items:center;justify-content:center;flex:0 0 38px;width:38px;height:38px;border-radius:50%;background:#69e5a1;color:#082216}
.anvil-pick-check svg{width:28px;height:28px;fill:none;stroke:currentColor;stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round}
.anvil-row.recommended-offer .decision-primary strong{font-size:15px;color:#f1fff6}
.anvil-row.recommended-offer>[data-take-anvil]{min-height:44px;padding:10px 16px;background:#69e5a1;border:1px solid #69e5a1;color:#082216;font-size:14px;font-weight:800}
.anvil-row.recommended-offer>[data-take-anvil]:hover{background:#98f5bf;border-color:#98f5bf}
.anvil-row.recommended-offer>[data-take-anvil]:focus-visible{outline:3px solid white;outline-offset:3px}

</style><style>
/* Compact main page. Recommendation and inventory models remain separate. */
.topbar{height:auto;min-height:76px;padding:14px 24px;gap:18px;align-items:center;flex-wrap:wrap}
.brand{min-width:0;gap:10px;flex:1}
.brand>svg{width:28px;height:28px;flex-shrink:0}
.brand h1{font-size:22px;line-height:1.2;letter-spacing:-.5px;overflow-wrap:anywhere}
.brand small{font-size:12px;font-weight:400;letter-spacing:0;text-transform:none;color:var(--muted);margin-top:5px}
.topright{gap:0;flex:0 0 auto}
.topright .actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.topright .actions>button{font-size:12px;padding:8px 10px;min-height:36px}
.utility-menu{position:relative}
.utility-menu>summary{list-style:none;cursor:pointer;border:1px solid var(--line);border-radius:7px;min-width:38px;height:36px;display:grid;place-items:center;font-size:24px;line-height:1;background:#1c2730}
.utility-menu>summary::-webkit-details-marker{display:none}
.utility-menu>summary:focus-visible{outline:2px solid var(--green);outline-offset:3px}
.utility-options{position:absolute;right:0;top:calc(100% + 6px);z-index:50;min-width:170px;padding:5px;background:#18242e;border:1px solid #465563;border-radius:8px;box-shadow:0 8px 25px #0009}
.utility-options button{display:block;width:100%;text-align:left;font-size:13px;border:0;background:transparent;padding:10px}
.utility-options button:hover{background:#2b3942}
.wrap{padding-top:14px}
.academy-bar{margin-top:0}
.plan-overview{display:flex;flex-direction:column;position:static;gap:10px}
.plan-overview[hidden],.academy-order[hidden]{display:none}
.academy-order{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.academy-order #academy-priority{margin:0;flex:1;gap:6px}
.academy-order #restore-academy{flex:0 0 auto;font-size:10px;padding:5px 7px;min-height:30px}
.board-heading{justify-content:flex-end}
.academy-tip+.academy-tip{border-top:1px solid #2b3949;margin-top:12px;padding-top:12px}
.academy-tip h3{font-size:12px;font-weight:650;color:#e0e8f2;margin:0 0 5px}
.academy-tip p{font-size:12px;line-height:1.6;color:#b8c8dc;white-space:pre-line;margin:0}
.queuehead{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.queuehead>div:first-child{flex:1 1 auto;min-width:85px}
.queuehead #reset-queue-order,.queuehead #receive-open{font-size:11px;padding:6px 8px;min-height:32px}
.qtop{display:grid;grid-template-columns:24px 32px minmax(0,1fr) auto 22px;align-items:center;gap:6px;padding:8px}
.qtop .itemtitle{min-width:0}
.qtop .itemtitle h3{font-size:13px;line-height:1.3;overflow-wrap:anywhere}
.qtop .recipe{padding:0;margin:0;gap:3px;flex-wrap:nowrap}
.qtop .recipe>.plus{font-size:10px}
.qtop .componentpill{padding:3px;gap:2px;font-size:10px;min-height:28px}
.qtop .componentpill .icon{width:20px;height:20px}
.qtop .remove{padding:0;width:22px}
.queue-grip{touch-action:none;cursor:grab;padding:0;width:24px;height:42px;min-width:0;background:transparent;border:0;color:#889bad;font-size:23px;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.queue-grip:hover{background:#263441;color:#dae8f5}
.queue-champion{display:inline-flex;align-items:center;max-width:100%;gap:3px;font-size:11px;line-height:1.25;background:transparent;border:0;padding:0;text-align:left;color:var(--muted)}
.queue-champion:hover{background:transparent;color:var(--text)}
.queue-champion .inline-entity{flex-wrap:wrap;font-size:11px}
.qbottom{justify-content:space-between}
.qbottom .make{margin-left:auto}
.qcard.queue-dragging{outline:2px solid #94bddc;outline-offset:1px;opacity:.75;background:#223342}
.is-sorting,.is-sorting *{cursor:grabbing!important;user-select:none;-webkit-user-select:none}
.qcard .qtop{cursor:grab}
.qcard .qtop button{cursor:pointer}
.qcard .qtop .queue-grip{cursor:grab}
@media(max-width:680px){.topbar{padding:12px;gap:12px}.brand h1{font-size:20px}.topright{width:100%}.topright .actions{justify-content:flex-end}.topright .actions>button{padding:7px 10px}.wrap{padding-top:10px}.qtop{gap:5px}.academy-order{gap:7px}}

</style></head><body><div id="app"></div><script>
